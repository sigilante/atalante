// lexer.jock — ATL/APL tokens (dialect D-1..D-9).
//
// `tokens(line)` lexes one source line into positioned tokens or a
// positioned refusal. Source is decoded to codepoints first (D-1):
// String.chars() is the prelude's UTF-8 decoder, so a column counts
// glyphs, never bytes. A `⍝` ends the line (D-7). `dump(line)` renders
// the stream as `kind:text` words for the lex corpus (tests/lex).
//
// Refusals are VALUES, not crashes: a corpus run feeds many lines
// through one program, and a crash would take the run with it. The
// tag is always %syntax-error at this layer; the hint says which rule.
//
// Dfns (D-63): `{` `}` and `:` are tokens of their own, and `⍺` `⍵`
// are one-glyph names. `nl` is a line end inside one entry (D-69): a
// host that reads an open brace to its close (jojo does) hands the
// kernel the lines as one string with `\n` in it, and the session puts
// an `nl` between lines that arrive one at a time. A `⍝` comment runs
// to the line end, not the entry's. `unlex` renders a token run back to
// source for a dfn body (D-67).
struct Token { kind: Kind, text: String, cp: @, col: @ };
enum Kind { nat, int, real, chr, name, quad, cmd, glyph, lparen, rparen, lbrack, rbrack, semi, assign, del, diamond, lbrace, rbrace, colon, nl };
struct LexErr { tag: String, col: @, hint: String };
enum Lexed { ok(List<Token>), err(LexErr) };

// --- codepoints ------------------------------------------------------
func toCps(cs: List<UniChar>) -> List<@> {
  match cs { (h, t) => (h as! @, toCps(t)), _ => ~, }
};
func toUni(cs: List<@>) -> List<UniChar> {
  match cs { (h, t) => (h as! UniChar, toUni(t)), _ => ~, }
};
func text(cs: List<@>) -> String { utf8(toUni(cs)) };
func revCps(xs: List<@>, acc: List<@>) -> List<@> {
  match xs { (h, t) => revCps(t, (h, acc)), _ => acc, }
};
func revToks(xs: List<Token>, acc: List<Token>) -> List<Token> {
  match xs { (h, t) => revToks(t, (h, acc)), _ => acc, }
};

// --- character classes (D-2, D-3) -------------------------------------
func isDigit(c: @) -> Bool { c >= 48 and c <= 57 };
func isLetter(c: @) -> Bool {
  (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95   // A-Z a-z _
  or c == 8710 or c == 9049                                      // ∆ ⍙
  or (c >= 913 and c <= 937) or (c >= 945 and c <= 969)          // Greek
  or (c >= 1040 and c <= 1103)                                   // Cyrillic
  or (c >= 1488 and c <= 1514)                                   // Hebrew
  or (c >= 66560 and c <= 66639)                                 // Deseret
};
func isNameTail(c: @) -> Bool { isLetter(c) or isDigit(c) or c == 175 };  // ¯ (D-2)

// canonical codepoint of a function/operator glyph, 0 if none (D-41..D-43, D-9)
func canon(c: @) -> @ {
  match c {
    63   => 63,    // ?
    8968 => 8968,  // ⌈
    8970 => 8970,  // ⌊
    9076 => 9076,  // ⍴
    8764 => 8764,  // ∼
    8739 => 8739,  // ∣
    9075 => 9075,  // ⍳
    8902 => 8902,  // ⋆
    8722 => 8722,  // −
    43   => 43,    // +
    215  => 215,   // ×
    247  => 247,   // ÷
    44   => 44,    // ,
    9017 => 9017,  // ⌹
    9675 => 9675,  // ○
    9055 => 9055,  // ⍟
    9021 => 9021,  // ⌽
    8854 => 8854,  // ⊖
    9035 => 9035,  // ⍋
    9042 => 9042,  // ⍒
    9038 => 9038,  // ⍎
    9045 => 9045,  // ⍕
    9033 => 9033,  // ⍉
    33   => 33,    // !
    8801 => 8801,  // ≡
    8802 => 8802,  // ≢
    9066 => 9066,  // ⍪
    8714 => 8714,  // ∊
    9079 => 9079,  // ⍷
    8593 => 8593,  // ↑
    8595 => 8595,  // ↓
    8869 => 8869,  // ⊥
    8868 => 8868,  // ⊤
    92   => 92,    // \
    47   => 47,    // /
    168  => 168,   // ¨
    60   => 60,    // <
    8804 => 8804,  // ≤
    61   => 61,    // =
    8805 => 8805,  // ≥
    62   => 62,    // >
    8800 => 8800,  // ≠
    8744 => 8744,  // ∨
    8743 => 8743,  // ∧
    9073 => 9073,  // ⍱
    9074 => 9074,  // ⍲
    8867 => 8867,  // ⊣
    8834 => 8834,  // ⊂
    8835 => 8835,  // ⊃
    8746 => 8746,  // ∪ (D-98)
    8745 => 8745,  // ∩ (D-98)
    9068 => 9068,  // ⍬, an array (D-97)
    9064 => 9064,  // ⍨ (D-105)
    9059 => 9059,  // ⍣ (D-105)
    9060 => 9060,  // ⍤ (D-105)
    8866 => 8866,  // ⊢
    9023 => 9023,  // ⌿
    9024 => 9024,  // ⍀
    46   => 46,    // .
    8728 => 8728,  // ∘
    45   => 8722,  // - is − (D-9)
    42   => 8902,  // * is ⋆ (D-9)
    124  => 8739,  // | is ∣ (D-9)
    126  => 8764,  // ~ is ∼ (D-9)
    8712 => 8714,  // ∈ is ∊ (D-9)
    _    => 0,
  }
};

// --- scanners: (lexeme codepoints in order, rest, count consumed) -------
func scanWhile(cs: List<@>, keep: @ -> Bool, acc: List<@>, n: @) -> (List<@>, List<@>, @) {
  match cs {
    (c, rest) => if keep(c) { scanWhile(rest, keep, (c, acc), n + 1) } else { (revCps(acc, ~), cs, n) },
    _ => (revCps(acc, ~), ~, n),
  }
};
func scanDigits(cs: List<@>) -> (List<@>, List<@>, @) { scanWhile(cs, isDigit, ~, 0) };
func scanName(cs: List<@>) -> (List<@>, List<@>, @) { scanWhile(cs, isNameTail, ~, 0) };
func headIs(cs: List<@>, p: @ -> Bool) -> Bool { match cs { (c, rest) => p(c), _ => false, } };

// a character literal body after the opening quote: '' is one quote (D-5)
func scanChr(cs: List<@>, acc: List<@>, n: @) -> (Bool, List<@>, List<@>, @) {
  match cs {
    (c, rest) => if c == 39 {
      match rest {
        (c2, rest2) => if c2 == 39 { scanChr(rest2, (39, acc), n + 2) } else { (true, revCps(acc, ~), rest, n + 1) },
        _ => (true, revCps(acc, ~), ~, n + 1),
      }
    } else { scanChr(rest, (c, acc), n + 1) },
    _ => (false, revCps(acc, ~), ~, n),
  }
};

// --- the numeral (D-3) ------------------------------------------------
// state after the integer part: optional fraction, optional exponent,
// then the numeral must not run into a letter.
func numeral(cs: List<@>, col: @, neg: Bool, bol: Bool, acc: List<Token>) -> Lexed {
  let start = if neg { match cs { (c, rest) => rest, _ => ~, } } else { cs };
  match scanDigits(start) {
    (d1, r1, n1) => if n1 == 0 { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "a numeral needs a digit before the point (D-3)" )) }
    else {
      match fraction(r1) {
        (d2, r2, n2, frac, bad1) => if bad1 { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "a numeral needs a digit after the point (D-3)" )) }
        else {
          match exponent(r2) {
            (d3, r3, n3, expo, bad2) => if bad2 { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "an exponent needs digits (D-3)" )) }
            else {
              let width = n1 + n2 + n3 + (if neg { 1 } else { 0 });
              if headIs(r3, isLetter) { Lexed.err(LexErr( tag: "%syntax-error", col: col + width, hint: "a numeral runs into a name; separate them (D-2)" )) }
              else {
                let raw = text(numeralText(neg, d1, frac, d2, expo, d3));
                let kind = if frac or expo { Kind.real } else if neg { Kind.int } else { Kind.nat };
                lexFrom(r3, col + width, false, (Token( kind: kind, text: raw, cp: 0, col: col ), acc))
              }
            },
          }
        },
      }
    },
  }
};
// the optional fraction: (digits, rest, consumed, present, malformed)
func fraction(cs: List<@>) -> (List<@>, List<@>, @, Bool, Bool) {
  match cs {
    (c, after) => if c == 46 {
      match scanDigits(after) {
        (f, r, n) => if n == 0 { (~, cs, 0, true, true) } else { (f, r, n + 1, true, false) },
      }
    } else { (~, cs, 0, false, false) },
    _ => (~, ~, 0, false, false),
  }
};
// the optional exponent: E or e, optional ¯, digits
func exponent(cs: List<@>) -> (List<@>, List<@>, @, Bool, Bool) {
  match cs {
    (c, after) => if c == 69 or c == 101 {
      match after {
        (m, after2) => if m == 175 {
          match scanDigits(after2) {
            (x, r, n) => if n == 0 { (~, cs, 0, true, true) } else { ((175, x), r, n + 2, true, false) },
          }
        } else {
          match scanDigits(after) {
            (x, r, n) => if n == 0 { (~, cs, 0, true, true) } else { (x, r, n + 1, true, false) },
          }
        },
        _ => (~, cs, 0, true, true),
      }
    } else { (~, cs, 0, false, false) },
    _ => (~, ~, 0, false, false),
  }
};
func numeralText(neg: Bool, d1: List<@>, frac: Bool, d2: List<@>, expo: Bool, d3: List<@>) -> List<@> {
  let a = if neg { (175, d1) } else { d1 };
  let b = if frac { cat(a, (46, d2)) } else { a };
  if expo { cat(b, (69, d3)) } else { b }
};
func cat(a: List<@>, b: List<@>) -> List<@> { match a { (h, t) => (h, cat(t, b)), _ => b, } };

// --- the line ----------------------------------------------------------
func tok(k: Kind, s: String, cp: @, col: @) -> Token { Token( kind: k, text: s, cp: cp, col: col ) };
func lexFrom(cs: List<@>, col: @, bol: Bool, acc: List<Token>) -> Lexed {
  match cs {
    (c, rest) => match c {
      32   => lexFrom(rest, col + 1, bol, acc),                                              // space
      9    => lexFrom(rest, col + 1, bol, acc),                                              // tab
      13   => lexFrom(rest, col, bol, acc),                                                  // CR
      10   => lexFrom(rest, 1, true, (tok(Kind.nl, "", 0, col), acc)),                       // line end (D-69)
      9053 => lexFrom(toLineEnd(rest), col, bol, acc),                                       // ⍝ comment to the line end (D-7)
      8900 => lexFrom(rest, col + 1, false, (tok(Kind.diamond, "⋄", 0, col), acc)),          // ⋄
      8592 => lexFrom(rest, col + 1, false, (tok(Kind.assign, "←", 0, col), acc)),           // ←
      8711 => match rest { (c2, r2) => if c2 == 8711 { lexFrom(r2, col + 2, false, (tok(Kind.name, "∇∇", 0, col), acc)) }   // ∇∇ the operator itself (D-95)
          else { lexFrom(rest, col + 1, false, (tok(Kind.del, "∇", 0, col), acc)) },                                          // ∇
        _ => lexFrom(rest, col + 1, false, (tok(Kind.del, "∇", 0, col), acc)), },
      123  => lexFrom(rest, col + 1, false, (tok(Kind.lbrace, "{{", 0, col), acc)),           // { (D-63)
      125  => lexFrom(rest, col + 1, false, (tok(Kind.rbrace, "}}", 0, col), acc)),           // }
      58   => lexFrom(rest, col + 1, false, (tok(Kind.colon, ":", 0, col), acc)),            // : (D-66)
      9082 => match rest { (c2, r2) => if c2 == 9082 { lexFrom(r2, col + 2, false, (tok(Kind.name, "⍺⍺", 0, col), acc)) }       // ⍺⍺ (D-95)
          else { lexFrom(rest, col + 1, false, (tok(Kind.name, "⍺", 0, col), acc)) },                                            // ⍺ (D-63)
        _ => lexFrom(rest, col + 1, false, (tok(Kind.name, "⍺", 0, col), acc)), },
      9077 => match rest { (c2, r2) => if c2 == 9077 { lexFrom(r2, col + 2, false, (tok(Kind.name, "⍵⍵", 0, col), acc)) }       // ⍵⍵
          else { lexFrom(rest, col + 1, false, (tok(Kind.name, "⍵", 0, col), acc)) },                                            // ⍵
        _ => lexFrom(rest, col + 1, false, (tok(Kind.name, "⍵", 0, col), acc)), },
      40   => lexFrom(rest, col + 1, false, (tok(Kind.lparen, "(", 0, col), acc)),
      41   => if bol and headIs(rest, isLetter) {                                            // )CMD (D-61)
                match scanName(rest) { (nm, r, n) => lexFrom(r, col + 1 + n, false, (tok(Kind.cmd, text(nm), 0, col), acc)), }
              } else { lexFrom(rest, col + 1, false, (tok(Kind.rparen, ")", 0, col), acc)) },
      91   => lexFrom(rest, col + 1, false, (tok(Kind.lbrack, "[", 0, col), acc)),
      93   => lexFrom(rest, col + 1, false, (tok(Kind.rbrack, "]", 0, col), acc)),
      59   => lexFrom(rest, col + 1, false, (tok(Kind.semi, ";", 0, col), acc)),
      175  => if headIs(rest, isDigit) { numeral(cs, col, true, bol, acc) }                  // ¯n (D-3)
              else { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "¯ is the negative sign of a numeral; − subtracts (D-3)" )) },
      46   => if headIs(rest, isDigit) { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "a numeral needs a digit before the point (D-3)" )) }
              else { lexFrom(rest, col + 1, false, (tok(Kind.glyph, ".", 46, col), acc)) },  // . the operator
      39   => match scanChr(rest, ~, 0) {                                                    // 'chars' (D-5)
                (closed, body, r, n) => if closed { lexFrom(r, col + 1 + n, false, (tok(Kind.chr, text(body), 0, col), acc)) }
                                        else { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "unterminated character literal (D-5)" )) },
                },
      9109 => match scanName(rest) {                                                         // ⎕NAME (D-60)
                (nm, r, n) => if n == 0 { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "⎕ needs a name (D-60)" )) }
                  else { lexFrom(r, col + 1 + n, false, (tok(Kind.quad, text(nm), 0, col), acc)) },
              },
      _    => if isDigit(c) { numeral(cs, col, false, bol, acc) }
              else if isLetter(c) {                                                          // name (D-2)
                match scanName(cs) { (nm, r, n) => lexFrom(r, col + n, false, (tok(Kind.name, text(nm), 0, col), acc)), }
              } else {
                let k = canon(c);
                if k == 0 { Lexed.err(LexErr( tag: "%syntax-error", col: col, hint: "not an ATL glyph" )) }
                else { lexFrom(rest, col + 1, false, (tok(Kind.glyph, text([k]), k, col), acc)) }
              },
    },
    _ => Lexed.ok(revToks(acc, ~)),
  }
};
func toLineEnd(cs: List<@>) -> List<@> { match cs { (c, rest) => if c == 10 { cs } else { toLineEnd(rest) }, _ => ~, } };
func tokens(line: String) -> Lexed { lexFrom(toCps(line.chars()), 1, true, ~) };

// --- ASCII input (D-8) -----------------------------------------------------------
// Under `)ASCII ON` a line is rewritten before it is lexed: a word of the table becomes its
// glyph, and `_` opening a token before a digit becomes `¯`. Quoted text and what follows ⍝
// are copied as typed. The rewrite answers the glyph text and, for each of its codepoints, the
// column it was typed at, so every token and refusal blames the column of the typed line.
func asciiGlyph(w: String) -> String {
  if w == "upstile" { "⌈" }
  else if w == "downstile" { "⌊" }
  else if w == "rho" { "⍴" }
  else if w == "iota" { "⍳" }
  else if w == "times" { "×" }
  else if w == "divide" { "÷" }
  else if w == "domino" { "⌹" }
  else if w == "circle" { "○" }
  else if w == "circlestar" { "⍟" }
  else if w == "circlestile" { "⌽" }
  else if w == "circlebar" { "⊖" }
  else if w == "gradeup" { "⍋" }
  else if w == "gradedown" { "⍒" }
  else if w == "hydrant" { "⍎" }
  else if w == "thorn" { "⍕" }
  else if w == "transpose" { "⍉" }
  else if w == "equalunderbar" { "≡" }
  else if w == "equalunderbarslash" { "≢" }
  else if w == "commabar" { "⍪" }
  else if w == "epsilon" { "∊" }
  else if w == "epsilonunderbar" { "⍷" }
  else if w == "uparrow" { "↑" }
  else if w == "downarrow" { "↓" }
  else if w == "uptack" { "⊥" }
  else if w == "downtack" { "⊤" }
  else if w == "diaeresis" { "¨" }
  else if w == "lessorequal" { "≤" }
  else if w == "greaterorequal" { "≥" }
  else if w == "notequal" { "≠" }
  else if w == "logicalor" { "∨" }
  else if w == "logicaland" { "∧" }
  else if w == "logicalnor" { "⍱" }
  else if w == "logicalnand" { "⍲" }
  else if w == "lefttack" { "⊣" }
  else if w == "righttack" { "⊢" }
  else if w == "leftshoe" { "⊂" }
  else if w == "rightshoe" { "⊃" }
  else if w == "downshoe" { "∪" }
  else if w == "upshoe" { "∩" }
  else if w == "zilde" { "⍬" }
  else if w == "tildediaeresis" { "⍨" }
  else if w == "stardiaeresis" { "⍣" }
  else if w == "jotdiaeresis" { "⍤" }
  else if w == "slashbar" { "⌿" }
  else if w == "backslashbar" { "⍀" }
  else if w == "jot" { "∘" }
  else if w == "diamond" { "⋄" }
  else if w == "leftarrow" { "←" }
  else if w == "del" { "∇" }
  else if w == "lamp" { "⍝" }
  else if w == "alpha" { "⍺" }
  else if w == "omega" { "⍵" }
  else if w == "alphaalpha" { "⍺⍺" }
  else if w == "omegaomega" { "⍵⍵" }
  else if w == "quadio" { "⎕IO" }
  else if w == "quadpp" { "⎕PP" }
  else if w == "quadtype" { "⎕TYPE" }
  else { "" }
};
func asciiLine(line: String) -> (String, List<@>) {
  match asciiFrom(toCps(line.chars()), 1, false, ~, ~) { (out, cols) => (text(revCps(out, ~)), revCps(cols, ~)), }
};
// out and cols are built reversed; quoted: inside '…'
func asciiFrom(cs: List<@>, col: @, quoted: Bool, out: List<@>, cols: List<@>) -> (List<@>, List<@>) {
  match cs {
    (c, rest) => if quoted { asciiFrom(rest, col + 1, c != 39, (c, out), (col, cols)) }
      else if c == 39 { asciiFrom(rest, col + 1, true, (c, out), (col, cols)) }
      else if c == 9053 { copyRest(cs, col, out, cols) }
      else if c == 95 and headIs(rest, isDigit) { asciiFrom(rest, col + 1, false, (175, out), (col, cols)) }
      else if isLetter(c) { match scanName(cs) { (nm, r, n) => {
          let g = asciiGlyph(text(nm));
          if g == "" { asciiFrom(r, col + n, false, pushAll(nm, out), pushCols(col, n, cols)) }
          else { let gs = toCps(g.chars()); let o2 = pushAll(gs, out); let c2 = pushSame(col, count(gs), cols);
            if g == "⍝" { copyRest(r, col + n, o2, c2) } else { asciiFrom(r, col + n, false, o2, c2) } }
        }, } }
      else { asciiFrom(rest, col + 1, false, (c, out), (col, cols)) },
    _ => (out, cols),
  }
};
func copyRest(cs: List<@>, col: @, out: List<@>, cols: List<@>) -> (List<@>, List<@>) {
  match cs { (c, rest) => copyRest(rest, col + 1, (c, out), (col, cols)), _ => (out, cols), }
};
func pushAll(xs: List<@>, acc: List<@>) -> List<@> { match xs { (h, t) => pushAll(t, (h, acc)), _ => acc, } };
func pushCols(col: @, n: @, acc: List<@>) -> List<@> { if n == 0 { acc } else { pushCols(col + 1, n - 1, (col, acc)) } };
func pushSame(col: @, n: @, acc: List<@>) -> List<@> { if n == 0 { acc } else { pushSame(col, n - 1, (col, acc)) } };
func count(xs: List<@>) -> @ { match xs { (h, t) => 1 + count(t), _ => 0, } };
// the typed column of a glyph-text column (1-based; 0, a line end's, stays 0)
func typedCol(cols: List<@>, c: @) -> @ { if c == 0 { 0 } else { colAt(cols, c - 1, c) } };
func colAt(cols: List<@>, i: @, dflt: @) -> @ { match cols { (h, t) => if i == 0 { h } else { colAt(t, i - 1, dflt) }, _ => dflt, } };
func remapToks(ts: List<Token>, cols: List<@>) -> List<Token> {
  match ts { (t, rest) => (Token( kind: t.kind, text: t.text, cp: t.cp, col: typedCol(cols, t.col) ), remapToks(rest, cols)), _ => ~, }
};
// a line's tokens in ASCII mode, every column the typed one
func asciiTokens(line: String) -> Lexed {
  match asciiLine(line) { (g, cols) => match tokens(g) {
    .ok(ts) => Lexed.ok(remapToks(ts, cols)),
    .err(e) => Lexed.err(LexErr( tag: e.tag, col: typedCol(cols, e.col), hint: e.hint )),
  }, }
};


// --- rendering (the lex corpus) -------------------------------------------
func kindName(k: Kind) -> String {
  match k {
    .nat => "nat", .int => "int", .real => "real", .chr => "chr", .name => "name",
    .quad => "quad", .cmd => "cmd", .glyph => "glyph", .lparen => "lparen", .rparen => "rparen",
    .lbrack => "lbrack", .rbrack => "rbrack", .semi => "semi", .assign => "assign", .del => "del", .diamond => "diamond",
    .lbrace => "lbrace", .rbrace => "rbrace", .colon => "colon", .nl => "nl",
  }
};
func showTok(t: Token) -> String {
  match t.kind {
    .nat => "nat:" + t.text, .int => "int:" + t.text, .real => "real:" + t.text,
    .chr => "chr:" + t.text, .name => "name:" + t.text, .quad => "quad:" + t.text,
    .cmd => "cmd:" + t.text, .glyph => "glyph:" + t.text,
    _ => kindName(t.kind),
  }
};
func render(ts: List<Token>) -> String {
  match ts { (h, t) => match t { (h2, t2) => showTok(h) + " " + render(t), _ => showTok(h), }, _ => "", }
};
func dump(line: String) -> String {
  match tokens(line) {
    .ok(ts) => render(ts),
    .err(e) => e.tag + " col:{e.col} " + e.hint,
  }
};

// --- back to source (a dfn body, D-67) ---------------------------------------
// The tokens of a run, as a line that lexes to the same tokens: a
// character literal gets its quotes back (a quote doubled, D-5), two
// word-like tokens get a space between them, and `⋄` and `:` get the
// spaces that read well. Columns are not preserved; a body line's
// refusal is reported by its line.
func wordy(k: Kind) -> Bool {
  match k { .nat => true, .int => true, .real => true, .chr => true, .name => true, .quad => true, .cmd => true, _ => false, }
};
func quoteChr(cs: List<@>) -> List<@> {
  match cs { (c, rest) => if c == 39 { (39, (39, quoteChr(rest))) } else { (c, quoteChr(rest)) }, _ => ~, }
};
func tokText(t: Token) -> String {
  match t.kind {
    .chr => "'" + text(quoteChr(toCps(t.text.chars()))) + "'",
    .quad => "⎕" + t.text,
    .cmd => ")" + t.text,
    _ => t.text,
  }
};
func spaced(a: Token, b: Token) -> Bool {
  (wordy(a.kind) and wordy(b.kind)) or (match a.kind { .diamond => true, .colon => true, _ => false, }) or (match b.kind { .diamond => true, _ => false, })
};
func unlexFrom(prev: Token, ts: List<Token>) -> String {
  match ts { (t, rest) => (if spaced(prev, t) { " " } else { "" }) + tokText(t) + unlexFrom(t, rest), _ => "", }
};
func unlex(ts: List<Token>) -> String {
  match ts { (t, rest) => tokText(t) + unlexFrom(t, rest), _ => "", }
};
