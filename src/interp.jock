// interp.jock — the reference evaluator (plan P3): literals, names,
// assignment, system variables, and the scalar functions of D-41 over
// the array model, with scalar extension (D-25), the kind lattice
// (D-11) and the fixed result kinds (D-12). It is the ORACLE for the
// emitter (P5), never the product; everything structural (D-42, D-43)
// answers %unimplemented until P4.
//
// Arithmetic on two same-kind rays goes through Lagoon's own arms
// (+ − ×); everything with a per-element decision (division by zero,
// residue's sign rule, the transcendental and comparison functions)
// walks the ravel in Jock and calls the package's scalar doors.
// A box (D-70) never reaches Lagoon's arithmetic: a scalar function
// recurses into its elements (D-72), and a structural function runs on
// its index ray and regathers (array.jock).
import lagoon;
import array;
import parse;
import nasm;

// a tradfn: its header, its body lines kept as SOURCE, and the compile
// cache (D-34): the trees of the last compilation and the signature they
// were compiled against. A call whose entry signature equals the key runs
// the trees; any other signature re-parses, which is what invalidates the
// cache when a name the body reads changes class.
struct Fndef { h: parse.Header, body: List<String>, cached: Bool, ckey: List<(String, @)>, cast: List<parse.Ast>, cfor: List<List<*>> };
// a named dfn (D-64) with the same cache; the cache holds the lines a call
// has reached so far (a guard ends a body early), and a later call that
// goes further parses the rest and extends it
struct Dfndef { d: parse.Dfn, cached: Bool, ckey: List<(String, @)>, cast: List<parse.Ast>, cfor: List<List<(*, *)>> };
// a dfn call's scope (D-65): its locals, its local dfns, the dfn itself
// (what ∇ names) and its global name when it has one (for the cache)
struct Frame { vars: List<(String, array.Arr)>, fns: List<(String, parse.Dfn)>, own: parse.Dfn, name: String, ops: List<(String, parse.Fn)> };   // ops: ⍺⍺ ⍵⍵ (D-95)
struct Env {
  store: List<(String, array.Arr)>,    // arrays by name (the globals)
  io: @, pp: @,                        // ⎕IO, ⎕PP
  fns: List<(String, Fndef)>,          // tradfns by name
  phdr: parse.Header,                  // the header of a definition in progress (D-62)
  pend: List<String>,                  // its body lines so far, reversed
  out: List<String>,                   // what body lines printed, reversed (drained by runStmt)
  dfns: List<(String, Dfndef)>,        // global dfns by name (D-64)
  frames: List<Frame>,                 // the dfn calls in progress, innermost first (D-65)
  nb: @, ib: @, rb: @,                 // ⎕TYPE: the bloq naturals, integers and reals are made at (D-15)
};
struct EErr { tag: String, hint: String };
enum Ev { err(EErr), ok((array.Arr, Env)) };
enum EnvR { err(EErr), ok(Env) };
enum BodyR { err(EErr), ok((List<parse.Ast>, List<List<*>>, Env)) };
enum Part { elide, ev(Ev) };
struct Info { kind: @, rank: @, rknown: Bool };   // inference (P7): kind 0 = unknown
// `let` is a Jock keyword, so the #let node is spelled `bind` here and the
// nasm package rewrites the tag to %let before lowering (structurally)
enum Nasm { atom(@), axis(String), cell(List<Nasm>), op((String, List<Nasm>)), bind((String, Nasm, Nasm)), nock(*) };
enum Sema { leaf(String), pair((Sema, Sema)) };
enum Evs { err(EErr), ok((List<array.Arr>, Env)) };
enum Parts { err(EErr), ok((List<List<@>>, List<@>, Env)) };
enum DfnR { err(EErr), ok((List<parse.Ast>, List<List<(*, *)>>, Bool, array.Arr, Env)) };
// an error guard in force (D-94): the codes it catches, its expression and formula, and the
// environment it was set in, where the expression runs when it catches
struct Trap { set: Bool, codes: List<@>, e: parse.Ast, f: *, env: Env };
enum StepR { err(EErr), next(Env), done((array.Arr, Env)), armed((Env, Trap)) };
enum ScanR { err(EErr), ok(((List<array.Arr>, List<List<@>>), Env)) };
enum EncR { err(EErr), ok((List<List<array.Arr>>, Env)) };

func fail(tag: String, hint: String) -> Ev { Ev.err(EErr( tag: tag, hint: hint )) };
func noHeader() -> parse.Header { parse.Header( nm: "", res: "", lft: "", rgt: "", locals: ~ ) };
func setStore(e: Env, st: List<(String, array.Arr)>) -> Env { Env( store: st, io: e.io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setIo(e: Env, io: @) -> Env { Env( store: e.store, io: io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setPp(e: Env, pp: @) -> Env { Env( store: e.store, io: e.io, pp: pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setFns(e: Env, fns: List<(String, Fndef)>) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setPending(e: Env, h: parse.Header, pend: List<String>) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: e.fns, phdr: h, pend: pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setOut(e: Env, out: List<String>) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: out, dfns: e.dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setDfns(e: Env, dfns: List<(String, Dfndef)>) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: dfns, frames: e.frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func setTw(e: Env, nb: @, ib: @, rb: @) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: e.frames, nb: nb, ib: ib, rb: rb ) };
func setFrames(e: Env, frames: List<Frame>) -> Env { Env( store: e.store, io: e.io, pp: e.pp, fns: e.fns, phdr: e.phdr, pend: e.pend, out: e.out, dfns: e.dfns, frames: frames, nb: e.nb, ib: e.ib, rb: e.rb ) };
func pushOut(e: Env, line: String) -> Env { if line == "" { e } else { setOut(e, (line, e.out)) } };
func dom(hint: String) -> Ev { fail("%domain-error", hint) };
func nyi(what: String) -> Ev { fail("%unimplemented", what) };

// --- the store ------------------------------------------------------------------
func lookup(st: List<(String, array.Arr)>, nm: String) -> (Bool, array.Arr) {
  match st { ((n, v), t) => if n == nm { (true, v) } else { lookup(t, nm) }, _ => (false, array.scalar(1, 0)), }
};
func put(st: List<(String, array.Arr)>, nm: String, v: array.Arr) -> List<(String, array.Arr)> {
  match st { ((n, w), t) => if n == nm { ((nm, v), t) } else { ((n, w), put(t, nm, v)) }, _ => [(nm, v)], }
};
// --- scope (D-65) ------------------------------------------------------------------
// A name is read through the dfn frames, innermost first, then the store;
// ⍺ and ⍵ belong to the innermost frame alone. An assignment inside a dfn
// binds in the innermost frame; at the prompt it binds in the store, and
// a dfn of that name is gone (D-64).
func isArg(nm: String) -> Bool { nm == "⍺" or nm == "⍵" };
// ⍺ is bound in the innermost frame: the dfn was called with a left argument (or ⍺← has run)
func alphaBound(env: Env) -> Bool { match env.frames { (f, rest) => match lookup(f.vars, "⍺") { (found, v) => found, }, _ => false, } };
func lookupVar(env: Env, nm: String) -> (Bool, array.Arr) {
  match env.frames {
    (f, rest) => match lookup(f.vars, nm) {
      (found, v) => if found { (true, v) } else if isArg(nm) { (false, v) } else { lookupFrames(rest, env.store, nm) },
    },
    _ => if isArg(nm) { (false, array.scalar(1, 0)) } else { lookup(env.store, nm) },
  }
};
func lookupFrames(frames: List<Frame>, st: List<(String, array.Arr)>, nm: String) -> (Bool, array.Arr) {
  match frames {
    (f, rest) => match lookup(f.vars, nm) { (found, v) => if found { (true, v) } else { lookupFrames(rest, st, nm) }, },
    _ => lookup(st, nm),
  }
};
func putVar(env: Env, nm: String, v: array.Arr) -> Env {
  match env.frames {
    (f, rest) => setFrames(env, (Frame( vars: put(f.vars, nm, v), fns: f.fns, own: f.own, name: f.name, ops: f.ops ), rest)),
    _ => setDfns(setStore(env, put(env.store, nm, v)), delDfn(env.dfns, nm)),
  }
};
func delDfn(ds: List<(String, Dfndef)>, nm: String) -> List<(String, Dfndef)> {
  match ds { ((n, d), t) => if n == nm { t } else { ((n, d), delDfn(t, nm)) }, _ => ~, }
};
func putDfn(ds: List<(String, Dfndef)>, nm: String, d: Dfndef) -> List<(String, Dfndef)> {
  match ds { ((n, w), t) => if n == nm { ((nm, d), t) } else { ((n, w), putDfn(t, nm, d)) }, _ => [(nm, d)], }
};
func lookupDfn(ds: List<(String, Dfndef)>, nm: String) -> (Bool, Dfndef) {
  match ds { ((n, d), t) => if n == nm { (true, d) } else { lookupDfn(t, nm) }, _ => (false, noDfn()), }
};
func noDfn() -> Dfndef { Dfndef( d: parse.Dfn( body: ~ ), cached: false, ckey: ~, cast: ~, cfor: ~ ) };
func lookupLocalFn(frames: List<Frame>, nm: String) -> (Bool, parse.Dfn) {
  match frames {
    (f, rest) => match lookupPD(f.fns, nm) { (found, d) => if found { (true, d) } else { lookupLocalFn(rest, nm) }, },
    _ => (false, parse.Dfn( body: ~ )),
  }
};
func lookupPD(fs: List<(String, parse.Dfn)>, nm: String) -> (Bool, parse.Dfn) {
  match fs { ((n, d), t) => if n == nm { (true, d) } else { lookupPD(t, nm) }, _ => (false, parse.Dfn( body: ~ )), }
};
func putPD(fs: List<(String, parse.Dfn)>, nm: String, d: parse.Dfn) -> List<(String, parse.Dfn)> {
  match fs { ((n, w), t) => if n == nm { ((nm, d), t) } else { ((n, w), putPD(t, nm, d)) }, _ => [(nm, d)], }
};
// F ← {…}: in a dfn a local function, at the prompt a global one that
// replaces a tradfn of the name (D-64)
func putFnDef(env: Env, nm: String, d: parse.Dfn) -> Env {
  match env.frames {
    (f, rest) => setFrames(env, (Frame( vars: delStore(f.vars, nm), fns: putPD(f.fns, nm, d), own: f.own, name: f.name, ops: f.ops ), rest)),
    _ => setFns(setStore(setDfns(env, putDfn(env.dfns, nm, Dfndef( d: d, cached: false, ckey: ~, cast: ~, cfor: ~ ))), delStore(env.store, nm)), delFn(env.fns, nm)),
  }
};

// --- literals (D-3, D-5) ------------------------------------------------------------
func digitsNat(cs: List<@>, acc: @) -> @ { match cs { (c, t) => if c >= 48 and c <= 57 { digitsNat(t, acc * 10 + (c - 48)) } else { acc }, _ => acc, } };
func cps(s: String) -> List<@> { array.toCps(s.chars()) };
func natOf(s: String) -> @ { digitsNat(cps(s), 0) };
func intOf(s: String) -> @ { match cps(s) { (c, t) => if c == 175 { lagoon.tneg(digitsNat(t, 0)) } else { digitsNat(cps(s), 0) }, _ => 0, } };
// mantissa digits m, fraction length k, exponent (eneg, emag):  m × 10^(e−k) (scanMant, scanExp; realAt below)
func scanMant(cs: List<@>, m: @, k: @, frac: Bool) -> (@, @, List<@>) {
  match cs {
    (c, t) => if c >= 48 and c <= 57 { scanMant(t, m * 10 + (c - 48), if frac { k + 1 } else { k }, frac) }
      else if c == 46 { scanMant(t, m, k, true) }
      else { (m, k, cs) },
    _ => (m, k, ~),
  }
};
func scanExp(cs: List<@>) -> (Bool, @) {
  match cs {
    (e, t) => match t { (c, t2) => if c == 175 { (true, digitsNat(t2, 0)) } else { (false, digitsNat(t, 0)) }, _ => (false, 0), },
    _ => (false, 0),
  }
};
func litVals(k: @, items: List<String>) -> List<@> { litValsAt(k, 6, items) };
func litValsAt(k: @, w: @, items: List<String>) -> List<@> {
  match items { (h, t) => (match k { 2 => intOf(h), 3 => realAt(h, w), _ => natOf(h), }, litValsAt(k, w, t)), _ => ~, }
};
// a numeral that does not fit the session's width of its kind is a DOMAIN ERROR (D-15): a natural
// of 2^w or more, an integer outside −2^(w−1)..2^(w−1)−1, a real that rounds to infinity
func litEv(l: parse.Lit, env: Env) -> Ev {
  if l.kind == 4 { okv(litArr(l), env) }
  else {
    let a = litAt(l, env);
    let fits = if l.kind == 1 { natsFit(array.vals(litArr(l)), array.pow2(array.pow2(env.nb))) }
      else if l.kind == 2 { intsFit(array.vals(litArr(l)), array.pow2(array.pow2(env.ib) - 1)) }
      else { realsFinite(array.vals(a)) };
    if fits { okv(a, env) } else { dom("a numeral does not fit " + typeOfKind(l.kind, env) + " (D-15)") }
  }
};
func typeOfKind(k: @, env: Env) -> String { if k == 1 { "UINT" + bitsText(env.nb) } else if k == 2 { "INT" + bitsText(env.ib) } else { "REAL" + bitsText(env.rb) } };
func natsFit(xs: List<@>, lim: @) -> Bool { match xs { (x, t) => if x < lim { natsFit(t, lim) } else { false }, _ => true, } };
// int2 bits: a magnitude below half (positive) or at most half (negative)
func intsFit(xs: List<@>, half: @) -> Bool {
  match xs { (x, t) => { let ok = if array.isNeg(x) { lagoon.tabs(x) <= half } else { x < half }; if ok { intsFit(t, half) } else { false } }, _ => true, }
};
func realsFinite(xs: List<@>) -> Bool { match xs { (x, t) => if array.finite(x) { realsFinite(t) } else { false }, _ => true, } };
// a literal as the session makes it:  reals at its real width, naturals and integers wrapped (D-15)
func litAt(l: parse.Lit, env: Env) -> array.Arr {
  if l.kind == 3 {
    let vs = litValsAt(3, env.rb, l.vals);
    let n = array.count(vs);
    array.makeReal(env.rb, if n == 1 { ~ } else { [n] }, vs)
  } else { array.narrow(litArr(l), env.nb, env.ib, env.rb) }
};
// a real numeral at width w, correctly rounded (hoon-138's +grd):  m × 10^(e−k)
func realAt(s: String, w: @) -> @ {
  match cps(s) {
    (c, t) => {
      let neg = c == 175;
      let body = if neg { t } else { cps(s) };
      match scanMant(body, 0, 0, false) {
        (m, k, rest) => match scanExp(rest) {
          (eneg, emag) => if m == 0 { array.tagged(w, 0) } else {
            // the decimal exponent e = ±emag − k as a ZigZag @s:  2e when e ≥ 0, 2|e| − 1 when e < 0
            let eneg2 = eneg or emag < k;
            let emag2 = if eneg { emag + k } else if emag >= k { emag - k } else { k - emag };
            let z = if emag2 == 0 { 0 } else if eneg2 { 2 * emag2 - 1 } else { 2 * emag2 };
            array.rgrd(w, not neg, z, m)
          },
        },
      }
    },
    _ => 0,
  }
};
func litArr(l: parse.Lit) -> array.Arr {
  if l.kind == 4 {
    match l.vals {
      (s, t) => {
        let cs = cps(s);
        let n = array.count(cs);
        if n == 1 { array.make(4, ~, cs) } else { array.make(4, [n], cs) }
      },
      _ => array.make(4, [0], ~),
    }
  } else {
    let vs = litVals(l.kind, l.vals);
    let n = array.count(vs);
    if n == 1 { array.make(l.kind, ~, vs) } else { array.make(l.kind, [n], vs) }
  }
};

// --- scalar helpers over bits -------------------------------------------------------
func isZero(x: @) -> Bool { x == 0 };
func realZero(x: @) -> Bool { array.rop(1, x, array.zeroLike(x)) == array.zeroLike(x) };        // +0 and −0, at x's width (D-15)
func b2n(b: Bool) -> @ { if b { 1 } else { 0 } };
// int2 compare:  x > y
func intGt(x: @, y: @) -> Bool {
  let nx = array.isNeg(x);
  let ny = array.isNeg(y);
  if nx and (not ny) { false } else if ny and (not nx) { true }
  else if nx { lagoon.tabs(x) < lagoon.tabs(y) } else { x > y }
};
func gtK(k: @, x: @, y: @) -> Bool { match k { 2 => intGt(x, y), 3 => array.rcmp(3, x, y), _ => x > y, } };
func eqK(k: @, x: @, y: @) -> Bool { match k { 3 => (array.rcmp(2, x, y) and array.rcmp(4, x, y)), _ => x == y, } };
// APL residue (D-41):  B − A×⌊B÷A, zero left answers the right
func resNat(a: @, b: @) -> @ { if a == 0 { b } else { b % a } };
func resInt(a: @, b: @) -> @ {
  if a == 0 { b } else {
    let na = array.isNeg(a);
    let nb = array.isNeg(b);
    let ma = lagoon.tabs(a);
    let mb = lagoon.tabs(b);
    let m = mb % ma;
    if na == nb { if na { lagoon.tneg(m) } else { m } }
    else if m == 0 { 0 }
    else if na { lagoon.tneg(ma - m) } else { ma - m }
  }
};
// ⌊x as a real of x's width
func floorReal(x: @) -> @ { array.rsanLike(x, array.rtoi(100, x)) };
func resReal(a: @, b: @) -> @ {
  if realZero(a) { b } else { array.rop(2, b, array.rop(3, a, floorReal(array.rop(4, b, a)))) }
};
func factNat(n: @) -> @ { if n == 0 { 1 } else { n * factNat(n - 1) } };
// the code a and the argument x share a width:  a primitive brings both to the session's
func circle(a: @, x: @) -> @ {
  let one = array.oneLike(x);
  let z = array.zeroLike(x);
  if a == array.rsunAt(array.widthOf(x), 1) { array.rfun(4, x) }
  else if a == array.rsunAt(array.widthOf(x), 2) { array.rfun(5, x) }
  else if a == array.rsunAt(array.widthOf(x), 3) { array.rfun(6, x) }
  else if a == z { array.rfun(1, array.rop(2, one, array.rop(3, x, x))) }
  else if a == array.rsunAt(array.widthOf(x), 4) { array.rfun(1, array.rop(1, one, array.rop(3, x, x))) }
  else if array.rop(1, a, one) == z { array.rfun(7, x) }
  else if array.rop(1, a, array.rsunAt(array.widthOf(x), 2)) == z { array.rfun(8, x) }
  else if array.rop(1, a, array.rsunAt(array.widthOf(x), 3)) == z { array.rfun(9, x) }
  else if array.rop(1, a, array.rsunAt(array.widthOf(x), 4)) == z { array.rfun(1, array.rop(2, array.rop(3, x, x), one)) }
  else { 0 }
};
func isBool(x: @) -> Bool { x == 0 or x == 1 };
func isCircleCode(c: @) -> Bool {
  let z = array.zeroLike(c);
  let four = array.rsunAt(array.widthOf(c), 4);
  let frac = array.rop(2, c, floorReal(c));
  (array.rcmp(4, c, z) and array.rcmp(2, c, four) and array.rcmp(4, frac, z) and (frac == z))
  or (array.rcmp(2, c, z) and array.rcmp(4, c, array.rop(2, z, four)) and (frac == z))
};

// --- named scalar helpers:  a lambda body cannot reach an imported module
// (Jock reads `lagoon.x` inside a lambda as a field of *, S-11), so every
// module call a lambda would make is a named func, and lambdas call these.
func powB(x: @, y: @) -> @ { array.rpow(x, y) };
func logB(x: @, y: @) -> @ { array.rop(4, array.rfun(3, y), array.rfun(3, x)) };
func divB(x: @, y: @) -> @ { if realZero(y) { array.oneLike(y) } else { array.rop(4, x, y) } };
func binomR(x: @, y: @) -> @ { array.rop(4, array.rfun(10, y), array.rop(3, array.rfun(10, x), array.rfun(10, array.rop(2, y, x)))) };
func negR(x: @) -> @ { array.rop(2, array.zeroLike(x), x) };
func negI(x: @) -> @ { lagoon.tneg(x) };
func absI(x: @) -> @ { lagoon.tabs(x) };
func absR(x: @) -> @ { if array.realIsNeg(x) { negR(x) } else { x } };
func sgnI(x: @) -> @ { if array.isNeg(x) { lagoon.tneg(1) } else { b2n(x > 0) } };
func sgnR(x: @) -> @ { if array.realIsNeg(x) { lagoon.tneg(1) } else { b2n(not realZero(x)) } };
func recipR(x: @) -> @ { array.rop(4, array.oneLike(x), x) };
func ceilI(x: @) -> @ { array.sToInt(array.rtoi(117, x)) };
func floorI(x: @) -> @ { array.sToInt(array.rtoi(100, x)) };
func expR(x: @) -> @ { array.rfun(2, x) };
func lnR(x: @) -> @ { array.rfun(3, x) };
func piR(x: @) -> @ { array.rop(3, array.rpiAt(array.widthOf(x)), x) };
func factR(x: @) -> @ { array.rfun(10, x) };

// --- dyadic scalar functions (D-41) ---------------------------------------------------
func isScalarFn(cp: @) -> Bool {
  cp == 43 or cp == 8722 or cp == 215 or cp == 247 or cp == 8968 or cp == 8970 or cp == 8739 or cp == 8902
  or cp == 9055 or cp == 9675 or cp == 33 or cp == 60 or cp == 8804 or cp == 61 or cp == 8805 or cp == 62
  or cp == 8800 or cp == 8744 or cp == 8743 or cp == 9073 or cp == 9074
};
func dyadPrim(cp: @, a0: array.Arr, b0: array.Arr, env: Env) -> Ev {
  if not isScalarFn(cp) { nyi("dyadic " + lexerText(cp)) }
  else if array.isBox(a0) or array.isBox(b0) { zipItems(parse.Fn.prim(cp), a0, b0, env) }
  else if (a0.kind == 4 or b0.kind == 4) and cp != 61 and cp != 8800 { dom("characters take only = and ≠") }
  else {
    match array.extend(a0, b0) {
      (a, b, tag) => if tag != "" { fail(tag, "shapes " + shp(a0) + " and " + shp(b0)) }
      else {
        let k = array.maxk(a.kind, b.kind);
        match cp {
          // reals through Lagoon's jetted %i754 arms; naturals and integers by the linear zip g-arith uses,
          // since Lagoon's +bin-op walk is a non-tail recursion, quadratic under NockVM for a kind it does not jet (P11b)
          43   => if k == 3 { okv(lagAdd(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), k), env) }
            else { okv(mk(k, array.shape(a), zipK(addK, k, array.vals(array.promoteAt(a, k, env.rb)), array.vals(array.promoteAt(b, k, env.rb)))), env) },   // +
          8722 => { let j = array.maxk(k, 2); if j == 3 { okv(array.Arr( kind: j, ray: lagoon.sub(array.promoteAt(a, j, env.rb).ray, array.promoteAt(b, j, env.rb).ray), items: ~ ), env) }
            else { okv(mk(j, array.shape(a), zipK(subK, j, array.vals(array.promoteAt(a, j, env.rb)), array.vals(array.promoteAt(b, j, env.rb)))), env) } },   // −
          215  => if k == 3 { okv(array.Arr( kind: k, ray: lagoon.mul(array.promoteAt(a, k, env.rb).ray, array.promoteAt(b, k, env.rb).ray), items: ~ ), env) }
            else { okv(mk(k, array.shape(a), zipK(mulK, k, array.vals(array.promoteAt(a, k, env.rb)), array.vals(array.promoteAt(b, k, env.rb)))), env) },   // ×
          247  => divide(array.toRealAt(a, env.rb), array.toRealAt(b, env.rb), env),                                       // ÷
          8968 => okv(array.zipArr(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), k, lambda (x: @, y: @) -> @ { if gtK(k, x, y) { x } else { y } }), env),  // ⌈
          8970 => okv(array.zipArr(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), k, lambda (x: @, y: @) -> @ { if gtK(k, x, y) { y } else { x } }), env),  // ⌊
          8739 => residue(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), k, env),                           // ∣
          8902 => okv(array.zipArr(array.toRealAt(a, env.rb), array.toRealAt(b, env.rb), 3, powB), env),   // ⋆
          9055 => okv(array.zipArr(array.toRealAt(a, env.rb), array.toRealAt(b, env.rb), 3, logB), env),   // ⍟
          9675 => circleD(array.toRealAt(a, env.rb), array.toRealAt(b, env.rb), env),                                       // ○
          33   => binomial(a, b, k, env),                                                               // !
          60   => cmp(a, b, k, lambda (x: @, y: @) -> Bool { gtK(k, y, x) }, env),                      // <
          8804 => cmp(a, b, k, lambda (x: @, y: @) -> Bool { not gtK(k, x, y) }, env),                  // ≤
          61   => equal(a, b, k, true, env),                                                            // =
          8805 => cmp(a, b, k, lambda (x: @, y: @) -> Bool { not gtK(k, y, x) }, env),                  // ≥
          62   => cmp(a, b, k, lambda (x: @, y: @) -> Bool { gtK(k, x, y) }, env),                      // >
          8800 => equal(a, b, k, false, env),                                                           // ≠
          8744 => boolean(a, b, lambda (x: @, y: @) -> @ { if x == 1 or y == 1 { 1 } else { 0 } }, env),     // ∨
          8743 => boolean(a, b, lambda (x: @, y: @) -> @ { if x == 1 and y == 1 { 1 } else { 0 } }, env),    // ∧
          9073 => boolean(a, b, lambda (x: @, y: @) -> @ { if x == 0 and y == 0 { 1 } else { 0 } }, env),    // ⍱
          9074 => boolean(a, b, lambda (x: @, y: @) -> @ { if x == 1 and y == 1 { 0 } else { 1 } }, env),    // ⍲
          _    => nyi("dyadic " + lexerText(cp)),
        }
      },
    }
  }
};
func lexerText(cp: @) -> String { utf8([cp as! UniChar]) };
func shp(a: array.Arr) -> String { array.joinS(array.fmtAll(1, array.shape(a), 10), " ") };
func okv(v: array.Arr, env: Env) -> Ev { Ev.ok((v, env)) };
func lagAdd(a: array.Arr, b: array.Arr, k: @) -> array.Arr { array.Arr( kind: k, ray: lagoon.add(a.ray, b.ray), items: ~ ) };
func divide(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.anyZip(array.vals(a), array.vals(b), lambda (x: @, y: @) -> Bool { realZero(y) and (not realZero(x)) }) { dom("division by zero") }
  else { okv(array.zipArr(a, b, 3, divB), env) }
};
func residue(a: array.Arr, b: array.Arr, k: @, env: Env) -> Ev {
  match k {
    2 => okv(array.zipArr(a, b, 2, resInt), env),
    3 => okv(array.zipArr(a, b, 3, resReal), env),
    _ => okv(array.zipArr(a, b, 1, resNat), env),
  }
};
func circleD(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.allL(array.vals(a), isCircleCode) { okv(array.zipArr(a, b, 3, circle), env) } else { dom("○ takes a code in ¯4..4 on the left") }
};
func binomial(a: array.Arr, b: array.Arr, k: @, env: Env) -> Ev {
  match k {
    1 => if array.anyZip(array.vals(a), array.vals(b), lambda (x: @, y: @) -> Bool { x > y }) { okv(array.zipArr(a, b, 1, lambda (x: @, y: @) -> @ { if x > y { 0 } else { factNat(y) / (factNat(x) * factNat(y - x)) } }), env) }
         else { okv(array.zipArr(a, b, 1, lambda (x: @, y: @) -> @ { factNat(y) / (factNat(x) * factNat(y - x)) }), env) },
    _ => okv(array.zipArr(array.toRealAt(a, env.rb), array.toRealAt(b, env.rb), 3, binomR), env),
  }
};
func cmp(a: array.Arr, b: array.Arr, k: @, p: (@, @) -> Bool, env: Env) -> Ev {
  okv(array.zipArr(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), 1, lambda (x: @, y: @) -> @ { b2n(p(x, y)) }), env)
};
func equal(a: array.Arr, b: array.Arr, k: @, want: Bool, env: Env) -> Ev {
  if (a.kind == 4) != (b.kind == 4) { okv(array.mapArr(a, 1, lambda (x: @) -> @ { b2n(not want) }), env) }
  else { okv(array.zipArr(array.promoteAt(a, k, env.rb), array.promoteAt(b, k, env.rb), 1, lambda (x: @, y: @) -> @ { b2n(eqK(k, x, y) == want) }), env) }
};
func boolean(a: array.Arr, b: array.Arr, f: (@, @) -> @, env: Env) -> Ev {
  if a.kind != 1 or b.kind != 1 or (not array.allL(array.vals(a), isBool)) or (not array.allL(array.vals(b), isBool)) { dom("Boolean functions take 0 and 1") }
  else { okv(array.zipArr(a, b, 1, f), env) }
};

// --- monadic scalar functions (D-41) ------------------------------------------------------
func monadPrim(cp: @, a0: array.Arr, env: Env) -> Ev {
  let a = if a0.kind == 3 { array.toRealAt(a0, env.rb) } else { a0 };      // a real argument at the session's width (D-15)
  if array.isBox(a) { mapItems(parse.Fn.prim(cp), a, env) }
  else if a.kind == 4 { dom("characters take no arithmetic") }
  else {
    match cp {
      43   => okv(a, env),                                                                                   // + conjugate
      8722 => match a.kind { 3 => okv(array.mapArr(a, 3, negR), env),
                             _ => okv(array.mapArr(a, 2, negI), env), },                               // − negate
      215  => match a.kind { 1 => okv(array.mapArr(a, 1, lambda (x: @) -> @ { b2n(x > 0) }), env),
                             2 => okv(array.mapArr(a, 2, sgnI), env),
                             _ => okv(array.mapArr(a, 2, sgnR), env), },   // × signum
      247  => if array.anyL(array.vals(array.toRealAt(a, env.rb)), realZero) { dom("division by zero") }
              else { okv(array.mapArr(array.toRealAt(a, env.rb), 3, recipR), env) },   // ÷ reciprocal
      8968 => match a.kind { 3 => okv(array.mapArr(a, 2, ceilI), env), _ => okv(a, env), },   // ⌈
      8970 => match a.kind { 3 => okv(array.mapArr(a, 2, floorI), env), _ => okv(a, env), },   // ⌊
      8739 => match a.kind { 2 => okv(array.mapArr(a, 2, absI), env),
                             3 => okv(array.mapArr(a, 3, absR), env),
                             _ => okv(a, env), },                                                            // ∣ magnitude
      8902 => okv(array.mapArr(array.toRealAt(a, env.rb), 3, expR), env),         // ⋆ exp
      9055 => okv(array.mapArr(array.toRealAt(a, env.rb), 3, lnR), env),         // ⍟ ln
      9675 => okv(array.mapArr(array.toRealAt(a, env.rb), 3, piR), env),   // ○ pi times
      33   => match a.kind { 1 => okv(array.mapArr(a, 1, factNat), env),
                             3 => okv(array.mapArr(a, 3, factR), env),
                             _ => dom("! of a negative") },                                                  // ! factorial
      8764 => if a.kind == 1 and array.allL(array.vals(a), isBool) { okv(array.mapArr(a, 1, lambda (x: @) -> @ { 1 - x }), env) } else { dom("∼ takes 0 and 1") },   // ∼ not
      _    => nyi("monadic " + lexerText(cp)),
    }
  }
};

// --- function application (D-21, D-43) ----------------------------------------------------
func isScalarMonad(cp: @) -> Bool {
  cp == 43 or cp == 8722 or cp == 215 or cp == 247 or cp == 8968 or cp == 8970 or cp == 8739
  or cp == 8902 or cp == 9055 or cp == 9675 or cp == 33 or cp == 8764
};
// Every array a function makes is made at the session's widths (D-15), except the shapes and
// indices ⍴B ⍳B ⍋B ⍒B ≢B and A⍳B, which stay 64-bit naturals.
func applyMonad(f: parse.Fn, a: array.Arr, env: Env) -> Ev { atWidths(applyMonad0(f, a, env), indexFn(f)) };
func applyDyad(f: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev { atWidths(applyDyad0(f, a, b, env), indexFnD(f)) };
func indexFn(f: parse.Fn) -> Bool { match f { .prim(cp) => cp == 9076 or cp == 9075 or cp == 9035 or cp == 9042 or cp == 8802, _ => false, } };
func indexFnD(f: parse.Fn) -> Bool { match f { .prim(cp) => cp == 9075, _ => false, } };
func atWidths(r: Ev, keep: Bool) -> Ev {
  if keep { r } else { match r { .ok(p) => match p { (v, env2) => okv(array.narrow(v, env2.nb, env2.ib, env2.rb), env2), }, .err(e) => r, } }
};
func applyMonad0(f: parse.Fn, a: array.Arr, env: Env) -> Ev {
  match f {
    .prim(cp) => if isScalarMonad(cp) { monadPrim(cp, a, env) } else { monadStruct(cp, a, env) },
    .reduce(g) => reduce(g, a, false, env),
    .reduce1(g) => reduce(g, a, true, env),
    .scan(g) => scan(g, a, false, env),
    .scan1(g) => scan(g, a, true, env),
    .each(g) => mapItems(g, a, env),
    .inner(i) => nyi("monadic inner product"),
    .outer(g) => nyi("monadic outer product"),
    .user(nm) => callNamed(nm, false, array.scalar(1, 0), a, env),
    .dfn(d) => callDfn("", d, false, array.scalar(1, 0), a, env),
    .own => callOwn(false, array.scalar(1, 0), a, env),
    .dop(x) => callOp(x, false, array.scalar(1, 0), a, env),
    .axis(x) => if x.half { laminateMonad(x.f, x.k, a, env) } else { axisMonad(x.f, x.k, a, env) },
  }
};
// a name of function class: a local dfn, a global dfn, or a tradfn (D-64, D-65)
func callNamed(nm: String, dyadic: Bool, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if nm == "⍺⍺" or nm == "⍵⍵" { match lookupOp(env.frames, nm) {
    (found, g) => if not found { fail("%value-error", nm + " names an operand only inside an operator (D-95)") }
      else { backIn(if dyadic { applyDyad(g, a, b, setFrames(env, outerFrames(env.frames))) } else { applyMonad(g, b, setFrames(env, outerFrames(env.frames))) }, env.frames) },
  } } else {
  match lookupLocalFn(env.frames, nm) {
    (local, ld) => if local { callDfn("", ld, dyadic, a, b, env) }
      else { match lookupDfn(env.dfns, nm) {
        (global, gd) => if global { callDfn(nm, gd.d, dyadic, a, b, env) } else { callUser(nm, dyadic, true, a, b, env) },
      } },
  } }
};
func backIn(r: Ev, frames: List<Frame>) -> Ev { match r { .ok(x) => match x { (v, env2) => okv(v, setFrames(env2, frames)), }, .err(e) => Ev.err(e), } };
// an operand runs where the operator was applied:  the frames outside the operator's own
func outerFrames(fs: List<Frame>) -> List<Frame> { match fs { (f, rest) => rest, _ => ~, } };
// ∇ inside a body: the dfn the innermost frame runs (D-63)
func callOwn(dyadic: Bool, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match env.frames { (f, rest) => callDfn(f.name, f.own, dyadic, a, b, env), _ => fail("%syntax-error", "∇ names a dfn only inside one"), }
};
func applyDyad0(f: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match f {
    .prim(cp) => if isScalarFn(cp) { dyadPrim(cp, a, b, env) } else { dyadStruct(cp, a, b, env) },
    .each(g) => zipItems(g, a, b, env),
    .inner(i) => inner(i.f, i.g, a, b, env),
    .outer(g) => outer(g, a, b, env),
    .reduce(g) => nyi("n-wise reduction"),
    .reduce1(g) => nyi("n-wise reduction"),
    .scan(g) => nyi("dyadic scan"),
    .scan1(g) => nyi("dyadic scan"),
    .user(nm) => callNamed(nm, true, a, b, env),
    .dfn(d) => callDfn("", d, true, a, b, env),
    .own => callOwn(true, a, b, env),
    .dop(x) => callOp(x, true, a, b, env),
    .axis(x) => if x.half { laminateDyad(x.f, x.k, a, b, env) } else { axisDyad(x.f, x.k, a, b, env) },
  }
};
// --- pervasion and each (D-72, D-74): f on every element, the results in normal form ----
func mapItems(f: parse.Fn, a: array.Arr, env: Env) -> Ev {
  match mapEach(f, array.itemsOf(a), env, ~) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (vs, env2) => okv(array.normalize(array.shape(a), vs), env2), },
  }
};
func mapEach(f: parse.Fn, xs: List<array.Arr>, env: Env, acc: List<array.Arr>) -> Evs {
  match xs {
    (h, t) => match applyMonad(f, h, env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => mapEach(f, t, env2, (v, acc)), }, },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
func zipItems(f: parse.Fn, a0: array.Arr, b0: array.Arr, env: Env) -> Ev {
  match array.extend(a0, b0) {
    (a, b, tag) => if tag != "" { fail(tag, "shapes " + shp(a0) + " and " + shp(b0)) }
      else { match zipEach(f, array.itemsOf(a), array.itemsOf(b), env, ~) {
        .err(e) => Ev.err(e),
        .ok(r) => match r { (vs, env2) => okv(array.normalize(array.shape(a), vs), env2), },
      } },
  }
};
func zipEach(f: parse.Fn, xs: List<array.Arr>, ys: List<array.Arr>, env: Env, acc: List<array.Arr>) -> Evs {
  match xs {
    (x, xt) => match ys {
      (y, yt) => match applyDyad(f, x, y, env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => zipEach(f, xt, yt, env2, (v, acc)), }, },
      _ => Evs.ok((array.revA(acc, ~), env)),
    },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
// a scalar function as a value: f on two SCALARS, the result's single element and kind
func mk(k: @, shp: List<@>, vs: List<@>) -> array.Arr { array.make(k, shp, vs) };
func vec(k: @, vs: List<@>) -> array.Arr { array.make(k, [array.count(vs)], vs) };
func sc(k: @, v: @) -> array.Arr { array.scalar(k, v) };
func natArg(a: array.Arr, what: String) -> (Bool, @) {
  if a.kind == 1 and array.size(array.shape(a)) == 1 { (true, array.first(a)) } else { (false, 0) }
};
// an integer argument that may be negative:  (ok, negative, magnitude)
func intArg(a: array.Arr) -> (Bool, Bool, @) {
  if array.size(array.shape(a)) != 1 { (false, false, 0) }
  else {
    let x = array.first(a);
    match a.kind { 1 => (true, false, x), 2 => (true, array.isNeg(x), lagoon.tabs(x)), _ => (false, false, 0), }
  }
};
func natVec(a: array.Arr) -> (Bool, List<@>) {
  if a.kind == 1 and array.rank(a) <= 1 { (true, array.vals(a)) } else { (false, ~) }
};

// --- axes (D-82, D-83): the lines of an array along one axis ----------------------------------
// An operation along axis k reads each LINE (the positions along k for one
// index of the other axes), rewrites it, and the lines go back by position.
// A box takes the same path on its index ray (D-70), so every function here
// works on a List<@> of values or element numbers.
func axisOf(k: @, r: @, env: Env) -> (Bool, @) { if k >= env.io and (k - env.io) < r { (true, k - env.io) } else { (false, 0) } };
func withoutAt(xs: List<@>, k: @) -> List<@> { array.catL(array.takeL(xs, k), array.dropL(xs, k + 1)) };
func insertAt(xs: List<@>, k: @, v: @) -> List<@> { if k == 0 { (v, xs) } else { match xs { (h, t) => (h, insertAt(t, k - 1, v)), _ => [v], } } };
func rangesOf(shp: List<@>) -> List<List<@>> { match shp { (d, t) => (array.iotaL(d, 0), rangesOf(t)), _ => ~, } };
func lineAt(st: @, step: @, len: @) -> List<@> { if len == 0 { ~ } else { (st, lineAt(st + step, step, len - 1)) } };
// the lines along axis k as position lists, outer index slowest
func axisLines(shp: List<@>, k: @) -> List<List<@>> {
  let outer = array.cartesian(rangesOf(withoutAt(shp, k)));
  linesFrom(outer, shp, k, array.nth(shp, k), array.size(array.dropL(shp, k + 1)))
};
func linesFrom(outer: List<List<@>>, shp: List<@>, k: @, len: @, step: @) -> List<List<@>> {
  match outer { (ix, rest) => (lineAt(array.flatIx(shp, insertAt(ix, k, 0)), step, len), linesFrom(rest, shp, k, len, step)), _ => ~, }
};
func nthLL(xss: List<List<@>>, i: @) -> List<@> { match xss { (h, t) => if i == 0 { h } else { nthLL(t, i - 1) }, _ => ~, } };
func gatherLines(vs: List<@>, lines: List<List<@>>) -> List<List<@>> { match lines { (l, rest) => (gatherAt(vs, l), gatherLines(vs, rest)), _ => ~, } };
// the ravel of shape shp2 whose lines along k are `lines`, in outer order
func fromLines(shp2: List<@>, k: @, lines: List<List<@>>) -> List<@> { fromLinesAt(shp2, k, withoutAt(shp2, k), lines, 0, array.size(shp2)) };
func fromLinesAt(shp2: List<@>, k: @, rest: List<@>, lines: List<List<@>>, p: @, n: @) -> List<@> {
  if p == n { ~ } else {
    let ix = array.unflatIx(shp2, p);
    (array.nth(nthLL(lines, array.flatIx(rest, withoutAt(ix, k))), array.nth(ix, k)), fromLinesAt(shp2, k, rest, lines, p + 1, n))
  }
};
// an array of a's kind with axis k rewritten to the given lines of a new length
func rebuildAxis(a: array.Arr, k: @, len2: @, lines: List<List<@>>) -> array.Arr {
  let shp2 = setNth(array.shape(a), k, len2);
  mk(a.kind, shp2, fromLines(shp2, k, lines))
};
func unbox(a: array.Arr) -> array.Arr { if array.isBox(a) { array.ixArr(a) } else { a } };
func rebox(a: array.Arr, r: array.Arr) -> array.Arr { if array.isBox(a) { array.regather(a, r) } else { r } };
// the elements along one line, as arrays
func lineItems(a: array.Arr, pos: List<@>) -> List<array.Arr> {
  if array.isBox(a) { array.pickItems(a, gatherAt(array.vals(a), pos)) } else { array.scalarsOf(a.kind, gatherAt(array.vals(a), pos)) }
};
func revLines(ls: List<List<@>>) -> List<List<@>> { match ls { (l, rest) => (array.revL(l, ~), revLines(rest)), _ => ~, } };
func reverseAxis(a: array.Arr, k: @) -> array.Arr {
  let x = unbox(a);
  rebox(a, rebuildAxis(x, k, array.nth(array.shape(x), k), revLines(gatherLines(array.vals(x), axisLines(array.shape(x), k)))))
};
// counts as signed (negative, magnitude) pairs from a natural or integer array
func intCounts(a: array.Arr) -> (Bool, List<(Bool, @)>) {
  match a.kind { 1 => (true, natSigned(array.vals(a))), 2 => (true, intSigned(array.vals(a))), _ => (false, ~), }
};
func natSigned(xs: List<@>) -> List<(Bool, @)> { match xs { (h, t) => ((false, h), natSigned(t)), _ => ~, } };
func intSigned(xs: List<@>) -> List<(Bool, @)> { match xs { (h, t) => ((array.isNeg(h), lagoon.tabs(h)), intSigned(t)), _ => ~, } };
func repPair(c: (Bool, @), n: @) -> List<(Bool, @)> { if n == 0 { ~ } else { (c, repPair(c, n - 1)) } };
func countPairs(xs: List<(Bool, @)>) -> @ { match xs { (h, t) => 1 + countPairs(t), _ => 0, } };
func rotBy(neg: Bool, mag: @, n: @) -> @ { if n == 0 { 0 } else if neg { (n - (mag % n)) % n } else { mag % n } };
func rotLines(ls: List<List<@>>, cs: List<(Bool, @)>, n: @) -> List<List<@>> {
  match ls { (l, rest) => match cs { ((neg, mag), ct) => (rotateL(l, rotBy(neg, mag, n)), rotLines(rest, ct, n)), _ => ~, }, _ => ~, }
};
// A⌽[k]B: a scalar count or one per line, in the shape of B without the axis
func rotateAxis(a: array.Arr, b: array.Arr, k: @, env: Env) -> Ev {
  match intCounts(a) {
    (ok, cs) => if not ok { dom("the left argument of rotate is an integer") }
    else {
      let x = unbox(b);
      let shp = array.shape(x);
      let lines = axisLines(shp, k);
      let nl = array.countLL(lines);
      let counts = if array.size(array.shape(a)) == 1 { repPair(match cs { (c, t) => c, _ => (false, 0), }, nl) } else { cs };
      if countPairs(counts) != nl { fail("%length-error", "one rotation per line") }
      else if array.rank(a) > 0 and array.size(array.shape(a)) != 1 and array.shape(a) != withoutAt(shp, k) { fail("%rank-error", "the counts take the shape of the right argument without the axis") }
      else { okv(rebox(b, rebuildAxis(x, k, array.nth(shp, k), rotLines(gatherLines(array.vals(x), lines), counts, array.nth(shp, k)))), env) }
    },
  }
};
// A/[k]B and A\[k]B along any axis: the counts against the axis length
func repAxis(a: array.Arr, b: array.Arr, k: @, expandIt: Bool, env: Env) -> Ev {
  match natVec(a) {
    (ok, cs0) => if not ok { dom("the left argument of / and \\ is a vector of non-negative integers") }
    else {
      let x = unbox(b);
      let shp = array.shape(x);
      let len = array.nth(shp, k);
      let cs = if array.rank(a) == 0 { array.repL(array.first(a), if expandIt { len } else { len }) } else { cs0 };
      let need = if expandIt { countNonzero(cs) } else { array.count(cs) };
      if need != len { fail("%length-error", if expandIt { "the nonzero counts and the axis differ" } else { "the counts and the axis differ" }) }
      else {
        let lines = gatherLines(array.vals(x), axisLines(shp, k));
        let fill = if array.isBox(b) { 0 } else { array.fillOf(b.kind) };
        let len2 = if expandIt { sumL(cs) + (array.count(cs) - need) } else { sumL(cs) };
        let lines2 = if expandIt { expRows(lines, cs, fill) } else { repRows(lines, cs) };
        okv(rebox(b, rebuildAxis(x, k, len2, lines2)), env)
      }
    },
  }
};
// f/[k]B and f\[k]B: each line folds (D-81, D-83)
func reduceAxis(f: parse.Fn, a: array.Arr, k: @, env: Env) -> Ev {
  let shp = array.shape(a);
  if array.rank(a) == 1 and not array.isBox(a) {
    match reduceL(f, a.kind, array.vals(a), env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => okv(array.enclose(v), env2), }, }
  } else {
    match reduceLines(f, a, axisLines(shp, k), env, ~) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (vs, env2) => okv(array.normalize(withoutAt(shp, k), vs), env2), },
    }
  }
};
func reduceLines(f: parse.Fn, a: array.Arr, lines: List<List<@>>, env: Env, acc: List<array.Arr>) -> Evs {
  match lines {
    (l, rest) => match reduceItems(f, lineItems(a, l), env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => reduceLines(f, a, rest, env2, (v, acc)), }, },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
func scanAxis(f: parse.Fn, a: array.Arr, k: @, env: Env) -> Ev {
  let shp = array.shape(a);
  let lines = axisLines(shp, k);
  match scanLines(f, a, lines, env, ~, 1, ~) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (res, env2) => match res {
      (items, numbered) => okv(array.regather(array.boxOf([array.countA(items)], items), mk(1, shp, fromLines(shp, k, numbered))), env2),
    }, },
  }
};
// every line's scan results, numbered from n in line order: (the results, the numbered lines)
func scanLines(f: parse.Fn, a: array.Arr, lines: List<List<@>>, env: Env, acc: List<array.Arr>, n: @, nacc: List<List<@>>) -> ScanR {
  match lines {
    (l, rest) => {
      let xs = lineItems(a, l);
      let len = array.countA(xs);
      match scanItems(f, xs, 0, len, env, ~) {
        .err(e) => ScanR.err(e),
        .ok(r) => match r { (vs, env2) => scanLines(f, a, rest, env2, array.catA(acc, vs), n + len, (array.iotaL(len, n), nacc)), },
      }
    },
    _ => ScanR.ok(((acc, revLL(nacc, ~)), env)),
  }
};
// A,[k]B: the lines joined; a scalar or an argument one rank lower takes the shape of the other with axis k of length 1
func catenateAxis(a0: array.Arr, b0: array.Arr, k: @, env: Env) -> Ev {
  if array.isBox(a0) or array.isBox(b0) or ((a0.kind == 4) != (b0.kind == 4)) { catenateItems(a0, b0, k, env) }
  else {
    let j = joinKind(a0, b0);
    let a = array.promoteAt(a0, j, joinW(a0, b0));
    let b = array.promoteAt(b0, j, joinW(a0, b0));
    let ra = array.rank(a);
    let rb = array.rank(b);
    let r = array.maxk(ra, rb);
    if k >= r { fail("%axis-error", "no such axis") }
    else {
      let a2 = fitAxis(a, b, k, r);
      let b2 = fitAxis(b, a, k, r);
      let sa = array.shape(a2);
      let sb = array.shape(b2);
      if array.rank(a2) != r or array.rank(b2) != r { fail("%rank-error", "ranks differ by more than one") }
      else if withoutAt(sa, k) != withoutAt(sb, k) { fail("%length-error", "shapes differ off the axis") }
      else {
        let la = gatherLines(array.vals(a2), axisLines(sa, k));
        let lb = gatherLines(array.vals(b2), axisLines(sb, k));
        okv(rebuildAxis(a2, k, array.nth(sa, k) + array.nth(sb, k), catPairs(la, lb)), env)
      }
    }
  }
};
func catPairs(xs: List<List<@>>, ys: List<List<@>>) -> List<List<@>> {
  match xs { (x, xt) => match ys { (y, yt) => (array.catL(x, y), catPairs(xt, yt)), _ => ~, }, _ => ~, }
};
// a scalar, or an argument of rank r-1, as rank r with axis k of length 1 against the other's shape
func fitAxis(a: array.Arr, other: array.Arr, k: @, r: @) -> array.Arr {
  if array.rank(a) == r { a }
  else if array.rank(a) == 0 { array.spread(a, insertAt(withoutAt(array.shape(other), k), k, 1)) }
  else if array.rank(a) + 1 == r { mk(a.kind, insertAt(array.shape(a), k, 1), array.vals(a)) }
  else { a }
};
// catenation of elements (D-72): the two index rays numbered end to end
func catenateItems(a: array.Arr, b: array.Arr, k: @, env: Env) -> Ev {
  let ia = array.itemsOf(a);
  let ib = array.itemsOf(b);
  let na = array.countA(ia);
  let nb = array.countA(ib);
  let ra = mk(1, array.shape(a), array.iotaL(na, 1));
  let rb = mk(1, array.shape(b), array.iotaL(nb, na + 1));
  match catenateAxis(ra, rb, k, env) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (v, env2) => okv(array.regather(array.boxOf([na + nb], array.catA(ia, ib)), v), env2), },
  }
};
// --- a fractional axis (D-92) ---------------------------------------------------------------------
// `k` is ⌊axis⌋+1 as parsed, so the new axis goes before position k-⎕IO (0-origin) of the shape
func halfPos(k: @, r: @, env: Env) -> (Bool, @) { if k >= env.io and (k - env.io) <= r { (true, k - env.io) } else { (false, 0) } };
// a with the same elements under a new shape of the same count (a box keeps its items)
func reshapeKeep(a: array.Arr, shp: List<@>) -> array.Arr {
  if array.isBox(a) { array.regather(a, mk(1, shp, array.vals(array.ixArr(a)))) } else { mk(a.kind, shp, array.vals(a)) }
};
func isComma(f: parse.Fn) -> Bool { match f { .prim(cp) => cp == 44, _ => false, } };
// ,[k]B: B with a new axis of length 1
func laminateMonad(f: parse.Fn, k: @, a: array.Arr, env: Env) -> Ev {
  if not isComma(f) { fail("%axis-error", "a fractional axis takes , alone (D-92)") }
  else { match halfPos(k, array.rank(a), env) {
    (ok, pos) => if not ok { fail("%axis-error", "the fractional axis is outside the rank") }
      else { okv(reshapeKeep(a, insertAt(array.shape(a), pos, 1)), env) },
  } }
};
// A,[k]B: A and B of one shape (a scalar extends) joined along a new axis of length 2
func laminateDyad(f: parse.Fn, k: @, a0: array.Arr, b0: array.Arr, env: Env) -> Ev {
  if not isComma(f) { fail("%axis-error", "a fractional axis takes , alone (D-92)") }
  else { match extendTo(a0, b0, env) { .err(e) => Ev.err(e), .ok(ra) => match ra { (a, e1) => laminateB(k, a, b0, env), }, } }
};
func laminateB(k: @, a: array.Arr, b0: array.Arr, env: Env) -> Ev {
  match extendTo(b0, a, env) { .err(e) => Ev.err(e), .ok(rb) => match rb { (b, e2) => laminateAB(k, a, b, env), }, }
};
func laminateAB(k: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(a) != array.rank(b) { fail("%rank-error", "laminate takes arrays of one rank") }
  else if array.shape(a) != array.shape(b) { fail("%length-error", "laminate takes arrays of one shape") }
  else { match halfPos(k, array.rank(a), env) {
    (ok, pos) => if not ok { fail("%axis-error", "the fractional axis is outside the rank") }
      else { let shp = insertAt(array.shape(a), pos, 1); catenateAxis(reshapeKeep(a, shp), reshapeKeep(b, shp), pos, env) },
  } }
};
// a scalar a takes other's shape; anything else stays
func extendTo(a: array.Arr, other: array.Arr, env: Env) -> Ev {
  if array.rank(a) == 0 and array.rank(other) > 0 { dyadStruct(9076, vec(1, array.shape(other)), a, env) } else { okv(a, env) }
};
func axisMonad(f: parse.Fn, k0: @, a: array.Arr, env: Env) -> Ev {
  match axisOf(k0, array.rank(a), env) {
    (ok, k) => if not ok { fail("%axis-error", "axis {k0} is outside the rank") }
    else { match f {
      .prim(cp) => if cp == 9021 or cp == 8854 { okv(reverseAxis(a, k), env) } else { nyi("axis specification on monadic " + lexerText(cp)) },
      .reduce(g) => reduceAxis(g, a, k, env),
      .reduce1(g) => reduceAxis(g, a, k, env),
      .scan(g) => scanAxis(g, a, k, env),
      .scan1(g) => scanAxis(g, a, k, env),
      _ => nyi("axis specification on that function"),
    } },
  }
};
func axisDyad(f: parse.Fn, k0: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let r = array.maxk(array.rank(a), array.rank(b));
  match axisOf(k0, r, env) {
    (ok, k) => if not ok { fail("%axis-error", "axis {k0} is outside the rank") }
    else { match f {
      .prim(cp) => if cp == 9021 or cp == 8854 { rotateAxis(a, b, k, env) }
        else if cp == 44 { catenateAxis(a, b, k, env) }
        else if cp == 47 or cp == 9023 { repAxis(a, b, k, false, env) }
        else if cp == 92 or cp == 9024 { repAxis(a, b, k, true, env) }
        else if cp == 8834 { if array.rank(b) > 1 { partitionAxis(a, b, k, env) } else { partitionVec(a, b, env) } }
        else { nyi("axis specification on dyadic " + lexerText(cp)) },
      _ => nyi("axis specification on that function"),
    } },
  }
};

// --- monadic structural functions (D-42) --------------------------------------------------
func monadStruct(cp: @, a: array.Arr, env: Env) -> Ev {
  if array.isBox(a) { monadBox(cp, a, env) } else { monadSimple(cp, a, env) }
};
// on a box: the shape-only and element-moving functions run on the index ray (D-72)
func monadBox(cp: @, a: array.Arr, env: Env) -> Ev {
  match cp {
    9076 => okv(vec(1, array.shape(a)), env),                                                   // ⍴
    44   => viaM(cp, a, env),                                                                   // ,
    9021 => viaM(cp, a, env),                                                                   // ⌽
    8854 => viaM(cp, a, env),                                                                   // ⊖
    9033 => viaM(cp, a, env),                                                                   // ⍉
    8714 => okv(enlist(a), env),                                                                // ∊
    9035 => grade(a, true, env),                                                                // ⍋
    9042 => grade(a, false, env),                                                               // ⍒
    8867 => okv(a, env),                                                                        // ⊣
    8866 => okv(a, env),                                                                        // ⊢
    8834 => okv(array.enclose(a), env),                                                         // ⊂
    8835 => disclose(a, env),                                                                   // ⊃
    8593 => okv(array.firstItem(a), env),                                                       // ↑
    8801 => okv(sc(1, array.depth(a)), env),                                                    // ≡
    9075 => dom("⍳ takes a non-negative integer scalar"),
    8802 => okv(sc(1, tally(a)), env),                                                          // ≢
    9066 => okv(table(a), env),                                                                 // ⍪
    9045 => formatArr(a, env),                                                                  // ⍕
    9038 => dom("⍎ takes a character vector"),
    9017 => dom("⌹ takes a numeric matrix"),
    _    => nyi("monadic " + lexerText(cp) + " on a nested array"),
  }
};
func viaM(cp: @, a: array.Arr, env: Env) -> Ev {
  match monadSimple(cp, array.ixArr(a), env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => okv(array.regather(a, v), env2), }, }
};
func monadSimple(cp: @, a: array.Arr, env: Env) -> Ev {
  match cp {
    9075 => match natArg(a, "⍳") { (ok, n) => if ok { okv(vec(1, array.iotaL(n, env.io)), env) } else { dom("⍳ takes a non-negative integer scalar") }, },   // ⍳
    9076 => okv(vec(1, array.shape(a)), env),                                                   // ⍴
    44   => okv(vec(a.kind, array.vals(a)), env),                                               // , ravel
    8714 => okv(vec(a.kind, array.vals(a)), env),                                               // ∊ enlist (flat: ravel)
    9021 => okv(reverseLast(a), env),                                                           // ⌽
    8854 => okv(reverseFirst(a), env),                                                          // ⊖
    9033 => okv(transposeArr(a), env),                                                          // ⍉
    9035 => grade(a, true, env),                                                                // ⍋
    9042 => grade(a, false, env),                                                               // ⍒
    8867 => okv(a, env),                                                                        // ⊣
    8866 => okv(a, env),                                                                        // ⊢
    8834 => okv(array.enclose(a), env),                                                         // ⊂ (D-73)
    8835 => okv(a, env),                                                                        // ⊃ of a simple array
    8593 => okv(array.firstItem(a), env),                                                       // ↑ first
    8801 => okv(sc(1, array.depth(a)), env),                                                    // ≡ depth
    8802 => okv(sc(1, tally(a)), env),                                                          // ≢ tally (D-79)
    9066 => okv(table(a), env),                                                                 // ⍪ table (D-84)
    9045 => formatArr(a, env),                                                                  // ⍕ (D-88)
    9038 => execute(a, env),                                                                    // ⍎ (D-89)
    9017 => solve(identityOf(a), a, true, env),                                                 // ⌹ inverse (D-90)
    _    => nyi("monadic " + lexerText(cp)),
  }
};
func reverseLast(a: array.Arr) -> array.Arr {
  if array.rank(a) == 0 { a } else {
    let n = array.lastDim(array.shape(a));
    mk(a.kind, array.shape(a), array.flatten(revRows(array.chunks(array.vals(a), n))))
  }
};
func revRows(rows: List<List<@>>) -> List<List<@>> { match rows { (r, rest) => (array.revL(r, ~), revRows(rest)), _ => ~, } };
func reverseFirst(a: array.Arr) -> array.Arr {
  if array.rank(a) == 0 or array.size(array.shape(a)) == 0 { a } else {
    let n = array.size(array.shape(a)) / array.firstDim(array.shape(a));
    mk(a.kind, array.shape(a), array.flatten(revLL(array.chunks(array.vals(a), n), ~)))
  }
};
func revLL(xss: List<List<@>>, acc: List<List<@>>) -> List<List<@>> { match xss { (h, t) => revLL(t, (h, acc)), _ => acc, } };
func transposeArr(a: array.Arr) -> array.Arr {
  if array.rank(a) <= 1 { a } else {
    let shp = array.shape(a);
    let tshp = array.revL(shp, ~);
    let vs = array.vals(a);
    mk(a.kind, tshp, transposeGather(shp, tshp, vs, 0, array.size(shp)))
  }
};
func transposeGather(shp: List<@>, tshp: List<@>, vs: List<@>, k: @, n: @) -> List<@> {
  if k == n { ~ } else { (array.nth(vs, array.flatIx(shp, array.revL(array.unflatIx(tshp, k), ~))), transposeGather(shp, tshp, vs, k + 1, n)) }
};
// stable insertion of (index, value) into a list sorted up or down
func gradeIns(i: @, v: @, k: @, up: Bool, sorted: List<(@, @)>) -> List<(@, @)> {
  match sorted {
    ((j, w), t) => if (up and gtK(k, w, v)) or ((not up) and gtK(k, v, w)) { ((i, v), sorted) } else { ((j, w), gradeIns(i, v, k, up, t)) },
    _ => [(i, v)],
  }
};
func gradeAll(vs: List<@>, i: @, k: @, up: Bool, sorted: List<(@, @)>) -> List<(@, @)> {
  match vs { (v, rest) => gradeAll(rest, i + 1, k, up, gradeIns(i, v, k, up, sorted)), _ => sorted, }
};
func gradeIdx(sorted: List<(@, @)>, io: @) -> List<@> { match sorted { ((i, v), t) => (i + io, gradeIdx(t, io)), _ => ~, } };
func grade(a: array.Arr, up: Bool, env: Env) -> Ev {
  if array.rank(a) != 1 { fail("%rank-error", "grade takes a vector") }
  else if array.isBox(a) { okv(vec(1, gradeIdxA(gradeAllA(array.itemsOf(a), 0, up, ~), env.io)), env) }
  else { okv(vec(1, gradeIdx(gradeAll(array.vals(a), 0, a.kind, up, ~), env.io)), env) }
};
// the total order on arrays (D-75): 0 less, 1 equal, 2 greater
func cmpArr(a: array.Arr, b: array.Arr) -> @ {
  if array.isBox(a) != array.isBox(b) { if array.isBox(a) { 2 } else { 0 } }
  else if array.isBox(a) { cmpThen(cmpItems(array.itemsOf(a), array.itemsOf(b)), cmpVals(1, array.shape(a), array.shape(b))) }
  else if array.classOf(a) != array.classOf(b) { if array.classOf(a) == 1 { 2 } else { 0 } }
  else {
    let k = array.maxk(a.kind, b.kind);
    cmpThen(cmpVals(k, array.vals(array.promote(a, k)), array.vals(array.promote(b, k))), cmpVals(1, array.shape(a), array.shape(b)))
  }
};
func cmpThen(x: @, y: @) -> @ { if x == 1 { y } else { x } };
func cmpVals(k: @, xs: List<@>, ys: List<@>) -> @ {
  match xs {
    (x, xt) => match ys { (y, yt) => if gtK(k, x, y) { 2 } else if gtK(k, y, x) { 0 } else { cmpVals(k, xt, yt) }, _ => 2, },
    _ => match ys { (y, yt) => 0, _ => 1, },
  }
};
func cmpItems(xs: List<array.Arr>, ys: List<array.Arr>) -> @ {
  match xs {
    (x, xt) => match ys { (y, yt) => { let c = cmpArr(x, y); if c == 1 { cmpItems(xt, yt) } else { c } }, _ => 2, },
    _ => match ys { (y, yt) => 0, _ => 1, },
  }
};
func gradeInsA(i: @, v: array.Arr, up: Bool, sorted: List<(@, array.Arr)>) -> List<(@, array.Arr)> {
  match sorted {
    ((j, w), t) => if (up and cmpArr(w, v) == 2) or ((not up) and cmpArr(v, w) == 2) { ((i, v), sorted) } else { ((j, w), gradeInsA(i, v, up, t)) },
    _ => [(i, v)],
  }
};
func gradeAllA(xs: List<array.Arr>, i: @, up: Bool, sorted: List<(@, array.Arr)>) -> List<(@, array.Arr)> {
  match xs { (v, rest) => gradeAllA(rest, i + 1, up, gradeInsA(i, v, up, sorted)), _ => sorted, }
};
func gradeIdxA(sorted: List<(@, array.Arr)>, io: @) -> List<@> { match sorted { ((i, v), t) => (i + io, gradeIdxA(t, io)), _ => ~, } };
// match (D-73): same shape, same class, every element equal
func matchArr(a: array.Arr, b: array.Arr) -> Bool {
  if array.isBox(a) != array.isBox(b) { false }
  else if array.shape(a) != array.shape(b) { false }
  else if array.isBox(a) { matchAll(array.itemsOf(a), array.itemsOf(b)) }
  else if array.classOf(a) != array.classOf(b) { false }
  else {
    let k = array.maxk(a.kind, b.kind);
    eqVals(k, array.vals(array.promote(a, k)), array.vals(array.promote(b, k)))
  }
};
func matchAll(xs: List<array.Arr>, ys: List<array.Arr>) -> Bool {
  match xs { (x, xt) => match ys { (y, yt) => if matchArr(x, y) { matchAll(xt, yt) } else { false }, _ => false, }, _ => true, }
};
func eqVals(k: @, xs: List<@>, ys: List<@>) -> Bool {
  match xs { (x, xt) => match ys { (y, yt) => if eqK(k, x, y) { eqVals(k, xt, yt) } else { false }, _ => false, }, _ => true, }
};
// enlist (D-73): every leaf in ravel order
func enlist(a: array.Arr) -> array.Arr { let ls = leaves(a); array.normalize([array.countA(ls)], ls) };
func leaves(a: array.Arr) -> List<array.Arr> { if array.isBox(a) { leavesAll(array.itemsOf(a)) } else { array.scalarsOf(a.kind, array.vals(a)) } };
func leavesAll(xs: List<array.Arr>) -> List<array.Arr> { match xs { (h, t) => array.catA(leaves(h), leavesAll(t)), _ => ~, } };
// disclose (D-73): simple scalar or vector elements of one class, padded to the longest
func disclose(a: array.Arr, env: Env) -> Ev {
  let xs = array.itemsOf(a);
  let r = maxRank(xs, 0);
  if not ranksOk(xs, r) { fail("%rank-error", "⊃ takes elements of one rank, or scalars") }
  else {
    let shp2 = maxShape(xs, array.repL(0, r));
    match padEach(xs, r, shp2, env, ~) {
      .err(e) => Ev.err(e),
      .ok(p) => match p { (padded, env2) => okv(array.normalize(array.catL(array.shape(a), shp2), itemsOfAll(padded)), env2), },
    }
  }
};
func itemsOfAll(xs: List<array.Arr>) -> List<array.Arr> { match xs { (h, t) => array.catA(array.itemsOf(h), itemsOfAll(t)), _ => ~, } };
func maxRank(xs: List<array.Arr>, m: @) -> @ { match xs { (h, t) => maxRank(t, array.maxk(m, array.rank(h))), _ => m, } };
func ranksOk(xs: List<array.Arr>, r: @) -> Bool { match xs { (h, t) => if array.rank(h) == r or array.rank(h) == 0 { ranksOk(t, r) } else { false }, _ => true, } };
func maxShape(xs: List<array.Arr>, m: List<@>) -> List<@> { match xs { (h, t) => maxShape(t, if array.rank(h) == 0 { zipMax1(m) } else { zipMaxL(m, array.shape(h)) }), _ => m, } };
func zipMax1(m: List<@>) -> List<@> { match m { (h, t) => (array.maxk(h, 1), zipMax1(t)), _ => ~, } };
func zipMaxL(m: List<@>, s: List<@>) -> List<@> { match m { (h, t) => match s { (h2, t2) => (array.maxk(h, h2), zipMaxL(t, t2)), _ => ~, }, _ => ~, } };
// every element taken up to the common shape, so its leaves lie in one cell; a leaf list per element
func padEach(xs: List<array.Arr>, r: @, shp2: List<@>, env: Env, acc: List<array.Arr>) -> Evs {
  match xs {
    (h, t) => if r == 0 { padEach(t, r, shp2, env, (h, acc)) }
      else { match takeDropN(vec(1, shp2), h, true, env) { .err(e) => Evs.err(e), .ok(p) => match p { (v, env2) => padEach(t, r, shp2, env2, (v, acc)), }, } },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
func simpleRank1(xs: List<array.Arr>) -> Bool { match xs { (h, t) => if array.isBox(h) or array.rank(h) > 1 { false } else { simpleRank1(t) }, _ => true, } };
func maxLen(xs: List<array.Arr>, m: @) -> @ { match xs { (h, t) => maxLen(t, array.maxk(m, array.size(array.shape(h)))), _ => m, } };
func padAll(xs: List<array.Arr>, k: @, l: @) -> List<@> {
  match xs {
    (h, t) => array.catL(array.vals(array.promoteAt(h, k, array.realWA(xs, 0))), array.catL(array.repL(array.fillOf(k), l - array.size(array.shape(h))), padAll(t, k, l))),
    _ => ~,
  }
};
// pick (D-73): an index, or a path of indices through nested boxes
func pick(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, path) => if not ok { dom("the left argument of ⊃ is an index or a path of indices") } else { pickPath(path, b, env) },
  }
};
func pickPath(path: List<@>, b: array.Arr, env: Env) -> Ev {
  match path {
    (i, rest) => if array.rank(b) != 1 { fail("%rank-error", "⊃ picks from a vector") }
      else if i < env.io or (i - env.io) >= array.firstDim(array.shape(b)) { fail("%index-error", "index out of range") }
      else { pickPath(rest, array.nthA(array.itemsOf(b), i - env.io), env) },
    _ => okv(b, env),
  }
};

// --- dyadic structural functions (D-42) ----------------------------------------------------
func dyadStruct(cp: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.isBox(a) or array.isBox(b) { dyadBox(cp, a, b, env) } else { dyadSimple(cp, a, b, env) }
};
// with a box on either side: comparisons by match, catenation of elements, the
// element-moving functions on the index ray with a simple left argument (D-72)
func dyadBox(cp: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match cp {
    9075 => indexOfA(a, b, env),                                                                // A⍳B
    8714 => memberA(a, b, env),                                                                 // A∊B
    44   => catenate(a, b, env),                                                                // A,B
    8801 => okv(sc(1, b2n(matchArr(a, b))), env),                                               // A≡B
    8835 => pick(a, b, env),                                                                    // A⊃B
    8834 => partition(a, b, env),                                                               // A⊂B
    8802 => okv(sc(1, 1 - b2n(matchArr(a, b))), env),                                           // A≢B
    9079 => find(a, b, env),                                                                    // A⍷B
    9066 => tableCat(a, b, env),                                                                // A⍪B
    9045 => dom("⍕ with a left argument formats numbers"),
    9017 => dom("⌹ takes numeric arrays"),
    8867 => okv(a, env),                                                                        // A⊣B
    8866 => okv(b, env),                                                                        // A⊢B
    8869 => dom("⊥ and ⊤ take simple numbers"),
    8868 => dom("⊥ and ⊤ take simple numbers"),
    _    => if array.isBox(a) { dom("the left argument of " + lexerText(cp) + " is a simple array (D-72)") } else { viaD(cp, a, b, env) },
  }
};
func viaD(cp: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match dyadSimple(cp, a, array.ixArr(b), env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => okv(array.regather(b, v), env2), }, }
};
func dyadSimple(cp: @, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match cp {
    9075 => indexOf(a, b, env),                                                                 // A⍳B
    9076 => reshape(a, b, env),                                                                 // A⍴B
    44   => catenate(a, b, env),                                                                // A,B
    9021 => rotate(a, b, false, env),                                                           // A⌽B
    8854 => rotate(a, b, true, env),                                                            // A⊖B
    8593 => takeDrop(a, b, true, env),                                                          // A↑B
    8595 => takeDrop(a, b, false, env),                                                         // A↓B
    8714 => member(a, b, env),                                                                  // A∊B
    47   => compress(a, b, env),                                                                // A/B
    92   => expand(a, b, env),                                                                  // A\B
    8869 => decode(a, b, env),                                                                  // A⊥B
    8868 => encode(a, b, env),                                                                  // A⊤B
    8867 => okv(a, env),                                                                        // A⊣B
    8866 => okv(b, env),                                                                        // A⊢B
    8835 => pick(a, b, env),                                                                    // A⊃B (D-73)
    8801 => okv(sc(1, b2n(matchArr(a, b))), env),                                               // A≡B
    8802 => okv(sc(1, 1 - b2n(matchArr(a, b))), env),                                           // A≢B (D-79)
    8834 => partition(a, b, env),                                                               // A⊂B (D-78)
    9079 => find(a, b, env),                                                                    // A⍷B (D-87)
    9066 => tableCat(a, b, env),                                                                // A⍪B (D-84)
    9033 => transposeBy(a, b, env),                                                             // A⍉B (D-85)
    9045 => formatBy(a, b, env),                                                                // A⍕B (D-88)
    9017 => solve(a, b, false, env),                                                            // A⌹B (D-90)
    9023 => compressFirst(a, b, env),                                                           // A⌿B
    9024 => expandFirst(a, b, env),                                                             // A⍀B
    _    => nyi("dyadic " + lexerText(cp)),
  }
};
// equality of two elements of possibly different kinds (chars never equal numbers)
func elemEq(ka: @, x: @, kb: @, y: @) -> Bool {
  if (ka == 4) != (kb == 4) { false }
  else if ka == 4 { x == y }
  else {
    let k = array.maxk(ka, kb);
    eqK(k, promoteElem(ka, x, k), promoteElem(kb, y, k))
  }
};
func promoteElem(from: @, x: @, to: @) -> @ {
  if from == to { x } else if to == 3 { if from == 1 { array.natToReal(x) } else { array.intToReal(x) } } else { x }
};
func findIn(ka: @, xs: List<@>, kb: @, y: @, i: @) -> @ {
  match xs { (x, rest) => if elemEq(ka, x, kb, y) { i } else { findIn(ka, rest, kb, y, i + 1) }, _ => i, }
};
func indexOf(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(a) != 1 { fail("%rank-error", "the left argument of ⍳ is a vector") }
  else {
    let xs = array.vals(a);
    okv(mk(1, array.shape(b), indexAll(a.kind, xs, b.kind, array.vals(b), env.io)), env)
  }
};
func indexAll(ka: @, xs: List<@>, kb: @, ys: List<@>, io: @) -> List<@> {
  match ys { (y, rest) => (findIn(ka, xs, kb, y, 0) + io, indexAll(ka, xs, kb, rest, io)), _ => ~, }
};
func member(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ys = array.vals(b);
  okv(mk(1, array.shape(a), memberAll(a.kind, array.vals(a), b.kind, ys, array.count(ys))), env)
};
func memberAll(ka: @, xs: List<@>, kb: @, ys: List<@>, n: @) -> List<@> {
  match xs { (x, rest) => (if findIn(kb, ys, ka, x, 0) < n { 1 } else { 0 }, memberAll(ka, rest, kb, ys, n)), _ => ~, }
};
func findA(xs: List<array.Arr>, y: array.Arr, i: @) -> @ {
  match xs { (x, rest) => if matchArr(x, y) { i } else { findA(rest, y, i + 1) }, _ => i, }
};
func indexOfA(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(a) != 1 { fail("%rank-error", "the left argument of ⍳ is a vector") }
  else { okv(mk(1, array.shape(b), indexAllA(array.itemsOf(a), array.itemsOf(b), env.io)), env) }
};
func indexAllA(xs: List<array.Arr>, ys: List<array.Arr>, io: @) -> List<@> {
  match ys { (y, rest) => (findA(xs, y, 0) + io, indexAllA(xs, rest, io)), _ => ~, }
};
func memberA(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ys = array.itemsOf(b);
  okv(mk(1, array.shape(a), memberAllA(array.itemsOf(a), ys, array.countA(ys))), env)
};
func memberAllA(xs: List<array.Arr>, ys: List<array.Arr>, n: @) -> List<@> {
  match xs { (x, rest) => (if findA(ys, x, 0) < n { 1 } else { 0 }, memberAllA(rest, ys, n)), _ => ~, }
};
func reshape(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, shp) => if not ok { dom("the left argument of ⍴ is a vector of non-negative integers") }
    else {
      let n = array.size(shp);
      let vs = array.vals(b);
      let len = array.count(vs);
      if n == 0 { okv(mk(b.kind, shp, ~), env) }
      else if len == 0 { okv(mk(b.kind, shp, array.repL(array.fillOf(b.kind), n)), env) }
      else { okv(mk(b.kind, shp, array.cycleL(vs, n, 0, len)), env) }
    },
  }
};
func joinKind(a: array.Arr, b: array.Arr) -> @ { array.maxk(a.kind, b.kind) };
// the width two arrays join at:  the wider real's, or 6 (D-15)
func joinW(a: array.Arr, b: array.Arr) -> @ { array.realWA([a, b], 0) };
func catenate(a0: array.Arr, b0: array.Arr, env: Env) -> Ev {
  if array.isBox(a0) or array.isBox(b0) or ((a0.kind == 4) != (b0.kind == 4)) { catenateA(a0, b0, env) }
  else {
    let k = joinKind(a0, b0);
    let a = array.promoteAt(a0, k, joinW(a0, b0));
    let b = array.promoteAt(b0, k, joinW(a0, b0));
    let ra = array.rank(a);
    let rb = array.rank(b);
    if ra <= 1 and rb <= 1 { okv(vec(k, array.catL(array.vals(a), array.vals(b))), env) }
    else if ra == 2 and rb == 2 {
      if array.firstDim(array.shape(a)) != array.firstDim(array.shape(b)) { fail("%length-error", "rows differ") }
      else {
        let ca = array.lastDim(array.shape(a));
        let cb = array.lastDim(array.shape(b));
        let rows = catRows(array.chunks(array.vals(a), ca), array.chunks(array.vals(b), cb));
        okv(mk(k, [array.firstDim(array.shape(a)), ca + cb], array.flatten(rows)), env)
      }
    }
    else if ra == 2 and rb <= 1 { catColumn(a, b, true, k, env) }
    else if rb == 2 and ra <= 1 { catColumn(b, a, false, k, env) }
    else { catenateAxis(a, b, array.maxk(ra, rb) - 1, env) }
  }
};
// elements catenated (D-72): the two index rays, A's numbered first, move
// through the simple catenate and gather from the joined element list
func catenateA(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ia = array.itemsOf(a);
  let ib = array.itemsOf(b);
  let na = array.countA(ia);
  let nb = array.countA(ib);
  let ra = mk(1, array.shape(a), array.iotaL(na, 1));
  let rb = mk(1, array.shape(b), array.iotaL(nb, na + 1));
  match catenate(ra, rb, env) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (v, env2) => okv(array.regather(array.boxOf([na + nb], array.catA(ia, ib)), v), env2), },
  }
};
func catRows(xs: List<List<@>>, ys: List<List<@>>) -> List<List<@>> {
  match xs { (r, rest) => match ys { (r2, rest2) => (array.catL(r, r2), catRows(rest, rest2)), _ => ~, }, _ => ~, }
};
// a matrix m and a scalar or vector v joined along the last axis;  v after m when `after`
func catColumn(m: array.Arr, v: array.Arr, after: Bool, k: @, env: Env) -> Ev {
  let nrows = array.firstDim(array.shape(m));
  let ncols = array.lastDim(array.shape(m));
  let vs = array.vals(v);
  let col = if array.rank(v) == 0 { array.repL(array.first(v), nrows) } else { vs };
  if array.count(col) != nrows { fail("%length-error", "a vector joins a matrix along its rows") }
  else {
    let rows = array.chunks(array.vals(m), ncols);
    let joined = if after { catRows(rows, array.singles(col)) } else { catRows(array.singles(col), rows) };
    okv(mk(k, [nrows, ncols + 1], array.flatten(joined)), env)
  }
};
func rotateL(xs: List<@>, by: @) -> List<@> { array.catL(array.dropL(xs, by), array.takeL(xs, by)) };
func rotate(a: array.Arr, b: array.Arr, first: Bool, env: Env) -> Ev {
  if array.rank(b) == 0 { if array.size(array.shape(a)) == 1 { okv(b, env) } else { fail("%rank-error", "a scalar rotates by a scalar") } }
  else { rotateAxis(a, b, if first { 0 } else { array.rank(b) - 1 }, env) }
};
func rotRows(rows: List<List<@>>, by: @) -> List<List<@>> { match rows { (r, rest) => (rotateL(r, by), rotRows(rest, by)), _ => ~, } };
func rotLL(rows: List<List<@>>, by: @) -> List<List<@>> {
  if by == 0 { rows } else { match rows { (r, rest) => rotLL(array.catLL(rest, [r]), by - 1), _ => ~, } }
};
func takeDrop(a: array.Arr, b0: array.Arr, take: Bool, env: Env) -> Ev {
  match intArg(a) {
    (ok, neg, mag) => if not ok or array.rank(b0) > 1 { takeDropN(a, b0, take, env) }
    else {
      let b = if array.rank(b0) == 0 { vec(b0.kind, [array.first(b0)]) } else { b0 };
      let vs = array.vals(b);
      let n = array.count(vs);
      if take {
        if neg {
          if mag <= n { okv(vec(b.kind, array.dropL(vs, n - mag)), env) }
          else { okv(vec(b.kind, array.catL(array.repL(array.fillOf(b.kind), mag - n), vs)), env) }
        } else {
          if mag <= n { okv(vec(b.kind, array.takeL(vs, mag)), env) }
          else { okv(vec(b.kind, array.catL(vs, array.repL(array.fillOf(b.kind), mag - n))), env) }
        }
      } else {
        if mag >= n { okv(vec(b.kind, ~), env) }
        else if neg { okv(vec(b.kind, array.takeL(vs, n - mag)), env) }
        else { okv(vec(b.kind, array.dropL(vs, mag)), env) }
      }
    },
  }
};
// one count per leading axis (D-83): the result cell at ix reads the source at ix shifted, or a fill
func takeDropN(a: array.Arr, b0: array.Arr, take: Bool, env: Env) -> Ev {
  match intCounts(a) {
    (ok, cs) => if not ok or array.rank(a) > 1 { dom("the left argument of ↑ and ↓ is an integer vector") }
    else {
      let nc = countPairs(cs);
      let b1 = if array.rank(b0) == 0 { rebox(b0, mk(unbox(b0).kind, array.repL(1, nc), array.vals(unbox(b0)))) } else { b0 };
      let b = unbox(b1);
      let shp = array.shape(b);
      if nc > array.rank(b) { fail("%rank-error", "more counts than axes") }
      else {
        let full = catC(cs, if take { natSigned(array.dropL(shp, nc)) } else { natSigned(array.repL(0, array.rank(b) - nc)) });
        let shp2 = if take { takeShape(full, shp) } else { dropShape(full, shp) };
        let n = array.size(shp2);
        let fill = if array.isBox(b1) { 0 } else { array.fillOf(b.kind) };
        okv(rebox(b1, mk(b.kind, shp2, takeCells(full, shp, shp2, array.vals(b), take, fill, 0, n))), env)
      }
    },
  }
};
func catC(a: List<(Bool, @)>, b: List<(Bool, @)>) -> List<(Bool, @)> { match a { (h, t) => (h, catC(t, b)), _ => b, } };
func takeShape(cs: List<(Bool, @)>, shp: List<@>) -> List<@> { match cs { ((neg, m), t) => (m, takeShape(t, array.dropL(shp, 1))), _ => ~, } };
func dropShape(cs: List<(Bool, @)>, shp: List<@>) -> List<@> {
  match cs { ((neg, m), t) => match shp { (d, ds) => (if m >= d { 0 } else { d - m }, dropShape(t, ds)), _ => ~, }, _ => ~, }
};
func takeCells(cs: List<(Bool, @)>, shp: List<@>, shp2: List<@>, vs: List<@>, take: Bool, fill: @, p: @, n: @) -> List<@> {
  if p == n { ~ } else {
    match sourceIx(cs, shp, array.unflatIx(shp2, p), take, ~) {
      (inside, ix) => (if inside { array.nth(vs, array.flatIx(shp, ix)) } else { fill }, takeCells(cs, shp, shp2, vs, take, fill, p + 1, n)),
    }
  }
};
// the source index of a result index, axis by axis: (in range, index)
func sourceIx(cs: List<(Bool, @)>, shp: List<@>, ix: List<@>, take: Bool, acc: List<@>) -> (Bool, List<@>) {
  match cs {
    ((neg, m), ct) => match shp { (d, ds) => match ix { (i, it) => {
      let r = if take { if neg { if m > d { if i < (m - d) { (false, 0) } else { (true, i - (m - d)) } } else { (true, i + (d - m)) } } else { if i < d { (true, i) } else { (false, 0) } } }
              else { if neg { (true, i) } else { (true, i + m) } };
      match r { (ok, j) => if ok { sourceIx(ct, ds, it, take, (j, acc)) } else { (false, ~) }, }
    }, _ => (true, array.revL(acc, ~)), }, _ => (true, array.revL(acc, ~)), },
    _ => (true, array.revL(acc, ~)),
  }
};
// A/B along the last axis:  counts in A, one per column of B, or a scalar for every column
func compress(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, counts0) => if not ok { dom("the left argument of / is a vector of non-negative integers") }
    else if array.rank(b) > 2 { repAxis(a, b, array.rank(b) - 1, false, env) }
    else {
      let ncols = if array.rank(b) == 0 { 1 } else { array.lastDim(array.shape(b)) };
      let counts = if array.rank(a) == 0 { array.repL(array.first(a), ncols) } else { counts0 };
      let bvs = if array.rank(b) == 0 and array.count(counts) > 1 { array.repL(array.first(b), array.count(counts)) } else { array.vals(b) };
      let width = if array.rank(b) == 0 { array.count(counts) } else { ncols };
      if array.count(counts) != width { fail("%length-error", "the counts and the last axis differ") }
      else {
        let rows = array.chunks(bvs, width);
        let out = array.flatten(repRows(rows, counts));
        let total = sumL(counts);
        if array.rank(b) == 2 { okv(mk(b.kind, [array.firstDim(array.shape(b)), total], out), env) } else { okv(vec(b.kind, out), env) }
      }
    },
  }
};
func sumL(xs: List<@>) -> @ { match xs { (h, t) => h + sumL(t), _ => 0, } };
func repRows(rows: List<List<@>>, counts: List<@>) -> List<List<@>> { match rows { (r, rest) => (repRow(r, counts), repRows(rest, counts)), _ => ~, } };
func repRow(r: List<@>, counts: List<@>) -> List<@> {
  match r { (x, xs) => match counts { (c, cs) => array.catL(array.repL(x, c), repRow(xs, cs)), _ => ~, }, _ => ~, }
};
// A\B along the last axis:  a 0 in A inserts a fill, a count n takes the next element n times
func expand(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, counts) => if not ok { dom("the left argument of \\ is a vector of non-negative integers") }
    else if array.rank(b) > 2 { repAxis(a, b, array.rank(b) - 1, true, env) }
    else {
      let need = countNonzero(counts);
      let ncols = if array.rank(b) == 0 { 1 } else { array.lastDim(array.shape(b)) };
      let bvs = if array.rank(b) == 0 and need > 1 { array.repL(array.first(b), need) } else { array.vals(b) };
      let width = if array.rank(b) == 0 { need } else { ncols };
      if need != width { fail("%length-error", "the nonzero counts and the last axis differ") }
      else {
        let rows = array.chunks(bvs, width);
        let out = array.flatten(expRows(rows, counts, array.fillOf(b.kind)));
        let total = sumL(counts) + (array.count(counts) - need);
        if array.rank(b) == 2 { okv(mk(b.kind, [array.firstDim(array.shape(b)), total], out), env) } else { okv(vec(b.kind, out), env) }
      }
    },
  }
};
func countNonzero(xs: List<@>) -> @ { match xs { (h, t) => (if h == 0 { 0 } else { 1 }) + countNonzero(t), _ => 0, } };
func expRows(rows: List<List<@>>, counts: List<@>, fill: @) -> List<List<@>> {
  match rows { (r, rest) => (expRow(r, counts, fill), expRows(rest, counts, fill)), _ => ~, }
};
func expRow(r: List<@>, counts: List<@>, fill: @) -> List<@> {
  match counts {
    (c, cs) => if c == 0 { (fill, expRow(r, cs, fill)) } else { match r { (x, xs) => array.catL(array.repL(x, c), expRow(xs, cs, fill)), _ => ~, } },
    _ => ~,
  }
};
func decode(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(b) > 1 { nyi("⊥ on rank 2 and above") }
  else if a.kind != 1 or b.kind != 1 { decodeAny(a, b, env) }
  else {
    let bs = array.vals(b);
    let n = array.count(bs);
    let radix = if array.size(array.shape(a)) == 1 { array.repL(array.first(a), n) } else { array.vals(a) };
    if array.count(radix) != n { fail("%length-error", "radix and digits differ") }
    else { okv(sc(1, decodeL(radix, bs, 0)), env) }
  }
};
// Horner:  acc = acc * radix_i + digit_i, left to right
func decodeL(radix: List<@>, ds: List<@>, acc: @) -> @ {
  match ds { (d, rest) => match radix { (r, rrest) => decodeL(rrest, rest, acc * r + d), _ => acc, }, _ => acc, }
};
func encode(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if a.kind != 1 or b.kind != 1 or array.size(array.shape(b)) != 1 or array.rank(b) > 1 { encodeAny(a, b, env) }
  else { okv(vec(1, array.revL(encodeL(array.revL(array.vals(a), ~), array.first(b)), ~)), env) }
};
// radix from the last digit backwards
func encodeL(radixRev: List<@>, x: @) -> List<@> {
  match radixRev { (r, rest) => if r == 0 { (x, encodeL(rest, 0)) } else { (x % r, encodeL(rest, x / r)) }, _ => ~, }
};

// ⊥ with integers or reals (D-86): Horner over scalar arrays, the radix extended
func decodeAny(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if a.kind == 4 or b.kind == 4 or array.isBox(a) or array.isBox(b) { dom("⊥ takes numbers") }
  else {
    let ds = array.itemsOf(b);
    let n = array.countA(ds);
    let rs = if array.size(array.shape(a)) == 1 { repA(array.firstItem(a), n) } else { array.itemsOf(a) };
    if array.countA(rs) != n { fail("%length-error", "radix and digits differ") }
    else { horner(rs, ds, sc(1, 0), env) }
  }
};
func horner(rs: List<array.Arr>, ds: List<array.Arr>, acc: array.Arr, env: Env) -> Ev {
  match ds {
    (d, dt) => match rs { (r, rt) => match dyadPrim(215, acc, r, env) {
      .err(e) => Ev.err(e),
      .ok(p) => match p { (m, env2) => match dyadPrim(43, m, d, env2) { .err(e) => Ev.err(e), .ok(q) => match q { (v, env3) => horner(rt, dt, v, env3), }, }, },
    }, _ => okv(acc, env), },
    _ => okv(acc, env),
  }
};
// ⊤ with integers or reals, or a vector right argument (D-86): floor and residue, the last radix first
func encodeAny(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if a.kind == 4 or b.kind == 4 or array.isBox(a) or array.isBox(b) { dom("⊤ takes numbers") }
  else if array.rank(a) > 1 or array.rank(b) > 1 { nyi("⊤ on rank 2 and above") }
  else {
    let rs = array.revA(array.itemsOf(a), ~);
    let na = array.countA(rs);
    match encodeAll(rs, array.itemsOf(b), env, ~) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (cols, env2) =>
        if array.rank(b) == 0 { okv(array.normalize([na], match cols { (c, t) => c, _ => ~, }), env2) }
        else { okv(array.normalize([na, array.size(array.shape(b))], rowsOfCols(cols, 0, na)), env2) }, },
    }
  }
};
func encodeAll(rs: List<array.Arr>, xs: List<array.Arr>, env: Env, acc: List<List<array.Arr>>) -> EncR {
  match xs {
    (x, xt) => match encDigits(rs, x, env, ~) { .err(e) => EncR.err(e), .ok(r) => match r { (ds, env2) => encodeAll(rs, xt, env2, (ds, acc)), }, },
    _ => EncR.ok((revAA(acc, ~), env)),
  }
};
func revAA(xs: List<List<array.Arr>>, acc: List<List<array.Arr>>) -> List<List<array.Arr>> { match xs { (h, t) => revAA(t, (h, acc)), _ => acc, } };
// the digits of x for the reversed radix, built last digit first so they come out in order
func encDigits(rs: List<array.Arr>, x: array.Arr, env: Env, acc: List<array.Arr>) -> Evs {
  match rs {
    (r, rt) => if matchArr(r, sc(1, 0)) { encDigits(rt, sc(1, 0), env, (x, acc)) }
      else { match dyadPrim(8739, r, x, env) {
        .err(e) => Evs.err(e),
        .ok(p) => match p { (d, env2) => match dyadPrim(8722, x, d, env2) {
          .err(e) => Evs.err(e),
          .ok(q) => match q { (diff, env3) => match dyadPrim(247, diff, r, env3) {
            .err(e) => Evs.err(e),
            .ok(u) => match u { (quot, env4) => match monadPrim(8970, quot, env4) {
              .err(e) => Evs.err(e),
              .ok(w) => match w { (x2, env5) => encDigits(rt, x2, env5, (d, acc)), },
            }, },
          }, },
        }, },
      } },
    _ => Evs.ok((acc, env)),
  }
};
func rowsOfCols(cols: List<List<array.Arr>>, i: @, na: @) -> List<array.Arr> {
  if i == na { ~ } else { array.catA(colA(cols, i), rowsOfCols(cols, i + 1, na)) }
};
// --- nesting, the rest (D-78..D-80) --------------------------------------------------------------
func tally(a: array.Arr) -> @ { if array.rank(a) == 0 { 1 } else { array.firstDim(array.shape(a)) } };
// A⊂B: a new element where the count rises, a 0 drops the element
func partition(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(b) > 1 { partitionAxis(a, b, array.rank(b) - 1, env) } else { partitionVec(a, b, env) }
};
// A⊂[k]B past rank 1 (D-78): every line along axis k partitioned by the same counts, so the
// result has B's shape with axis k replaced by the number of groups, each element a vector
func partitionAxis(a: array.Arr, b: array.Arr, k: @, env: Env) -> Ev {
  match natVec(a) {
    (ok, cs0) => if not ok { dom("the left argument of ⊂ is a vector of non-negative integers") }
    else {
      let shp = array.shape(b);
      let n = array.nth(shp, k);
      let cs = if array.rank(a) == 0 { array.repL(array.first(a), n) } else { cs0 };
      if array.count(cs) != n { fail("%length-error", "one count per element along the axis") }
      else {
        let g = countStarts(cs, 0);
        let lines = axisLines(shp, k);
        let groups = partLines(cs, b, lines);
        let shp2 = setNth(shp, k, g);
        let numbered = numberLines(array.countLL(lines), g, 1);
        okv(array.regather(array.boxOf([array.countA(groups)], groups), mk(1, shp2, fromLines(shp2, k, numbered))), env)
      }
    },
  }
};
// the groups the counts open: a count above the one before it, after a 0 or at the start
func countStarts(cs: List<@>, prev: @) -> @ { match cs { (c, t) => (if c != 0 and c > prev { 1 } else { 0 }) + countStarts(t, c), _ => 0, } };
func partLines(cs: List<@>, b: array.Arr, lines: List<List<@>>) -> List<array.Arr> {
  match lines { (l, rest) => array.catA(partGroups(cs, lineItems(b, l), 0, ~, ~), partLines(cs, b, rest)), _ => ~, }
};
// line i's groups are numbered from i*g+1
func numberLines(nl: @, g: @, from: @) -> List<List<@>> { if nl == 0 { ~ } else { (array.iotaL(g, from), numberLines(nl - 1, g, from + g)) } };
func partitionVec(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, cs0) => if not ok { dom("the left argument of ⊂ is a vector of non-negative integers") }
    else {
      let xs = array.itemsOf(b);
      let n = array.countA(xs);
      let cs = if array.rank(a) == 0 { array.repL(array.first(a), n) } else { cs0 };
      if array.count(cs) != n { fail("%length-error", "one count per element") }
      else { let gs = partGroups(cs, xs, 0, ~, ~); okv(array.normalize([array.countA(gs)], gs), env) }
    },
  }
};
// prev: the count before; cur: the open group's elements reversed; acc: the finished groups reversed
func partGroups(cs: List<@>, xs: List<array.Arr>, prev: @, cur: List<array.Arr>, acc: List<array.Arr>) -> List<array.Arr> {
  match cs {
    (c, ct) => match xs { (x, xt) =>
      if c == 0 { partGroups(ct, xt, 0, ~, closeGroup(cur, acc)) }
      else if c > prev { partGroups(ct, xt, c, [x], closeGroup(cur, acc)) }
      else { partGroups(ct, xt, c, (x, cur), acc) }, _ => array.revA(closeGroup(cur, acc), ~), },
    _ => array.revA(closeGroup(cur, acc), ~),
  }
};
func closeGroup(cur: List<array.Arr>, acc: List<array.Arr>) -> List<array.Arr> {
  match cur { (h, t) => { let g = array.revA(cur, ~); (array.normalize([array.countA(g)], g), acc) }, _ => acc, }
};
// ⍪B: a matrix of the first axis by the rest
func table(a: array.Arr) -> array.Arr {
  let x = unbox(a);
  let shp = array.shape(x);
  let shp2 = if array.rank(x) == 0 { [1, 1] } else if array.rank(x) == 1 { [array.firstDim(shp), 1] } else { [array.firstDim(shp), array.size(shp) / array.firstDim(shp)] };
  rebox(a, mk(x.kind, shp2, array.vals(x)))
};
// A⍪B: on the first axis; vectors and scalars as rows
func tableCat(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(a) <= 1 and array.rank(b) <= 1 {
    let n = array.maxk(array.size(array.shape(a)), array.size(array.shape(b)));
    let la = if array.rank(a) == 0 { n } else { array.size(array.shape(a)) };
    let lb = if array.rank(b) == 0 { n } else { array.size(array.shape(b)) };
    if la != lb { fail("%length-error", "the rows differ in length") } else { catenateAxis(asRow(a, n), asRow(b, n), 0, env) }
  } else { catenateAxis(a, b, 0, env) }
};
func asRow(x: array.Arr, n: @) -> array.Arr {
  if array.rank(x) == 0 { array.spread(x, [1, n]) } else { rebox(x, mk(unbox(x).kind, [1, n], array.vals(unbox(x)))) }
};
// A⍉B (D-85): result axis j is every axis of B that A maps to it; a repeat is the diagonal
func transposeBy(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, axes0) => if not ok { dom("the left argument of ⍉ is a vector of axes") }
    else {
      let axes = shiftIo(if array.rank(a) == 0 { array.repL(array.first(a), array.rank(b)) } else { axes0 }, env.io);
      let shp = array.shape(b);
      if array.count(axes) != array.rank(b) { fail("%length-error", "one axis per axis of the right argument") }
      else if not array.allL(axes, lambda (j: @) -> Bool { j < 4294967295 }) { fail("%axis-error", "an axis below ⎕IO") }
      else {
        let r = if array.rank(b) == 0 { 0 } else { 1 + maxL(axes, 0) };
        if not coversAll(axes, 0, r) { dom("every result axis must be named") }
        else {
          let shp2 = minShape(axes, shp, 0, r);
          let x = unbox(b);
          okv(rebox(b, mk(x.kind, shp2, transposeCells(axes, shp, shp2, array.vals(x), 0, array.size(shp2)))), env)
        }
      }
    },
  }
};
func maxL(xs: List<@>, m: @) -> @ { match xs { (h, t) => maxL(t, array.maxk(m, h)), _ => m, } };
func coversAll(axes: List<@>, j: @, r: @) -> Bool { if j == r { true } else if array.anyL(axes, lambda (x: @) -> Bool { x == j }) { coversAll(axes, j + 1, r) } else { false } };
func minShape(axes: List<@>, shp: List<@>, j: @, r: @) -> List<@> { if j == r { ~ } else { (minOver(axes, shp, j, 4294967295), minShape(axes, shp, j + 1, r)) } };
func minOver(axes: List<@>, shp: List<@>, j: @, m: @) -> @ {
  match axes { (x, xt) => match shp { (d, dt) => minOver(xt, dt, j, if x == j and d < m { d } else { m }), _ => m, }, _ => m, }
};
func transposeCells(axes: List<@>, shp: List<@>, shp2: List<@>, vs: List<@>, p: @, n: @) -> List<@> {
  if p == n { ~ } else {
    let ix2 = array.unflatIx(shp2, p);
    (array.nth(vs, array.flatIx(shp, pickAxes(axes, ix2))), transposeCells(axes, shp, shp2, vs, p + 1, n))
  }
};
// A⍷B (D-87): 1 where a copy of A begins, both as matrices
func pickAxes(axes: List<@>, ix2: List<@>) -> List<@> { match axes { (x, t) => (array.nth(ix2, x), pickAxes(t, ix2)), _ => ~, } };
func find(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.rank(a) > array.rank(b) { fail("%rank-error", "the pattern outranks the array") }
  else if array.rank(b) > 2 {
    let sb = array.shape(b);
    let sa = array.catL(array.repL(1, array.rank(b) - array.rank(a)), array.shape(a));
    okv(mk(1, sb, findN(array.itemsOf(a), sa, array.size(sa), array.itemsOf(b), sb, 0, array.size(sb))), env)
  }
  else {
    let ia = array.itemsOf(a);
    let ib = array.itemsOf(b);
    match matDims(a) { (pr, pc) => match matDims(b) { (br, bc) =>
      okv(mk(1, array.shape(b), findCells(ia, pr, pc, ib, br, bc, 0, br * bc)), env), }, }
  }
};
// ⍷ at any rank (D-87): position p of B begins a copy of A when A fits there and every cell matches
func findN(ia: List<array.Arr>, sa: List<@>, na: @, ib: List<array.Arr>, sb: List<@>, p: @, n: @) -> List<@> {
  if p == n { ~ } else {
    let ix = array.unflatIx(sb, p);
    (b2n(fitsAt(ix, sa, sb) and findAtN(ia, sa, ib, sb, ix, 0, na)), findN(ia, sa, na, ib, sb, p + 1, n))
  }
};
func fitsAt(ix: List<@>, sa: List<@>, sb: List<@>) -> Bool {
  match ix { (i, it) => match sa { (d, st) => match sb { (e, et) => i + d <= e and fitsAt(it, st, et), _ => false, }, _ => false, }, _ => true, }
};
func addIx(xs: List<@>, ys: List<@>) -> List<@> { match xs { (x, xt) => match ys { (y, yt) => (x + y, addIx(xt, yt)), _ => ~, }, _ => ~, } };
func findAtN(ia: List<array.Arr>, sa: List<@>, ib: List<array.Arr>, sb: List<@>, ix: List<@>, q: @, m: @) -> Bool {
  if q == m { true } else {
    if matchArr(array.nthA(ia, q), array.nthA(ib, array.flatIx(sb, addIx(ix, array.unflatIx(sa, q))))) { findAtN(ia, sa, ib, sb, ix, q + 1, m) } else { false }
  }
};
func matDims(a: array.Arr) -> (@, @) {
  match array.rank(a) { 0 => (1, 1), 1 => (1, array.firstDim(array.shape(a))), _ => (array.firstDim(array.shape(a)), array.lastDim(array.shape(a))), }
};
func findCells(ia: List<array.Arr>, pr: @, pc: @, ib: List<array.Arr>, br: @, bc: @, p: @, n: @) -> List<@> {
  if p == n { ~ } else {
    let i = p / bc;
    let j = p % bc;
    let hit = i + pr <= br and j + pc <= bc and findAt(ia, pr, pc, ib, bc, i, j, 0, pr * pc);
    (b2n(hit), findCells(ia, pr, pc, ib, br, bc, p + 1, n))
  }
};
func findAt(ia: List<array.Arr>, pr: @, pc: @, ib: List<array.Arr>, bc: @, i: @, j: @, q: @, m: @) -> Bool {
  if q == m { true } else {
    let di = q / pc;
    let dj = q % pc;
    if matchArr(array.nthA(ia, q), array.nthA(ib, (i + di) * bc + (j + dj))) { findAt(ia, pr, pc, ib, bc, i, j, q + 1, m) } else { false }
  }
};
// --- format (D-88) ------------------------------------------------------------------------------
func toUni(cs: List<@>) -> List<UniChar> { match cs { (c, t) => (c as! UniChar, toUni(t)), _ => ~, } };
func splitNl(cs: List<@>, cur: List<@>, acc: List<List<@>>) -> List<List<@>> {
  match cs { (c, t) => if c == 10 { splitNl(t, ~, (array.revL(cur, ~), acc)) } else { splitNl(t, (c, cur), acc) }, _ => revLL((array.revL(cur, ~), acc), ~), }
};
func maxLenL(xss: List<List<@>>, m: @) -> @ { match xss { (h, t) => maxLenL(t, array.maxk(m, array.count(h))), _ => m, } };
func padRows(xss: List<List<@>>, w: @) -> List<List<@>> { match xss { (h, t) => (array.catL(h, array.repL(32, w - array.count(h))), padRows(t, w)), _ => ~, } };
// a display text as a character array: one row per line
func charsOf(text: String) -> array.Arr {
  let rows = splitNl(cps(text), ~, ~);
  match rows {
    (r, rest) => match rest { (r2, rest2) => { let w = maxLenL(rows, 0); mk(4, [array.countLL(rows), w], array.flatten(padRows(rows, w))) }, _ => vec(4, r), },
    _ => vec(4, ~),
  }
};
func formatArr(a: array.Arr, env: Env) -> Ev {
  if a.kind == 4 { okv(a, env) }
  else if array.rank(a) > 2 {
    let rows = dropBlank(splitNl(cps(array.format(a, env.pp)), ~, ~));
    let lead = array.takeL(array.shape(a), array.rank(a) - 1);
    if array.countLL(rows) != array.size(lead) { nyi("⍕ of this array past rank 2") }
    else { let w = maxLenL(rows, 0); okv(mk(4, array.catL(lead, [w]), array.flatten(padRows(rows, w))), env) }
  }
  else { okv(charsOf(array.format(a, env.pp)), env) }
};
func rankUp(m: array.Arr, b: array.Arr) -> array.Arr { if array.rank(b) > 2 { charsRank(m, array.shape(b)) } else { m } };
// the rows of a display without the blank lines that part its planes
func dropBlank(rows: List<List<@>>) -> List<List<@>> { match rows { (r, t) => match r { (c, ct) => (r, dropBlank(t)), _ => dropBlank(t), }, _ => ~, } };
// a character matrix of rows, as an array of B's leading axes by the text width (⍕ past rank 2)
func charsRank(m: array.Arr, shp: List<@>) -> array.Arr {
  let w = if array.rank(m) == 2 { array.lastDim(array.shape(m)) } else { array.size(array.shape(m)) };
  mk(4, array.catL(array.takeL(shp, array.count(shp) - 1), [w]), array.vals(m))
};
// ⌊x+0.5 as a natural, at x's width (D-15)
func roundNat(x: @) -> @ { let half = array.rop(4, array.oneLike(x), array.rsunAt(array.widthOf(x), 2)); lagoon.tabs(array.sToInt(array.rtoi(100, array.rop(1, x, half)))) };
func fracText(frac: @, d: @) -> String { if d == 0 { "" } else { "." + array.zeros(d - array.ndigits(frac)) + array.fmtNat(frac) } };
// a number in fixed point with d decimals
func fmtFixed(k: @, x: @, d: @) -> String {
  match k {
    1 => array.fmtNat(x) + fracText(0, d),
    2 => (if array.isNeg(x) { "¯" } else { "" }) + array.fmtNat(lagoon.tabs(x)) + fracText(0, d),
    _ => {
      let neg = array.realIsNeg(x);
      let mag = if neg { negR(x) } else { x };
      let scaled = roundNat(array.rop(3, mag, array.rsunAt(array.widthOf(mag), array.pow10(d))));
      let p = array.pow10(d);
      (if neg { "¯" } else { "" }) + array.fmtNat(scaled / p) + fracText(scaled % p, d)
    },
  }
};
func fmtFixedAll(k: @, xs: List<@>, d: @) -> List<String> { match xs { (h, t) => (fmtFixed(k, h, d), fmtFixedAll(k, t, d)), _ => ~, } };
func fitWidth(cells: List<String>, w: @) -> (Bool, List<String>) {
  match cells {
    (c, t) => if array.strLen(c) > w { (false, ~) } else { match fitWidth(t, w) { (ok, rest) => (ok, (array.spaces(w - array.strLen(c)) + c, rest)), } },
    _ => (true, ~),
  }
};
func formatBy(a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match natVec(a) {
    (ok, spec) => if not ok or array.count(spec) > 2 or array.count(spec) == 0 { dom("the left argument of ⍕ is D or W D") }
    else if b.kind == 4 or array.isBox(b) { dom("⍕ with a left argument formats numbers") }
    else {
      let d = array.lastL(spec);
      let cells = fmtFixedAll(b.kind, array.vals(b), d);
      let cols = if array.rank(b) >= 2 { array.lastDim(array.shape(b)) } else { countS(cells) };
      let rows = array.chunk(cells, cols);
      if array.count(spec) == 2 {
        match fitWidth(cells, array.firstDim(spec)) {
          (fits, padded) => if not fits { dom("a number does not fit the width") }
            else { okv(rankUp(charsOf(array.joinS(array.fmtRows(array.chunk(padded, cols), ~, ""), "\n")), b), env) },
        }
      } else { okv(rankUp(charsOf(array.joinS(array.fmtRows(rows, array.widths(rows, ~), " "), "\n")), b), env) }
    },
  }
};
// --- execute (D-89) -----------------------------------------------------------------------------
func execute(a: array.Arr, env: Env) -> Ev {
  if a.kind != 4 or array.rank(a) > 1 { dom("⍎ takes a character vector") }
  else {
    match parse.parseLine(utf8(toUni(array.vals(a))), sigOf(env)) {
      .err(e) => fail(e.tag, "col:{e.col} " + e.hint),
      .ok(t) => execAst(t, env),
    }
  }
};
func execAst(t: parse.Ast, env: Env) -> Ev {
  match t {
    .stmts(ss) => execStmts(ss, env),
    .empty => dom("the executed line has no value"),
    .elide => dom("the executed line has no value"),
    .fnend => dom("the executed line has no value"),
    .cmd(c) => dom("the executed line has no value"),
    .header(h) => dom("the executed line has no value"),
    .fassign(s) => dom("the executed line has no value"),
    .guard(g) => dom("the executed line has no value"),
    .eguard(g) => dom("the executed line has no value"),
    _ => evalAst(t, env),
  }
};
// the statements before the last run as the session would, their output kept; the last is the value
func execStmts(ss: List<parse.Ast>, env: Env) -> Ev {
  match ss {
    (h, t) => match t {
      (h2, t2) => match runStmt(h, env) { (out, env2) => execStmts(t, pushOut(env2, out)), },
      _ => execAst(h, env),
    },
    _ => dom("the executed line has no value"),
  }
};
// --- matrix divide (D-90): Gauss-Jordan with partial pivoting over reals -----------------------------
func identityOf(b: array.Arr) -> array.Arr {
  let n = array.firstDim(array.shape(b));
  mk(1, [n, n], identCells(0, n * n, n))
};
func identCells(p: @, n2: @, n: @) -> List<@> { if p == n2 { ~ } else { (if (p / n) == (p % n) { 1 } else { 0 }, identCells(p + 1, n2, n)) } };
func solve(a: array.Arr, b: array.Arr, inverse: Bool, env: Env) -> Ev {
  if a.kind == 4 or b.kind == 4 or array.isBox(a) or array.isBox(b) { dom("⌹ takes numeric arrays") }
  else if array.rank(b) != 2 or array.rank(a) > 2 { fail("%rank-error", "⌹ takes a matrix") }
  else {
    let m = array.firstDim(array.shape(b));
    let n = array.lastDim(array.shape(b));
    let p = if array.rank(a) == 2 { array.lastDim(array.shape(a)) } else { 1 };
    let ar = if array.rank(a) == 2 { array.firstDim(array.shape(a)) } else { array.size(array.shape(a)) };
    if ar != m { fail("%length-error", "the rows of the two arguments differ") }
    else if m < n { dom("⌹ needs at least as many rows as columns") }
    else {
      let brows = array.chunks(array.vals(array.toRealAt(b, env.rb)), n);
      let arows = array.chunks(array.vals(array.toRealAt(a, env.rb)), p);
      let bt = array.colsOf(brows, n, 0);
      let sq = if m == n { brows } else { mmulF(bt, array.colsOf(brows, n, 0)) };
      let rhs = if m == n { arows } else { mmulF(bt, array.colsOf(arows, p, 0)) };
      match gaussJordan(catPairs(sq, rhs), 0, n) {
        (ok, rows) => if not ok { dom("the matrix is singular") }
          else {
            let xs = array.flatten(dropCols(rows, n));
            if array.rank(a) == 1 { okv(vec(3, xs), env) } else { okv(mk(3, [n, p], xs), env) }
          },
      }
    }
  }
};
func dotF(xs: List<@>, ys: List<@>) -> @ { foldK(addK, 3, zipK(mulK, 3, xs, ys)) };
func mmulF(rows: List<List<@>>, cols: List<List<@>>) -> List<List<@>> { match rows { (r, rest) => (dotRowF(r, cols), mmulF(rest, cols)), _ => ~, } };
func dotRowF(r: List<@>, cols: List<List<@>>) -> List<@> { match cols { (c, rest) => (dotF(r, c), dotRowF(r, rest)), _ => ~, } };
func dropCols(rows: List<List<@>>, n: @) -> List<List<@>> { match rows { (r, rest) => (array.dropL(r, n), dropCols(rest, n)), _ => ~, } };
func absF(x: @) -> @ { if array.realIsNeg(x) { negR(x) } else { x } };
// the row at or below c with the largest magnitude in column c
func pivotOf(rows: List<List<@>>, c: @, i: @, best: @, bestMag: @) -> (@, @) {
  match rows {
    (r, rest) => if i < c { pivotOf(rest, c, i + 1, best, bestMag) }
      else { let mag = absF(array.nth(r, c)); if array.rcmp(3, mag, bestMag) { pivotOf(rest, c, i + 1, i, mag) } else { pivotOf(rest, c, i + 1, best, bestMag) } },
    _ => (best, bestMag),
  }
};
func swapRows(rows: List<List<@>>, i: @, j: @) -> List<List<@>> {
  let ri = nthLL(rows, i);
  let rj = nthLL(rows, j);
  setNthLL(setNthLL(rows, i, rj), j, ri)
};
func setNthLL(rows: List<List<@>>, i: @, r: List<@>) -> List<List<@>> { match rows { (h, t) => if i == 0 { (r, t) } else { (h, setNthLL(t, i - 1, r)) }, _ => ~, } };
func scaleRow(r: List<@>, by: @) -> List<@> { match r { (x, t) => (array.rop(4, x, by), scaleRow(t, by)), _ => ~, } };
func subRow(r: List<@>, pr: List<@>, f: @) -> List<@> {
  match r { (x, t) => match pr { (y, pt) => (array.rop(2, x, array.rop(3, f, y)), subRow(t, pt, f)), _ => ~, }, _ => ~, }
};
func eliminate(rows: List<List<@>>, pr: List<@>, c: @, i: @, skip: @) -> List<List<@>> {
  match rows { (r, rest) => (if i == skip { r } else { subRow(r, pr, array.nth(r, c)) }, eliminate(rest, pr, c, i + 1, skip)), _ => ~, }
};
func gaussJordan(rows: List<List<@>>, c: @, n: @) -> (Bool, List<List<@>>) {
  if c == n { (true, rows) }
  else {
    match pivotOf(rows, c, 0, c, 0) {
      (pi, mag) => if realZero(mag) { (false, rows) }
        else {
          let sw = swapRows(rows, c, pi);
          let pr = scaleRow(nthLL(sw, c), array.nth(nthLL(sw, c), c));
          gaussJordan(eliminate(setNthLL(sw, c, pr), pr, c, 0, c), c + 1, n)
        },
    }
  }
};
func compressFirst(a: array.Arr, b: array.Arr, env: Env) -> Ev { if array.rank(b) == 0 { compress(a, b, env) } else { repAxis(a, b, 0, false, env) } };
func expandFirst(a: array.Arr, b: array.Arr, env: Env) -> Ev { if array.rank(b) == 0 { expand(a, b, env) } else { repAxis(a, b, 0, true, env) } };

// --- operators (D-43) --------------------------------------------------------------------------
func identity(f: parse.Fn) -> (Bool, array.Arr) {
  match f {
    .prim(cp) => match cp {
      43 => (true, sc(1, 0)), 8722 => (true, sc(1, 0)), 215 => (true, sc(1, 1)), 247 => (true, sc(1, 1)),
      8739 => (true, sc(1, 0)), 8902 => (true, sc(1, 1)), 8744 => (true, sc(1, 0)), 8743 => (true, sc(1, 1)),
      61 => (true, sc(1, 1)), 8800 => (true, sc(1, 0)), 60 => (true, sc(1, 0)), 8804 => (true, sc(1, 1)),
      62 => (true, sc(1, 0)), 8805 => (true, sc(1, 1)), 33 => (true, sc(1, 1)),
      8968 => (true, sc(3, 18442240474082181119)), 8970 => (true, sc(3, 9218868437227405311)),
      _ => (false, sc(1, 0)),
    },
    _ => (false, sc(1, 0)),
  }
};
// f/ over one list of elements of kind k, right to left:  x1 f (x2 f (... f xn))
func reduceL(f: parse.Fn, k: @, xs: List<@>, env: Env) -> Ev {
  match array.revL(xs, ~) {
    (lst, restRev) => foldRight(f, k, restRev, sc(k, lst), env),
    _ => match identity(f) { (ok, id) => if ok { okv(id, env) } else { dom("no identity for reducing an empty array with that function") }, },
  }
};
func foldRight(f: parse.Fn, k: @, restRev: List<@>, acc: array.Arr, env: Env) -> Ev {
  match restRev {
    (x, more) => match applyDyad(f, sc(k, x), acc, env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => foldRight(f, k, more, v, env2), }, },
    _ => okv(acc, env),
  }
};
func reduce(f: parse.Fn, a: array.Arr, first: Bool, env: Env) -> Ev {
  let r = array.rank(a);
  if r == 0 { okv(a, env) } else { reduceAxis(f, a, if first { 0 } else { r - 1 }, env) }
};
func reduceEach(f: parse.Fn, k: @, groups: List<List<@>>, env: Env, acc: List<array.Arr>) -> Evs {
  match groups {
    (g, rest) => match reduceL(f, k, g, env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => reduceEach(f, k, rest, env2, (v, acc)), }, },
    _ => Evs.ok((revArrs(acc, ~), env)),
  }
};
func revArrs(xs: List<array.Arr>, acc: List<array.Arr>) -> List<array.Arr> { match xs { (h, t) => revArrs(t, (h, acc)), _ => acc, } };
// a vector from scalar results, promoted to their join kind
func maxKind(xs: List<array.Arr>, k: @) -> @ { match xs { (h, t) => maxKind(t, array.maxk(k, h.kind)), _ => k, } };
func firstVals(xs: List<array.Arr>, k: @) -> List<@> { array.firstValsA(xs, k) };
func gather(xs: List<array.Arr>) -> array.Arr { let k = maxKind(xs, 1); vec(k, firstVals(xs, k)) };
func gatherShaped(xs: List<array.Arr>, shp: List<@>) -> array.Arr { let k = maxKind(xs, 1); mk(k, shp, firstVals(xs, k)) };
// f\:  element i is f/ of the first i+1 elements
func scanL(f: parse.Fn, k: @, xs: List<@>, i: @, n: @, env: Env, acc: List<array.Arr>) -> Evs {
  if i == n { Evs.ok((revArrs(acc, ~), env)) }
  else { match reduceL(f, k, array.takeL(xs, i + 1), env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => scanL(f, k, xs, i + 1, n, env2, (v, acc)), }, } }
};
func scan(f: parse.Fn, a: array.Arr, first: Bool, env: Env) -> Ev {
  let r = array.rank(a);
  if r == 0 { okv(a, env) } else { scanAxis(f, a, if first { 0 } else { r - 1 }, env) }
};
func scanEach(f: parse.Fn, k: @, groups: List<List<@>>, env: Env, acc: List<array.Arr>) -> Evs {
  match groups {
    (g, rest) => match scanL(f, k, g, 0, array.count(g), env, ~) {
      .err(e) => Evs.err(e),
      .ok(r) => match r { (vs, env2) => scanEach(f, k, rest, env2, catArrs(revArrs(vs, ~), acc)), },
    },
    _ => Evs.ok((revArrs(acc, ~), env)),
  }
};
func catArrs(a: List<array.Arr>, b: List<array.Arr>) -> List<array.Arr> { match a { (h, t) => (h, catArrs(t, b)), _ => b, } };
// f/ and f\ over a box vector fold its elements (D-72); the reduction is enclosed
func reduceBox(f: parse.Fn, a: array.Arr, env: Env) -> Ev {
  if array.rank(a) == 0 { okv(a, env) }
  else if array.rank(a) != 1 { nyi("reduction over a nested array of rank 2 and above") }
  else { match reduceItems(f, array.itemsOf(a), env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => okv(array.enclose(v), env2), }, } }
};
func reduceItems(f: parse.Fn, xs: List<array.Arr>, env: Env) -> Ev {
  match array.revA(xs, ~) {
    (lst, restRev) => foldItems(f, restRev, lst, env),
    _ => reduceL(f, 1, ~, env),
  }
};
func foldItems(f: parse.Fn, restRev: List<array.Arr>, acc: array.Arr, env: Env) -> Ev {
  match restRev {
    (x, more) => match applyDyad(f, x, acc, env) { .err(e) => Ev.err(e), .ok(r) => match r { (v, env2) => foldItems(f, more, v, env2), }, },
    _ => okv(acc, env),
  }
};
func scanBox(f: parse.Fn, a: array.Arr, env: Env) -> Ev {
  if array.rank(a) == 0 { okv(a, env) }
  else if array.rank(a) != 1 { nyi("scan over a nested array of rank 2 and above") }
  else {
    let xs = array.itemsOf(a);
    match scanItems(f, xs, 0, array.countA(xs), env, ~) { .err(e) => Ev.err(e), .ok(r) => match r { (vs, env2) => okv(array.normalize(array.shape(a), vs), env2), }, }
  }
};
func scanItems(f: parse.Fn, xs: List<array.Arr>, i: @, n: @, env: Env, acc: List<array.Arr>) -> Evs {
  if i == n { Evs.ok((array.revA(acc, ~), env)) }
  else { match reduceItems(f, array.takeA(xs, i + 1), env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => scanItems(f, xs, i + 1, n, env2, (v, acc)), }, } }
};
// A ∘.g B:  every a against every b, shape A ++ shape B
func outer(g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.isBox(a) or array.isBox(b) { outerItems(g, a, b, env) } else { outerSimple(g, a, b, env) }
};
func outerSimple(g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let avs = array.vals(a);
  let bvs = array.vals(b);
  let na = array.count(avs);
  let nb = array.count(bvs);
  let aa = vec(a.kind, spreadEach(avs, nb));
  let bb = vec(b.kind, array.cycleL(bvs, na * nb, 0, if nb == 0 { 1 } else { nb }));
  if na * nb == 0 { okv(mk(array.maxk(a.kind, b.kind), array.catL(array.shape(a), array.shape(b)), ~), env) }
  else {
    match applyDyad(g, aa, bb, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (v, env2) => okv(mk(v.kind, array.catL(array.shape(a), array.shape(b)), array.vals(v)), env2), },
    }
  }
};
func outerItems(g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ib = array.itemsOf(b);
  match outerRows(g, array.itemsOf(a), ib, env, ~) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (vs, env2) => okv(array.normalize(array.catL(array.shape(a), array.shape(b)), vs), env2), },
  }
};
func outerRows(g: parse.Fn, xs: List<array.Arr>, ys: List<array.Arr>, env: Env, acc: List<array.Arr>) -> Evs {
  match xs {
    (x, xt) => match outerRow(g, x, ys, env, ~) { .err(e) => Evs.err(e), .ok(r) => match r { (vs, env2) => outerRows(g, xt, ys, env2, array.catA(acc, vs)), }, },
    _ => Evs.ok((acc, env)),
  }
};
func outerRow(g: parse.Fn, x: array.Arr, ys: List<array.Arr>, env: Env, acc: List<array.Arr>) -> Evs {
  match ys {
    (y, yt) => match applyDyad(g, x, y, env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => outerRow(g, x, yt, env2, (v, acc)), }, },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
// A f.g B over elements: rows of A against columns of B, g pairwise then f over the products
func innerItems(f: parse.Fn, g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ra = array.rank(a);
  let rb = array.rank(b);
  if ra > 2 or rb > 2 { nyi("inner product on rank 3 and above") }
  else {
    let ia = array.itemsOf(a);
    let ib = array.itemsOf(b);
    let arows = if ra == 2 { chunksA(ia, array.lastDim(array.shape(a))) } else { [ia] };
    let bcols = if rb == 2 { colsA(chunksA(ib, array.lastDim(array.shape(b))), array.lastDim(array.shape(b)), 0) } else { [ib] };
    match innerRowsA(f, g, arows, bcols, env, ~) {
      .err(e) => Ev.err(e),
      .ok(rs) => match rs { (vs, env2) => {
        let shp = array.catL(if ra == 2 { [array.firstDim(array.shape(a))] } else { ~ }, if rb == 2 { [array.lastDim(array.shape(b))] } else { ~ });
        okv(array.normalize(shp, vs), env2)
      }, },
    }
  }
};
func chunksA(xs: List<array.Arr>, n: @) -> List<List<array.Arr>> { match xs { (h, t) => (array.takeA(xs, n), chunksA(array.dropA(xs, n), n)), _ => ~, } };
func colA(rows: List<List<array.Arr>>, j: @) -> List<array.Arr> { match rows { (r, rest) => (array.nthA(r, j), colA(rest, j)), _ => ~, } };
func colsA(rows: List<List<array.Arr>>, ncols: @, j: @) -> List<List<array.Arr>> { if j == ncols { ~ } else { (colA(rows, j), colsA(rows, ncols, j + 1)) } };
func innerRowsA(f: parse.Fn, g: parse.Fn, arows: List<List<array.Arr>>, bcols: List<List<array.Arr>>, env: Env, acc: List<array.Arr>) -> Evs {
  match arows {
    (r, rest) => match innerRowA(f, g, r, bcols, env, ~) { .err(e) => Evs.err(e), .ok(rs) => match rs { (vs, env2) => innerRowsA(f, g, rest, bcols, env2, array.catA(acc, vs)), }, },
    _ => Evs.ok((acc, env)),
  }
};
func innerRowA(f: parse.Fn, g: parse.Fn, r: List<array.Arr>, bcols: List<List<array.Arr>>, env: Env, acc: List<array.Arr>) -> Evs {
  match bcols {
    (c, rest) => match zipEach(g, r, c, env, ~) {
      .err(e) => Evs.err(e),
      .ok(p) => match p { (prods, env2) => match reduceItems(f, prods, env2) {
        .err(e) => Evs.err(e),
        .ok(q) => match q { (v, env3) => innerRowA(f, g, r, rest, env3, (v, acc)), },
      }, },
    },
    _ => Evs.ok((array.revA(acc, ~), env)),
  }
};
func spreadEach(xs: List<@>, n: @) -> List<@> { match xs { (h, t) => array.catL(array.repL(h, n), spreadEach(t, n)), _ => ~, } };
// A f.g B for ranks up to 2:  rows of A against columns of B, g then f/
func inner(f: parse.Fn, g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  if array.isBox(a) or array.isBox(b) { innerItems(f, g, a, b, env) } else { innerSimple(f, g, a, b, env) }
};
func innerSimple(f: parse.Fn, g: parse.Fn, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ra = array.rank(a);
  let rb = array.rank(b);
  if ra > 2 or rb > 2 { nyi("inner product on rank 3 and above") }
  else {
    let arows = if ra == 2 { array.chunks(array.vals(a), array.lastDim(array.shape(a))) } else { [array.vals(a)] };
    let bcols = if rb == 2 { array.colsOf(array.chunks(array.vals(b), array.lastDim(array.shape(b))), array.lastDim(array.shape(b)), 0) } else { [array.vals(b)] };
    match innerAll(f, g, a.kind, arows, b.kind, bcols, env, ~) {
      .err(e) => Ev.err(e),
      .ok(rs) => match rs { (scalars, env2) => {
        let shp = array.catL(if ra == 2 { [array.firstDim(array.shape(a))] } else { ~ }, if rb == 2 { [array.lastDim(array.shape(b))] } else { ~ });
        okv(gatherShaped(scalars, shp), env2)
      }, },
    }
  }
};
func innerAll(f: parse.Fn, g: parse.Fn, ka: @, arows: List<List<@>>, kb: @, bcols: List<List<@>>, env: Env, acc: List<array.Arr>) -> Evs {
  match arows {
    (r, rest) => match innerRow(f, g, ka, r, kb, bcols, env, ~) {
      .err(e) => Evs.err(e),
      .ok(rs) => match rs { (vs, env2) => innerAll(f, g, ka, rest, kb, bcols, env2, catArrs(acc, vs)), },
    },
    _ => Evs.ok((acc, env)),
  }
};
func innerRow(f: parse.Fn, g: parse.Fn, ka: @, r: List<@>, kb: @, bcols: List<List<@>>, env: Env, acc: List<array.Arr>) -> Evs {
  match bcols {
    (c, rest) => match applyDyad(g, vec(ka, r), vec(kb, c), env) {
      .err(e) => Evs.err(e),
      .ok(p) => match p { (prod, env2) => match reduceL(f, prod.kind, array.vals(prod), env2) {
        .err(e) => Evs.err(e),
        .ok(q) => match q { (v, env3) => innerRow(f, g, ka, r, kb, rest, env3, (v, acc)), },
      }, },
    },
    _ => Evs.ok((revArrs(acc, ~), env)),
  }
};

// --- bracket indexing (D-23) ----------------------------------------------------------------------
// each index part as 0-based positions, plus the result shape (D-23): a part
// contributes its own shape, so a scalar index contributes nothing and an
// elision contributes the axis length
func evalParts(ixs: List<parse.Ast>, x: array.Arr, env: Env, acc: List<List<@>>, shp: List<@>) -> Parts {
  match ixs {
    (ix, rest) => match ix {
      .elide => {
        let n = array.nth(array.shape(x), array.countLL(acc));
        evalParts(rest, x, env, (array.iotaL(n, 0), acc), array.catL(shp, [n]))
      },
      _ => match evalAst(ix, env) {
        .err(e) => Parts.err(e),
        .ok(r) => match r { (iv, env2) => if iv.kind != 1 { Parts.err(EErr( tag: "%domain-error", hint: "indices are non-negative integers" )) }
          else { evalParts(rest, x, env2, (shiftIo(array.vals(iv), env2.io), acc), array.catL(shp, array.shape(iv))) }, },
      },
    },
    _ => Parts.ok((revLL(acc, ~), shp, env)),
  }
};
func shiftIo(xs: List<@>, io: @) -> List<@> { match xs { (h, t) => (if h < io { 4294967295 } else { h - io }, shiftIo(t, io)), _ => ~, } };
func inBounds(parts: List<List<@>>, shp: List<@>) -> Bool {
  match parts { (p, rest) => match shp { (d, ds) => array.allL(p, lambda (i: @) -> Bool { i < d }) and inBounds(rest, ds), _ => false, }, _ => true, }
};
func positions(parts: List<List<@>>, shp: List<@>) -> List<@> { flatAll(array.cartesian(parts), shp) };
func flatAll(ixs: List<List<@>>, shp: List<@>) -> List<@> { match ixs { (ix, rest) => (array.flatIx(shp, ix), flatAll(rest, shp)), _ => ~, } };
func gatherAt(vs: List<@>, pos: List<@>) -> List<@> { match pos { (p, rest) => (array.nth(vs, p), gatherAt(vs, rest)), _ => ~, } };
func indexed(x: array.Arr, parts: List<List<@>>, rshp: List<@>, env: Env) -> Ev {
  let shp = array.shape(x);
  if array.countLL(parts) != array.count(shp) { fail("%rank-error", "the number of indices is the rank") }
  else if not inBounds(parts, shp) { fail("%index-error", "index out of range") }
  else if array.isBox(x) { okv(array.regather(x, mk(1, rshp, gatherAt(array.vals(x), positions(parts, shp)))), env) }
  else { okv(mk(x.kind, rshp, gatherAt(array.vals(x), positions(parts, shp))), env) }
};
func assignAt(x0: array.Arr, parts: List<List<@>>, v0: array.Arr, env: Env) -> Ev {
  let shp = array.shape(x0);
  if array.countLL(parts) != array.count(shp) { fail("%rank-error", "the number of indices is the rank") }
  else if not inBounds(parts, shp) { fail("%index-error", "index out of range") }
  else if array.isBox(x0) or array.isBox(v0) or ((x0.kind == 4) != (v0.kind == 4)) { assignItems(x0, parts, v0, env) }
  else {
    let k = joinKind(x0, v0);
    let x = array.promoteAt(x0, k, joinW(x0, v0));
    let v = array.promoteAt(v0, k, joinW(x0, v0));
    let pos = positions(parts, shp);
    let n = array.count(pos);
    let vs = if array.size(array.shape(v)) == 1 { array.repL(array.first(v), n) } else { array.vals(v) };
    if array.count(vs) != n { fail("%length-error", "the value does not fit the indices") }
    else { okv(mk(k, shp, setAll(array.vals(x), pos, vs)), env) }
  }
};
func setAll(xs: List<@>, pos: List<@>, vs: List<@>) -> List<@> {
  match pos { (p, prest) => match vs { (v, vrest) => setAll(setNth(xs, p, v), prest, vrest), _ => xs, }, _ => xs, }
};
func setNth(xs: List<@>, i: @, v: @) -> List<@> { match xs { (h, t) => if i == 0 { (v, t) } else { (h, setNth(t, i - 1, v)) }, _ => ~, } };
// an indexed assignment that leaves a box (D-23): the elements set whole
func assignItems(x0: array.Arr, parts: List<List<@>>, v0: array.Arr, env: Env) -> Ev {
  let shp = array.shape(x0);
  let pos = positions(parts, shp);
  let n = array.count(pos);
  let vs = if array.size(array.shape(v0)) == 1 { repA(array.firstItem(v0), n) } else { array.itemsOf(v0) };
  if array.countA(vs) != n { fail("%length-error", "the value does not fit the indices") }
  else { okv(array.normalize(shp, setAllA(array.itemsOf(x0), pos, vs)), env) }
};
func repA(x: array.Arr, n: @) -> List<array.Arr> { if n == 0 { ~ } else { (x, repA(x, n - 1)) } };
func setAllA(xs: List<array.Arr>, pos: List<@>, vs: List<array.Arr>) -> List<array.Arr> {
  match pos { (p, prest) => match vs { (v, vrest) => setAllA(setNthA(xs, p, v), prest, vrest), _ => xs, }, _ => xs, }
};
func setNthA(xs: List<array.Arr>, i: @, v: array.Arr) -> List<array.Arr> { match xs { (h, t) => if i == 0 { (v, t) } else { (h, setNthA(t, i - 1, v)) }, _ => ~, } };

// --- the tree -------------------------------------------------------------------------------
func evalAst(a: parse.Ast, env: Env) -> Ev {
  match a {
    .lit(l) => litEv(l, env),
    .strand(xs) => evalStrand(xs, env),
    .name(nm) => match lookupVar(env, nm) { (found, v) => if found { okv(v, env) } else { fail("%value-error", nm + " is not defined") }, },
    .nilad(nm) => callUser(nm, false, false, array.scalar(1, 0), array.scalar(1, 0), env),
    .sysvar(nm) => if nm == "IO" { okv(array.scalar(1, env.io), env) } else if nm == "PP" { okv(array.scalar(1, env.pp), env) } else if nm == "TYPE" { okv(charsVec(typeText(env)), env) } else { nyi("⎕" + nm) },
    .monad(m) => match evalAst(m.r, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (rv, env2) => applyMonad(m.f, rv, env2), },
    },
    .dyad(d) => match evalAst(d.r, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (rv, env2) => match evalAst(d.l, env2) {
        .err(e) => Ev.err(e),
        .ok(l) => match l { (lv, env3) => applyDyad(d.f, lv, rv, env3), },
      }, },
    },
    .index(ix) => match evalAst(ix.a, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (xv, env2) => match evalParts(ix.ix, xv, env2, ~, ~) {
        .err(e) => Ev.err(e),
        .ok(pr) => match pr { (parts, rshp, env3) => indexed(xv, parts, rshp, env3), },
      }, },
    },
    .iassign(s) => match lookupVar(env, s.nm) {
      (found, x0) => if not found { fail("%value-error", s.nm + " is not defined") }
      else {
        match evalAst(s.v, env) {
          .err(e) => Ev.err(e),
          .ok(r) => match r { (v, env2) => match evalParts(s.ix, x0, env2, ~, ~) {
            .err(e) => Ev.err(e),
            .ok(pr) => match pr { (parts, rshp, env3) => match assignAt(x0, parts, v, env3) {
              .err(e) => Ev.err(e),
              .ok(r2) => match r2 { (x2, env4) => okv(v, putVar(env4, s.nm, x2)), },
            }, },
          }, },
        }
      },
    },
    .assign(s) => match evalAst(s.v, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (v, env2) => okv(v, putVar(env2, s.nm, v)), },
    },
    .sysassign(s) => match evalAst(s.v, env) {
      .err(e) => Ev.err(e),
      .ok(r) => match r { (v, env2) => sysSet(s.nm, v, env2), },
    },
    _ => nyi("this form"),
  }
};
// a strand (D-71): the items right to left, the vector in normal form
func evalStrand(xs: List<parse.Ast>, env: Env) -> Ev {
  match evalItems(revAsts(xs, ~), env, ~) {
    .err(e) => Ev.err(e),
    .ok(r) => match r { (vs, env2) => okv(array.normalize([array.countA(vs)], vs), env2), },
  }
};
func evalItems(xs: List<parse.Ast>, env: Env, acc: List<array.Arr>) -> Evs {
  match xs {
    (h, t) => match evalAst(h, env) { .err(e) => Evs.err(e), .ok(r) => match r { (v, env2) => evalItems(t, env2, (v, acc)), }, },
    _ => Evs.ok((acc, env)),
  }
};
// --- ⎕TYPE (D-15) ----------------------------------------------------------------------------
// a width name per kind: UINT8..UINT64 naturals, INT8..INT64 integers, REAL16..REAL128 reals
func typeText(env: Env) -> String { "UINT" + bitsText(env.nb) + " INT" + bitsText(env.ib) + " REAL" + bitsText(env.rb) };
func bitsText(b: @) -> String { array.fmtNat(array.pow2(b)) };
func charsVec(s: String) -> array.Arr { vec(4, cps(s)) };
// (kind 1 nat, 2 int, 3 real, 0 none;  bloq)
func typeName(w: String) -> (@, @) {
  if w == "UINT8" { (1, 3) } else if w == "UINT16" { (1, 4) } else if w == "UINT32" { (1, 5) } else if w == "UINT64" { (1, 6) }
  else if w == "INT8" { (2, 3) } else if w == "INT16" { (2, 4) } else if w == "INT32" { (2, 5) } else if w == "INT64" { (2, 6) }
  else if w == "REAL16" { (3, 4) } else if w == "REAL32" { (3, 5) } else if w == "REAL64" { (3, 6) } else if w == "REAL128" { (3, 7) }
  else { (0, 0) }
};
func splitWords(cs: List<@>, cur: List<@>, acc: List<String>) -> List<String> {
  match cs {
    (c, t) => if c == 32 { splitWords(t, ~, pushWord(cur, acc)) } else { splitWords(t, (c, cur), acc) },
    _ => revSL(pushWord(cur, acc), ~),
  }
};
func pushWord(cur: List<@>, acc: List<String>) -> List<String> { match cur { (h, t) => (utf8(toUni(array.revL(cur, ~))), acc), _ => acc, } };
func revSL(xs: List<String>, acc: List<String>) -> List<String> { match xs { (h, t) => revSL(t, (h, acc)), _ => acc, } };
// ⎕TYPE←'REAL32' sets the width of one kind;  several names set several, the last of a kind winning
func setTypes(ws: List<String>, env: Env) -> (Bool, Env) {
  match ws {
    (w, rest) => match typeName(w) { (k, b) =>
      if k == 0 { (false, env) }
      else { setTypes(rest, if k == 1 { setTw(env, b, env.ib, env.rb) } else if k == 2 { setTw(env, env.nb, b, env.rb) } else { setTw(env, env.nb, env.ib, b) }) }, },
    _ => (true, env),
  }
};
func sysSet(nm: String, v: array.Arr, env: Env) -> Ev {
  if nm == "TYPE" {
    if v.kind != 4 or array.rank(v) > 1 { dom("⎕TYPE takes width names such as 'REAL32' (D-15)") }
    else {
      let ws = splitWords(array.vals(v), ~, ~);
      match ws {
        (h, t) => match setTypes(ws, env) {
          (ok, env2) => if ok { okv(v, env2) } else { dom("⎕TYPE takes UINT8 UINT16 UINT32 UINT64, INT8 INT16 INT32 INT64, REAL16 REAL32 REAL64 REAL128 (D-15)") },
        },
        _ => dom("⎕TYPE takes width names such as 'REAL32' (D-15)"),
      }
    }
  }
  else if array.rank(v) != 0 or v.kind != 1 { dom("⎕" + nm + " takes a scalar") }
  else {
    let x = array.first(v);
    if nm == "IO" { if isBool(x) { okv(v, setIo(env, x)) } else { dom("⎕IO is 0 or 1") } }
    else if nm == "PP" { if x >= 1 and x <= 17 { okv(v, setPp(env, x)) } else { dom("⎕PP is 1..17") } }
    else { nyi("⎕" + nm) }
  }
};
func isAssign(a: parse.Ast) -> Bool { match a { .assign(s) => true, .sysassign(s) => true, .iassign(s) => true, _ => false, } };
// one statement: what it prints (D-24) and the environment after it
func runStmt(a: parse.Ast, env: Env) -> (String, Env) {
  match a {
    .empty => ("", env),
    .fnend => ("", env),
    .stmts(ss) => runAll(ss, env, ""),
    .cmd(c) => command(c, env),
    .fassign(s) => ("", putFnDef(env, s.nm, dfnOf(s.f))),
    .guard(g) => ("%syntax-error a guard belongs in a dfn body (D-66)", env),
    .eguard(g) => ("%syntax-error an error guard belongs in a dfn body (D-94)", env),
    _ => finish(a, evalAst(a, env), env),
  }
};
func dfnOf(f: parse.Fn) -> parse.Dfn { match f { .dfn(d) => d, _ => parse.Dfn( body: ~ ), } };
// --- system commands (D-61) ----------------------------------------------------------------------
func command(c: parse.Cmd, env: Env) -> (String, Env) {
  if c.nm == "VARS" { (array.joinS(sortS(storeNames(env.store, ~)), " "), env) }
  else if c.nm == "FNS" { (array.joinS(sortS(fnNames(env.fns, dfnNames(env.dfns, ~))), " "), env) }
  else if c.nm == "ERASE" { (eraseAll(c.args, env, ""), eraseEnv(c.args, env)) }
  else if c.nm == "OFF" { ("bye", env) }
  else { ("%syntax-error unknown command )" + c.nm, env) }
};
func storeNames(st: List<(String, array.Arr)>, acc: List<String>) -> List<String> { match st { ((n, v), t) => storeNames(t, (n, acc)), _ => acc, } };
func fnNames(fs: List<(String, Fndef)>, acc: List<String>) -> List<String> { match fs { ((n, d), t) => fnNames(t, (n, acc)), _ => acc, } };
func dfnNames(ds: List<(String, Dfndef)>, acc: List<String>) -> List<String> { match ds { ((n, d), t) => dfnNames(t, (n, acc)), _ => acc, } };
func eraseEnv(names: List<String>, env: Env) -> Env {
  match names { (n, rest) => eraseEnv(rest, setDfns(setFns(setStore(env, delStore(env.store, n)), delFn(env.fns, n)), delDfn(env.dfns, n))), _ => env, }
};
func eraseAll(names: List<String>, env: Env, acc: String) -> String {
  match names {
    (n, rest) => match lookup(env.store, n) { (had, v) => match lookupFn(env.fns, n) { (hadf, d) => match lookupDfn(env.dfns, n) { (hadd, dd) => eraseAll(rest, env, if had or hadf or hadd { acc } else if acc == "" { "%value-error " + n + " is not defined" } else { acc }), }, }, },
    _ => acc,
  }
};
func delFn(fs: List<(String, Fndef)>, nm: String) -> List<(String, Fndef)> { match fs { ((n, d), t) => if n == nm { t } else { ((n, d), delFn(t, nm)) }, _ => ~, } };
// byte-wise lexicographic order on names, insertion sort
func strLt(a: String, b: String) -> Bool { bytesLt(a.bytes(), b.bytes()) };
func bytesLt(xs: List<Byte>, ys: List<Byte>) -> Bool {
  match xs { (x, xt) => match ys { (y, yt) => if x < y { true } else if y < x { false } else { bytesLt(xt, yt) }, _ => false, }, _ => match ys { (y, yt) => true, _ => false, }, }
};
func insS(x: String, xs: List<String>) -> List<String> { match xs { (h, t) => if strLt(x, h) { (x, xs) } else { (h, insS(x, t)) }, _ => [x], } };
func sortS(xs: List<String>) -> List<String> { match xs { (h, t) => insS(h, sortS(t)), _ => ~, } };
// what one statement prints, from its result (D-24, D-45), draining the body-output buffer
func finish(a: parse.Ast, ev: Ev, env: Env) -> (String, Env) {
  match ev {
    .err(e) => (joinOut(env.out, e.tag + " " + e.hint), setOut(env, ~)),
    .ok(r) => match r { (v, env2) => (joinOut(env2.out, if isAssign(a) { "" } else { array.format(v, env2.pp) }), setOut(env2, ~)), },
  }
};
// what body lines printed before this statement's own output
func joinOut(out: List<String>, own: String) -> String {
  let before = array.joinS(revS(out, ~), "\n");
  if before == "" { own } else if own == "" { before } else { before + "\n" + own }
};
func revS(xs: List<String>, acc: List<String>) -> List<String> { match xs { (h, t) => revS(t, (h, acc)), _ => acc, } };

// --- tradfns (D-30, D-31, D-34, D-62) --------------------------------------------------------------
func headerClass(h: parse.Header) -> @ { if h.lft == "" { if h.rgt == "" { 5 } else { 2 } } else { 3 } };
// definition mode:  a header opens it, body lines accumulate, a lone ∇ closes it
func defineStart(h: parse.Header, env: Env) -> Env { setPending(env, h, ~) };
func defineLine(line: String, env: Env) -> Env { setPending(env, env.phdr, (line, env.pend)) };
func defineEnd(env: Env) -> Env {
  let d = Fndef( h: env.phdr, body: revS(env.pend, ~), cached: false, ckey: ~, cast: ~, cfor: ~ );
  setPending(setDfns(setFns(env, putFn(env.fns, env.phdr.nm, d)), delDfn(env.dfns, env.phdr.nm)), noHeader(), ~)
};
func putFn(fs: List<(String, Fndef)>, nm: String, d: Fndef) -> List<(String, Fndef)> {
  match fs { ((n, w), t) => if n == nm { ((nm, d), t) } else { ((n, w), putFn(t, nm, d)) }, _ => [(nm, d)], }
};
func lookupFn(fs: List<(String, Fndef)>, nm: String) -> (Bool, Fndef) {
  match fs { ((n, d), t) => if n == nm { (true, d) } else { lookupFn(t, nm) }, _ => (false, Fndef( h: noHeader(), body: ~, cached: false, ckey: ~, cast: ~, cfor: ~ )), }
};
// the parser's signature for the environment as it stands (D-52): the
// globals, then each frame's bindings in front of them, innermost first,
// so a local shadows a global; inside a dfn `∇` is an ambivalent function
func sigOf(env: Env) -> List<(String, @)> {
  let globals = sigDfns(env.dfns, sigFns(env.fns, sigStore(env.store, ~)));
  match env.frames { (f, rest) => (("∇", 4), sigFrames(env.frames, globals)), _ => globals, }
};
func sigDfns(ds: List<(String, Dfndef)>, acc: List<(String, @)>) -> List<(String, @)> {
  match ds { ((n, d), t) => sigDfns(t, ((n, parse.dfnClass(d.d)), acc)), _ => acc, }
};
// innermost first in the list means the innermost frame's entries go in front last
func sigFrames(frames: List<Frame>, acc: List<(String, @)>) -> List<(String, @)> {
  match frames { (f, rest) => sigFrame(f, sigFrames(rest, acc)), _ => acc, }
};
func sigFrame(f: Frame, acc: List<(String, @)>) -> List<(String, @)> { sigOps(f.ops, sigPDs(f.fns, sigStore(f.vars, acc))) };
func sigOps(os: List<(String, parse.Fn)>, acc: List<(String, @)>) -> List<(String, @)> { match os { ((n, g), t) => sigOps(t, ((n, 4), acc)), _ => acc, } };
func sigPDs(fs: List<(String, parse.Dfn)>, acc: List<(String, @)>) -> List<(String, @)> {
  match fs { ((n, d), t) => sigPDs(t, ((n, parse.dfnClass(d)), acc)), _ => acc, }
};
func sigStore(st: List<(String, array.Arr)>, acc: List<(String, @)>) -> List<(String, @)> {
  match st { ((n, v), t) => sigStore(t, ((n, 1), acc)), _ => acc, }
};
func sigFns(fs: List<(String, Fndef)>, acc: List<(String, @)>) -> List<(String, @)> {
  match fs { ((n, d), t) => sigFns(t, ((n, headerClass(d.h)), acc)), _ => acc, }
};
func delStore(st: List<(String, array.Arr)>, nm: String) -> List<(String, array.Arr)> {
  match st { ((n, v), t) => if n == nm { t } else { ((n, v), delStore(t, nm)) }, _ => ~, }
};
// the names a header localizes (D-31)
func localNames(h: parse.Header) -> List<String> {
  let base = h.locals;
  let r = if h.res == "" { base } else { (h.res, base) };
  let l = if h.lft == "" { r } else { (h.lft, r) };
  if h.rgt == "" { l } else { (h.rgt, l) }
};
// after the call, every local returns to what the caller had (or to unbound)
func restoreLocals(saved: List<(String, array.Arr)>, st: List<(String, array.Arr)>, names: List<String>) -> List<(String, array.Arr)> {
  match names {
    (n, rest) => match lookup(saved, n) { (had, v) => restoreLocals(saved, if had { put(st, n, v) } else { delStore(st, n) }, rest), },
    _ => st,
  }
};
func callUser(nm: String, dyadic: Bool, monadic: Bool, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  match lookupFn(env.fns, nm) {
    (found, d) => if not found { fail("%value-error", nm + " is not defined") }
    else {
      let h = d.h;
      let saved = env.store;
      // bind the arguments;  the result and the locals start unbound (D-31)
      let st0 = unbindAll(env.store, localNames(h));
      let st1 = if monadic { put(st0, h.rgt, b) } else { st0 };
      let st2 = if dyadic { put(st1, h.lft, a) } else { st1 };
      // a tradfn lives in the global, dynamic scope: the dfn frames of its
      // caller are hidden for the call (D-65)
      let entry = setFrames(setStore(env, st2), ~);
      let key = sigOf(entry);
      let hit = d.cached and d.ckey == key;
      let ran = if hit { runCached(d.cast, d.cfor, entry, ~, ~) } else { runBodyCollect(d.body, entry, ~, ~) };
      match ran {
        .err(e) => Ev.err(e),
        .ok(r) => match r { (asts, fors, env2) => match lookup(env2.store, h.res) {
          (hasRes, res) => {
            let fresh = Fndef( h: h, body: d.body, cached: true, ckey: key, cast: asts, cfor: fors );
            let env3 = setFrames(setFns(setStore(env2, restoreLocals(saved, env2.store, localNames(h))), if hit { env2.fns } else { putFn(env2.fns, nm, fresh) }), env.frames);
            if h.res == "" { fail("%value-error", nm + " returns no result") }
            else if not hasRes { fail("%value-error", nm + " did not set its result " + h.res) }
            else { okv(res, env3) }
          },
        }, },
      }
    },
  }
};
func unbindAll(st: List<(String, array.Arr)>, names: List<String>) -> List<(String, array.Arr)> {
  match names { (n, rest) => unbindAll(delStore(st, n), rest), _ => st, }
};
// the body, one line at a time, each parsed against the signature as it
// stands and EMITTED (D-34); the trees and the lowered formulas come back
// for the cache, in order
func runBodyCollect(lines: List<String>, env: Env, acc: List<parse.Ast>, facc: List<List<*>>) -> BodyR {
  match lines {
    (line, rest) => match parse.parseLine(line, sigOf(env)) {
      .err(e) => BodyR.err(EErr( tag: e.tag, hint: e.hint )),
      .ok(a) => {
        let fs = formulasOf(flatStmts(a), env);
        match runLine(flatStmts(a), fs, env) { .err(e) => BodyR.err(e), .ok(env2) => runBodyCollect(rest, env2, (a, acc), (fs, facc)), }
      },
    },
    _ => BodyR.ok((revAsts(acc, ~), revFors(facc, ~), env)),
  }
};
// a cached body:  the trees and formulas, no parsing and no emitting
func runCached(asts: List<parse.Ast>, fors: List<List<*>>, env: Env, acc: List<parse.Ast>, facc: List<List<*>>) -> BodyR {
  match asts {
    (a, rest) => match fors {
      (fs, frest) => match runLine(flatStmts(a), fs, env) { .err(e) => BodyR.err(e), .ok(env2) => runCached(rest, frest, env2, (a, acc), (fs, facc)), },
      _ => BodyR.err(EErr( tag: "%emit-mismatch", hint: "cache shape" )),
    },
    _ => BodyR.ok((revAsts(acc, ~), revFors(facc, ~), env)),
  }
};
func revAsts(xs: List<parse.Ast>, acc: List<parse.Ast>) -> List<parse.Ast> { match xs { (h, t) => revAsts(t, (h, acc)), _ => acc, } };
func revFors(xs: List<List<*>>, acc: List<List<*>>) -> List<List<*>> { match xs { (h, t) => revFors(t, (h, acc)), _ => acc, } };
// a line's statements, flat (a ⋄ line is several)
func flatStmts(a: parse.Ast) -> List<parse.Ast> { match a { .stmts(ss) => ss, _ => [a], } };
// the lowered formula of each emittable statement (0 for one that is not emitted)
func formulasOf(ss: List<parse.Ast>, env: Env) -> List<*> {
  match ss { (st, rest) => (if emittable(st) { lower(st, env) } else { 0 }, formulasOf(rest, env)), _ => ~, }
};
// one line: each statement through the interpreter and, when emitted, through
// its formula, the two results held equal
func runLine(ss: List<parse.Ast>, fs: List<*>, env: Env) -> EnvR {
  match ss {
    (st, rest) => match fs {
      (f, frest) => match runBodyStmt(st, f, env) { .err(e) => EnvR.err(e), .ok(env2) => runLine(rest, frest, env2), },
      _ => EnvR.err(EErr( tag: "%emit-mismatch", hint: "formula count" )),
    },
    _ => EnvR.ok(env),
  }
};
// the statement's result: the tree evaluation, and the formula's agreement with it
func bodyEv(a: parse.Ast, f: *, env: Env) -> Ev {
  let e1 = evalAst(a, env);
  if emittable(a) {
    let e2 = eval((runtime(), env), f) as! Ev;
    if e1 == e2 { e1 } else { fail("%emit-mismatch", "a tradfn body statement differs between the interpreter and its formula") }
  } else { e1 }
};
func runBodyStmt(a: parse.Ast, f: *, env: Env) -> EnvR {
  match a {
    .empty => EnvR.ok(env),
    .fnend => EnvR.ok(env),
    .header(h) => EnvR.err(EErr( tag: "%syntax-error", hint: "∇ inside a function body" )),
    .fassign(s) => EnvR.ok(putFnDef(env, s.nm, dfnOf(s.f))),
    .guard(g) => EnvR.err(EErr( tag: "%syntax-error", hint: "a guard belongs in a dfn body (D-66)" )),
    .eguard(g) => EnvR.err(EErr( tag: "%syntax-error", hint: "an error guard belongs in a dfn body (D-94)" )),
    _ => match bodyEv(a, f, env) {
      .err(e) => EnvR.err(e),
      .ok(r) => match r { (v, env2) => EnvR.ok(if isAssign(a) { env2 } else { pushOut(env2, array.format(v, env2.pp)) }), },
    },
  }
};

// --- dfns (D-63..D-69) -------------------------------------------------------------------------------
// A call opens a frame holding ⍵ (and ⍺ when dyadic) and runs the body
// line by line, each line parsed against the signature as it stands and
// emitted, as a tradfn body is (D-34); the statements run in order, an
// assignment or a false guard continues, a true guard's expression or any
// other value ENDS the body and is the result (D-66). A global dfn runs
// over the store alone; a nested or anonymous one over its definer's
// frames too (D-65). ⎕IO and ⎕PP set inside are local. A named dfn keeps
// the trees and formulas of the lines a call reached, keyed by the entry
// signature (which carries ⍺ only when bound, D-67); a later call that
// reaches further parses on from there and extends the cache.
func callDfn(nm: String, d: parse.Dfn, dyadic: Bool, a: array.Arr, b: array.Arr, env: Env) -> Ev { callDfnOps(nm, d, dyadic, a, b, ~, env) };
// a dfn operator applied (D-95): its body runs as a dfn's, with the operands as ⍺⍺ and ⍵⍵
func callOp(x: parse.Dop, dyadic: Bool, a: array.Arr, b: array.Arr, env: Env) -> Ev {
  let ops = if x.two { [("⍺⍺", x.l), ("⍵⍵", x.r)] } else { [("⍺⍺", x.l)] };
  match x.op {
    .dfn(d) => callDfnOps("", d, dyadic, a, b, ops, env),
    .user(nm) => match lookupLocalFn(env.frames, nm) {
      (local, ld) => if local { callDfnOps("", ld, dyadic, a, b, ops, env) }
        else { match lookupDfn(env.dfns, nm) { (global, gd) => if global { callDfnOps(nm, gd.d, dyadic, a, b, ops, env) } else { fail("%value-error", nm + " is not defined") }, } },
    },
    _ => fail("%syntax-error", "an operator is a dfn naming ⍺⍺ (D-95)"),
  }
};
func lookupOp(frames: List<Frame>, nm: String) -> (Bool, parse.Fn) {
  match frames { (f, rest) => lookupOpIn(f.ops, nm), _ => (false, parse.Fn.prim(0)), }
};
func lookupOpIn(os: List<(String, parse.Fn)>, nm: String) -> (Bool, parse.Fn) {
  match os { ((n, g), t) => if n == nm { (true, g) } else { lookupOpIn(t, nm) }, _ => (false, parse.Fn.prim(0)), }
};
func callDfnOps(nm: String, d: parse.Dfn, dyadic: Bool, a: array.Arr, b: array.Arr, ops: List<(String, parse.Fn)>, env: Env) -> Ev {
  let global = nm != "";
  let args = if dyadic { [("⍺", a), ("⍵", b)] } else { [("⍵", b)] };
  let frame = Frame( vars: args, fns: ~, own: d, name: nm, ops: ops );
  let entry = setFrames(env, if global { [frame] } else { (frame, env.frames) });
  let key = sigOf(entry);
  match lookupDfn(env.dfns, nm) {
    (found, cd) => {
      let hit = global and found and cd.cached and cd.ckey == key;
      let tr0 = noTrap(entry);
      let ran = if hit { dfnCached(cd.cast, cd.cfor, d.body, entry, ~, ~, tr0) } else { dfnLines(d.body, 1, entry, ~, ~, tr0) };
      match ran {
        .err(e) => Ev.err(e),
        .ok(r) => match r { (asts, fors, has, v, env2) => {
          let env3 = setTw(setPp(setIo(setFrames(env2, env.frames), env.io), env.pp), env.nb, env.ib, env.rb);   // ⎕IO ⎕PP ⎕TYPE are local (D-65, D-15)
          let env4 = if global { setDfns(env3, putDfn(env3.dfns, nm, Dfndef( d: d, cached: true, ckey: key, cast: asts, cfor: fors ))) } else { env3 };
          if has { okv(v, env4) } else { fail("%value-error", "the dfn returned no result (D-66)") }
        }, },
      }
    },
  }
};
func dfnLines(lines: List<String>, n: @, env: Env, acc: List<parse.Ast>, facc: List<List<(*, *)>>, tr: Trap) -> DfnR {
  match lines {
    (line, rest) => match parse.parseLine(line, sigOf(env)) {
      .err(e) => caught(tr, EErr( tag: e.tag, hint: "dfn line {n}: " + e.hint ), acc, facc),
      .ok(a) => {
        let ss = flatStmts(a);
        let fs = dfnFormulas(ss, env);
        match dfnStmts(ss, fs, env, tr) {
          .err(e) => DfnR.err(e),
          .next(env2) => dfnLines(rest, n + 1, env2, (a, acc), (fs, facc), tr),
          .armed(r) => match r { (env2, tr2) => dfnLines(rest, n + 1, env2, (a, acc), (fs, facc), tr2), },
          .done(r) => match r { (v, env2) => DfnR.ok((revAsts((a, acc), ~), revDFors((fs, facc), ~), true, v, env2)), },
        }
      },
    },
    _ => DfnR.ok((revAsts(acc, ~), revDFors(facc, ~), false, array.scalar(1, 0), env)),
  }
};
// the cached prefix replayed, then the lines past it parsed on
func dfnCached(asts: List<parse.Ast>, fors: List<List<(*, *)>>, lines: List<String>, env: Env, acc: List<parse.Ast>, facc: List<List<(*, *)>>, tr: Trap) -> DfnR {
  match asts {
    (a, arest) => match fors {
      (fs, frest) => match dfnStmts(flatStmts(a), fs, env, tr) {
        .err(e) => DfnR.err(e),
        .next(env2) => dfnCached(arest, frest, tailS(lines), env2, (a, acc), (fs, facc), tr),
        .armed(r) => match r { (env2, tr2) => dfnCached(arest, frest, tailS(lines), env2, (a, acc), (fs, facc), tr2), },
        .done(r) => match r { (v, env2) => DfnR.ok((revAsts((a, acc), ~), revDFors((fs, facc), ~), true, v, env2)), },
      },
      _ => DfnR.err(EErr( tag: "%emit-mismatch", hint: "cache shape" )),
    },
    _ => dfnLines(lines, countAsts(acc) + 1, env, acc, facc, tr),
  }
};
func tailS(xs: List<String>) -> List<String> { match xs { (h, t) => t, _ => ~, } };
func countAsts(xs: List<parse.Ast>) -> @ { match xs { (h, t) => 1 + countAsts(t), _ => 0, } };
func revDFors(xs: List<List<(*, *)>>, acc: List<List<(*, *)>>) -> List<List<(*, *)>> { match xs { (h, t) => revDFors(t, (h, acc)), _ => acc, } };
// a formula per statement; a guard carries one for its condition and one for its expression
func dfnFormulas(ss: List<parse.Ast>, env: Env) -> List<(*, *)> {
  match ss { (st, rest) => (dfnFormula(st, env), dfnFormulas(rest, env)), _ => ~, }
};
func dfnFormula(st: parse.Ast, env: Env) -> (*, *) {
  match st { .guard(g) => (lowerOr(g.c, env), lowerOr(g.e, env)), .eguard(g) => (lowerOr(g.c, env), lowerOr(g.e, env)), _ => (lowerOr(st, env), noFormula()), }
};
func lowerOr(a: parse.Ast, env: Env) -> * { if emittable(a) { lower(a, env) } else { noFormula() } };
func noFormula() -> * { 0 };
func dfnStmts(ss: List<parse.Ast>, fs: List<(*, *)>, env: Env, tr: Trap) -> StepR {
  match ss {
    (st, rest) => match fs {
      ((f1, f2), frest) => match dfnStmt(st, f1, f2, env) {
        .err(e) => if catches(tr, e) { runTrap(tr) } else { StepR.err(e) },
        .next(env2) => dfnStmts(rest, frest, env2, tr),
        .armed(r) => match r { (env2, tr2) => dfnStmts(rest, frest, env2, tr2), },
        .done(r) => StepR.done(r),
      },
      _ => StepR.err(EErr( tag: "%emit-mismatch", hint: "formula count" )),
    },
    _ => if tr.set { StepR.armed((env, tr)) } else { StepR.next(env) },
  }
};
// --- error guards (D-94) ------------------------------------------------------------------------
func noTrap(env: Env) -> Trap { Trap( set: false, codes: ~, e: parse.Ast.empty, f: noFormula(), env: env ) };
// the error number of a tag:  Dyalog's where the class is shared (valence errors are its syntax errors)
func errCode(tag: String) -> @ {
  if tag == "%syntax-error" or tag == "%valence-error" { 2 } else if tag == "%index-error" { 3 } else if tag == "%rank-error" { 4 }
  else if tag == "%length-error" { 5 } else if tag == "%value-error" { 6 } else if tag == "%axis-error" { 9 } else if tag == "%domain-error" { 11 }
  else if tag == "%unimplemented" { 16 } else { 999 }
};
func catches(tr: Trap, e: EErr) -> Bool {
  let c = errCode(e.tag);
  tr.set and c != 999 and (memberN(0, tr.codes) or memberN(c, tr.codes))
};
func memberN(x: @, xs: List<@>) -> Bool { match xs { (h, rest) => if h == x { true } else { memberN(x, rest) }, _ => false, } };
func runTrap(tr: Trap) -> StepR {
  match bodyEv(tr.e, tr.f, tr.env) { .err(e) => StepR.err(e), .ok(r) => StepR.done(r), }
};
// a parse error on a later line, caught by the guard in force
func caught(tr: Trap, e: EErr, acc: List<parse.Ast>, facc: List<List<(*, *)>>) -> DfnR {
  if catches(tr, e) { match runTrap(tr) {
    .done(r) => match r { (v, env2) => DfnR.ok((revAsts(acc, ~), revDFors(facc, ~), true, v, env2)), },
    .err(e2) => DfnR.err(e2),
    _ => DfnR.err(e),
  } } else { DfnR.err(e) }
};
func boolScalar(v: array.Arr) -> Bool { v.kind == 1 and array.size(array.shape(v)) == 1 and isBool(array.first(v)) };
func dfnStmt(a: parse.Ast, f1: *, f2: *, env: Env) -> StepR {
  match a {
    .empty => StepR.next(env),
    .fassign(s) => StepR.next(putFnDef(env, s.nm, dfnOf(s.f))),
    .assign(s) => if s.nm == "⍺" and alphaBound(env) { StepR.next(env) }     // ⍺←X: a default, ignored when called dyadically (D-93)
      else { match bodyEv(a, f1, env) { .err(e) => StepR.err(e), .ok(r) => match r { (v, env2) => StepR.next(env2), }, } },
    .eguard(g) => match bodyEv(g.c, f1, env) {
      .err(e) => StepR.err(e),
      .ok(r) => match r { (cv, env2) => match natVec(cv) {
        (ok, codes) => if not ok { StepR.err(EErr( tag: "%domain-error", hint: "an error guard takes error numbers (D-94)" )) }
          else { StepR.armed((env2, Trap( set: true, codes: codes, e: g.e, f: f2, env: env2 ))) },
      }, },
    },
    .guard(g) => match bodyEv(g.c, f1, env) {
      .err(e) => StepR.err(e),
      .ok(r) => match r { (cv, env2) => if not boolScalar(cv) { StepR.err(EErr( tag: "%domain-error", hint: "a guard takes a scalar 0 or 1 (D-66)" )) }
        else if array.first(cv) == 1 { match bodyEv(g.e, f2, env2) { .err(e) => StepR.err(e), .ok(r2) => match r2 { (v, env3) => StepR.done((v, env3)), }, } }
        else { StepR.next(env2) }, },
    },
    .header(h) => StepR.err(EErr( tag: "%syntax-error", hint: "∇ opens no definition inside a dfn" )),
    .fnend => StepR.err(EErr( tag: "%syntax-error", hint: "∇ opens no definition inside a dfn" )),
    .cmd(c) => StepR.err(EErr( tag: "%syntax-error", hint: ") commands belong at the prompt" )),
    _ => match bodyEv(a, f1, env) {
      .err(e) => StepR.err(e),
      .ok(r) => match r { (v, env2) => if isAssign(a) { StepR.next(env2) } else { StepR.done((v, env2)) }, },
    },
  }
};

func runAll(ss: List<parse.Ast>, env: Env, acc: String) -> (String, Env) {
  match ss {
    (s, rest) => match runStmt(s, env) {
      (out, env2) => runAll(rest, env2, if out == "" { acc } else if acc == "" { out } else { acc + "\n" + out }),
    },
    _ => (acc, env),
  }
};

// --- inference (P7, D-53) --------------------------------------------------------------------------
// What the tree and the store signature say statically about a value: its
// kind (0 unknown) and its rank (valid when rknown). The emitter uses it to
// CHOOSE a specialised gate; every such gate re-checks at runtime and falls
// back to the generic path, so a wrong or missing inference costs speed, never
// a value (D-53).
func unknown() -> Info { Info( kind: 0, rank: 0, rknown: false ) };
func known(k: @, r: @) -> Info { Info( kind: k, rank: r, rknown: true ) };
func kindOnly(k: @) -> Info { Info( kind: k, rank: 0, rknown: false ) };
func monadKind(cp: @, k: @) -> @ {
  if k == 0 { 0 }
  else { match cp {
    8722 => array.maxk(k, 2),                            // − negate
    215  => if k == 1 { 1 } else { 2 },                  // × signum
    247  => 3, 8902 => 3, 9055 => 3, 9675 => 3,          // ÷ ⋆ ⍟ ○
    8968 => if k == 3 { 2 } else { k },                  // ⌈
    8970 => if k == 3 { 2 } else { k },                  // ⌊
    8764 => 1,                                           // ∼
    _    => k,                                           // + ∣ !
  } }
};
func dyadKind(cp: @, kl: @, kr: @) -> @ {
  if kl == 0 or kr == 0 or kl == 4 or kr == 4 { 0 }
  else { match cp {
    247 => 3, 9055 => 3, 9675 => 3, 8902 => 3,
    8722 => array.maxk(array.maxk(kl, kr), 2),
    60 => 1, 8804 => 1, 61 => 1, 8805 => 1, 62 => 1, 8800 => 1, 8744 => 1, 8743 => 1, 9073 => 1, 9074 => 1,
    _ => array.maxk(kl, kr),
  } }
};
func fnKind(f: parse.Fn, kl: @, kr: @) -> @ {
  match f {
    .prim(cp) => if isScalarFn(cp) { dyadKind(cp, kl, kr) } else { 0 },
    .each(g) => fnKind(g, kl, kr),
    .inner(i) => fnKind(i.f, fnKind(i.g, kl, kr), fnKind(i.g, kl, kr)),
    .outer(g) => fnKind(g, kl, kr),
    _ => 0,
  }
};
func inferK(a: parse.Ast, env: Env) -> Info {
  match a {
    .lit(l) => known(l.kind, if l.kind == 4 { if array.count(cps(litText(l))) == 1 { 0 } else { 1 } } else { if countS(l.vals) == 1 { 0 } else { 1 } }),
    .name(nm) => match lookupVar(env, nm) { (found, v) => if found { known(v.kind, array.rank(v)) } else { unknown() }, },
    .sysvar(nm) => known(1, 0),
    .assign(s) => inferK(s.v, env),
    .sysassign(s) => known(1, 0),
    .monad(m) => inferMonad(m.f, inferK(m.r, env)),
    .dyad(d) => inferDyad(d.f, inferK(d.l, env), inferK(d.r, env), d.l),
    .index(ix) => { let x = inferK(ix.a, env); Info( kind: x.kind, rank: 0, rknown: false ) },
    _ => unknown(),
  }
};
func litText(l: parse.Lit) -> String { match l.vals { (h, t) => h, _ => "", } };
func inferMonad(f: parse.Fn, x: Info) -> Info {
  match f {
    .prim(cp) => if isScalarMonad(cp) { Info( kind: monadKind(cp, x.kind), rank: x.rank, rknown: x.rknown ) }
      else { match cp {
        9075 => known(1, 1), 9076 => known(1, 1), 9035 => known(1, 1), 9042 => known(1, 1),   // ⍳ ⍴ ⍋ ⍒
        44 => Info( kind: x.kind, rank: 1, rknown: true ), 8714 => Info( kind: x.kind, rank: 1, rknown: true ),   // , ∊
        9021 => x, 8854 => x, 9033 => x, 8867 => x, 8866 => x,   // ⌽ ⊖ ⍉ ⊣ ⊢
        _ => unknown(),
      } },
    .reduce(g) => Info( kind: fnKind(g, x.kind, x.kind), rank: if x.rank == 0 { 0 } else { x.rank - 1 }, rknown: x.rknown ),
    .reduce1(g) => Info( kind: fnKind(g, x.kind, x.kind), rank: if x.rank == 0 { 0 } else { x.rank - 1 }, rknown: x.rknown ),
    .scan(g) => Info( kind: fnKind(g, x.kind, x.kind), rank: x.rank, rknown: x.rknown ),
    .scan1(g) => Info( kind: fnKind(g, x.kind, x.kind), rank: x.rank, rknown: x.rknown ),
    .each(g) => match g { .prim(cp) => if isScalarMonad(cp) { inferMonad(g, x) } else { unknown() }, _ => unknown(), },
    _ => unknown(),
  }
};
func inferDyad(f: parse.Fn, l: Info, r: Info, la: parse.Ast) -> Info {
  match f {
    .prim(cp) => if isScalarFn(cp) { Info( kind: dyadKind(cp, l.kind, r.kind), rank: array.maxk(l.rank, r.rank), rknown: l.rknown and r.rknown ) }
      else { match cp {
        9075 => Info( kind: 1, rank: r.rank, rknown: r.rknown ),           // A⍳B
        9076 => Info( kind: r.kind, rank: litCount(la), rknown: isLit(la) ),  // A⍴B
        9021 => r, 8854 => r, 47 => r, 92 => r,                             // rotate, replicate, expand
        8593 => Info( kind: r.kind, rank: 1, rknown: true ), 8595 => Info( kind: r.kind, rank: 1, rknown: true ),
        8714 => Info( kind: 1, rank: l.rank, rknown: l.rknown ),            // A∊B
        8869 => known(1, 0), 8868 => known(1, 1),                            // ⊥ ⊤
        8867 => l, 8866 => r,
        _ => unknown(),
      } },
    .inner(i) => Info( kind: fnKind(f, l.kind, r.kind), rank: (if l.rank == 0 { 0 } else { l.rank - 1 }) + (if r.rank == 0 { 0 } else { r.rank - 1 }), rknown: l.rknown and r.rknown ),
    .outer(g) => Info( kind: fnKind(g, l.kind, r.kind), rank: l.rank + r.rank, rknown: l.rknown and r.rknown ),
    .each(g) => match g { .prim(cp) => if isScalarFn(cp) { inferDyad(g, l, r, la) } else { unknown() }, _ => unknown(), },
    _ => unknown(),
  }
};
func isLit(a: parse.Ast) -> Bool { match a { .lit(l) => true, _ => false, } };
func litCount(a: parse.Ast) -> @ { match a { .lit(l) => countS(l.vals), _ => 0, } };
func countS(xs: List<String>) -> @ { match xs { (h, t) => 1 + countS(t), _ => 0, } };

// --- the runtime core (P5) ------------------------------------------------------------------------
// The emitter's formula runs over the subject [rt env], where rt is this
// tuple of gates in gateNames order; a call is `9 2` on the gate with its
// sample edited in (D-51). Every gate is TOTAL over Ev inputs: an error
// flows through unchanged, so the formula needs no branching.
func gateNames() -> List<String> {
  ["g-lit", "g-name", "g-nilad", "g-sys", "g-monad", "g-dyad", "g-assign", "g-sysassign", "g-index", "g-iassign", "g-env",
   "g-reduce", "g-arith", "g-mmul", "g-transpose", "g-reshape", "g-iota", "g-abs", "g-index1", "g-strand"]
};
func runtime() -> * { (gLit, gName, gNilad, gSys, gMonad, gDyad, gAssign, gSysassign, gIndex, gIassign, gEnv, gReduce, gArith, gMmul, gTranspose, gReshape, gIota, gAbs, gIndex1, gStrand) };

// --- the specialised gates (P7).  Each is used only where its result is
// bit-identical to the generic path, re-checks that at runtime, and
// otherwise falls back to the generic gate.  They are LINEAR passes over
// the ravel in Jock with the scalar operations the generic path uses: the
// generic path reaches Lagoon's +bin-op, which walks with +snag (quadratic),
// and Lagoon's reductions cost ~1.6 ms per element through +reel (S-22).
func numKind(a: array.Arr) -> Bool { a.kind == 1 or a.kind == 2 or a.kind == 3 };
func sameMeta(a: array.Arr, b: array.Arr) -> Bool { a.kind == b.kind and array.shape(a) == array.shape(b) };
func two64() -> @ { 18446744073709551616 };
// the scalar operations, per kind, exactly as the generic path computes them:
// naturals and two's-complement integers wrap at 64 bits (Lagoon's +fe and
// +twoc), reals round to nearest (the rd door at %n)
func addK(k: @, x: @, y: @) -> @ { if k == 3 { array.rop(1, x, y) } else { hoon.mod(x + y, two64()) } };
func subK(k: @, x: @, y: @) -> @ { if k == 3 { array.rop(2, x, y) } else { hoon.mod(x + (two64() - y), two64()) } };
func mulK(k: @, x: @, y: @) -> @ { if k == 3 { array.rop(3, x, y) } else { hoon.mod(x * y, two64()) } };
func maxK2(k: @, x: @, y: @) -> @ { if gtK(k, x, y) { x } else { y } };
func minK2(k: @, x: @, y: @) -> @ { if gtK(k, x, y) { y } else { x } };
// a right fold x1 f (x2 f (... xn)), as foldRight associates
func foldK(f: (@, @, @) -> @, k: @, vs: List<@>) -> @ {
  match array.revL(vs, ~) { (lst, restRev) => foldFrom(f, k, restRev, lst), _ => 0, }
};
func foldFrom(f: (@, @, @) -> @, k: @, restRev: List<@>, acc: @) -> @ {
  match restRev { (x, more) => foldFrom(f, k, more, f(k, x, acc)), _ => acc, }
};
func zipK(f: (@, @, @) -> @, k: @, xs: List<@>, ys: List<@>) -> List<@> { array.revL(zipKAcc(f, k, xs, ys, ~), ~) };
func zipKAcc(f: (@, @, @) -> @, k: @, xs: List<@>, ys: List<@>, acc: List<@>) -> List<@> {
  match xs { (x, xt) => match ys { (y, yt) => zipKAcc(f, k, xt, yt, (f(k, x, y), acc)), _ => acc, }, _ => acc, }
};
// the specialised gates run only at the default widths over 64-bit operands, where they are
// bit-identical to the generic path; otherwise each falls back through the dispatcher (D-15)
func plainEnv(env: Env) -> Bool { env.nb == 6 and env.ib == 6 and env.rb == 6 };
func plain1(env: Env, x: array.Arr) -> Bool { plainEnv(env) and array.bloqOf(x) == 6 };
func plain2(env: Env, x: array.Arr, y: array.Arr) -> Bool { plainEnv(env) and array.bloqOf(x) == 6 and array.bloqOf(y) == 6 };
// f/ on a non-empty rank-1 numeric array for + × ⌈ ⌊
func gReduce(cp: @, x: Ev) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env) =>
    if plain1(env, xv) and array.rank(xv) == 1 and numKind(xv) and array.size(array.shape(xv)) > 0 {
      let vs = array.vals(xv);
      match cp {
        43   => okv(sc(xv.kind, foldK(addK, xv.kind, vs)), env),
        215  => okv(sc(xv.kind, foldK(mulK, xv.kind, vs)), env),
        8968 => okv(sc(xv.kind, foldK(maxK2, xv.kind, vs)), env),
        8970 => okv(sc(xv.kind, foldK(minK2, xv.kind, vs)), env),
        _    => applyMonad(parse.Fn.reduce(parse.Fn.prim(cp)), xv, env),
      }
    } else { applyMonad(parse.Fn.reduce(parse.Fn.prim(cp)), xv, env) }, }, }
};
// + − × on two same-kind same-shape numeric arrays, one linear pass
func gArith(cp: @, l: Ev, r: Ev) -> Ev {
  match r { .err(e) => r, .ok(p) => match p { (rv, env1) => match l { .err(e2) => l, .ok(q) => match q { (lv, env2) =>
    if plain2(env2, lv, rv) and numKind(lv) and sameMeta(lv, rv) {
      let k = lv.kind;
      match cp {
        43  => okv(mk(k, array.shape(lv), zipK(addK, k, array.vals(lv), array.vals(rv))), env2),
        215 => okv(mk(k, array.shape(lv), zipK(mulK, k, array.vals(lv), array.vals(rv))), env2),
        _   => { let j = array.maxk(k, 2); okv(mk(j, array.shape(lv), zipK(subK, j, array.vals(lv), array.vals(rv))), env2) },
      }
    } else { applyDyad(parse.Fn.prim(cp), lv, rv, env2) }, }, }, }, }
};
// +.× on naturals or integers: a dot per (row, column), each a zip and a right fold
func gMmul(l: Ev, r: Ev) -> Ev {
  match r { .err(e) => r, .ok(p) => match p { (rv, env1) => match l { .err(e2) => l, .ok(q) => match q { (lv, env2) =>
    if plain2(env2, lv, rv) and lv.kind == rv.kind and (lv.kind == 1 or lv.kind == 2) {
      let k = lv.kind;
      if array.rank(lv) == 1 and array.rank(rv) == 1 and array.shape(lv) == array.shape(rv) and array.size(array.shape(lv)) > 0 {
        okv(sc(k, dotK(k, array.vals(lv), array.vals(rv))), env2)
      } else if array.rank(lv) == 2 and array.rank(rv) == 2 and array.lastDim(array.shape(lv)) == array.firstDim(array.shape(rv)) and array.size(array.shape(lv)) > 0 and array.size(array.shape(rv)) > 0 {
        let rows = array.chunks(array.vals(lv), array.lastDim(array.shape(lv)));
        let cols = array.colsOf(array.chunks(array.vals(rv), array.lastDim(array.shape(rv))), array.lastDim(array.shape(rv)), 0);
        okv(mk(k, [array.firstDim(array.shape(lv)), array.lastDim(array.shape(rv))], mmulK(k, rows, cols)), env2)
      } else { applyDyad(mmulFn(), lv, rv, env2) }
    } else { applyDyad(mmulFn(), lv, rv, env2) }, }, }, }, }
};
func mmulFn() -> parse.Fn { parse.Fn.inner(parse.Inner( f: parse.Fn.prim(43), g: parse.Fn.prim(215) )) };
func dotK(k: @, xs: List<@>, ys: List<@>) -> @ { foldK(addK, k, zipK(mulK, k, xs, ys)) };
func mmulK(k: @, rows: List<List<@>>, cols: List<List<@>>) -> List<@> {
  match rows { (r, rest) => array.catL(dotRow(k, r, cols), mmulK(k, rest, cols)), _ => ~, }
};
func dotRow(k: @, r: List<@>, cols: List<List<@>>) -> List<@> { match cols { (c, rest) => (dotK(k, r, c), dotRow(k, r, rest)), _ => ~, } };
func gTranspose(x: Ev) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env) =>
    if plain1(env, xv) and array.rank(xv) == 2 and array.size(array.shape(xv)) > 0 { okv(array.Arr( kind: xv.kind, ray: lagoon.transpose(xv.ray), items: xv.items ), env) }
    else { applyMonad(parse.Fn.prim(9033), xv, env) }, }, }
};
// A⍴B when the counts agree is a relabel of the same data
func gReshape(l: Ev, r: Ev) -> Ev {
  match r { .err(e) => r, .ok(p) => match p { (rv, env1) => match l { .err(e2) => l, .ok(q) => match q { (lv, env2) =>
    match natVec(lv) {
      (ok, shp) => if plain2(env2, lv, rv) and ok and array.size(shp) == array.size(array.shape(rv)) and array.size(shp) > 0 { okv(array.Arr( kind: rv.kind, ray: lagoon.reshape(rv.ray, shp), items: rv.items ), env2) }
        else { applyDyad(parse.Fn.prim(9076), lv, rv, env2) },
    }, }, }, }, }
};
// ⍳n from ⎕IO, by the interpreter's own tail-recursive builder
func gIota(x: Ev) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env) => match natArg(xv, "⍳") {
    (ok, n) => if ok and n > 0 {
      okv(vec(1, array.iotaL(n, env.io)), env)   // Lagoon's +iota builds through +gulf, a non-tail recursion that NockVM copies per frame (P11b)
    } else { applyMonad(parse.Fn.prim(9075), xv, env) }, }, }, }
};
func gAbs(x: Ev) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env) =>
    if plain1(env, xv) and (xv.kind == 2 or xv.kind == 3) and array.size(array.shape(xv)) > 0 { okv(array.Arr( kind: xv.kind, ray: lagoon.abs(xv.ray), items: ~ ), env) }
    else { applyMonad(parse.Fn.prim(8739), xv, env) }, }, }
};
// X[i] with one scalar index on a rank-1 array, through Lagoon's get-item
func gIndex1(x: Ev, parts: List<Part>) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env0) => match parts {
    (pt, rest) => match rest { (p2, r2) => gIndex(x, parts), _ => match pt {
      .ev(ie) => match ie { .ok(ir) => match ir { (iv, env) =>
        if array.bloqOf(xv) == 6 and array.rank(xv) == 1 and xv.kind != 5 and iv.kind == 1 and array.rank(iv) == 0 and array.first(iv) >= env.io and (array.first(iv) - env.io) < array.firstDim(array.shape(xv)) {
          okv(sc(xv.kind, lagoon.getitem(xv.ray, [array.first(iv) - env.io])), env)
        } else { gIndex(x, parts) }, }, _ => gIndex(x, parts), },
      _ => gIndex(x, parts),
    }, },
    _ => gIndex(x, parts),
  }, }, }
};
func gLit(l: parse.Lit, env: Env) -> Ev { litEv(l, env) };
func gName(nm: String, env: Env) -> Ev { evalAst(parse.Ast.name(nm), env) };
func gNilad(nm: String, env: Env) -> Ev { callUser(nm, false, false, array.scalar(1, 0), array.scalar(1, 0), env) };
func gSys(nm: String, env: Env) -> Ev { evalAst(parse.Ast.sysvar(nm), env) };
func gEnv(e: Ev, env: Env) -> Env { match e { .ok(r) => match r { (v, env2) => env2, }, .err(x) => env, } };
func gMonad(f: parse.Fn, r: Ev) -> Ev { match r { .err(e) => r, .ok(p) => match p { (rv, env) => applyMonad(f, rv, env), }, } };
// r was evaluated first, l against r's environment; l's environment is the latest
func gDyad(f: parse.Fn, l: Ev, r: Ev) -> Ev {
  match r { .err(e) => r, .ok(p) => match p { (rv, env1) => match l { .err(e2) => l, .ok(q) => match q { (lv, env2) => applyDyad(f, lv, rv, env2), }, }, }, }
};
func gAssign(nm: String, v: Ev) -> Ev { match v { .err(e) => v, .ok(p) => match p { (val, env) => okv(val, putVar(env, nm, val)), }, } };
func gSysassign(nm: String, v: Ev) -> Ev { match v { .err(e) => v, .ok(p) => match p { (val, env) => sysSet(nm, val, env), }, } };
// parts arrive evaluated, in order; the environment is the last part's (or x's)
func gIndex(x: Ev, parts: List<Part>) -> Ev {
  match x { .err(e) => x, .ok(p) => match p { (xv, env0) => match partsOf(parts, xv, lastEnv(parts, env0), ~, ~) {
    .err(e) => Ev.err(e),
    .ok(pr) => match pr { (pos, rshp, env) => indexed(xv, pos, rshp, env), },
  }, }, }
};
func gIassign(nm: String, parts: List<Part>, v: Ev) -> Ev {
  match v { .err(e) => v, .ok(p) => match p { (val, env0) => {
    let env1 = lastEnv(parts, env0);
    match lookupVar(env1, nm) {
      (found, x0) => if not found { fail("%value-error", nm + " is not defined") }
      else { match partsOf(parts, x0, env1, ~, ~) {
        .err(e) => Ev.err(e),
        .ok(pr) => match pr { (pos, rshp, env2) => match assignAt(x0, pos, val, env2) {
          .err(e) => Ev.err(e),
          .ok(r2) => match r2 { (x2, env3) => okv(val, putVar(env3, nm, x2)), },
        }, },
      } },
    }
  }, }, }
};
func lastEnv(parts: List<Part>, env: Env) -> Env {
  match parts { (p, rest) => lastEnv(rest, match p { .ev(e) => gEnv(e, env), .elide => env, }), _ => env, }
};
// the evaluated parts as positions and a result shape (the same rules as evalParts)
func partsOf(parts: List<Part>, x: array.Arr, env: Env, acc: List<List<@>>, shp: List<@>) -> Parts {
  match parts {
    (p, rest) => match p {
      .elide => {
        let n = array.nth(array.shape(x), array.countLL(acc));
        partsOf(rest, x, env, (array.iotaL(n, 0), acc), array.catL(shp, [n]))
      },
      .ev(e) => match e {
        .err(x2) => Parts.err(x2),
        .ok(r) => match r { (iv, env2) => if iv.kind != 1 { Parts.err(EErr( tag: "%domain-error", hint: "indices are non-negative integers" )) }
          else { partsOf(rest, x, env, (shiftIo(array.vals(iv), env.io), acc), array.catL(shp, array.shape(iv))) }, },
      },
    },
    _ => Parts.ok((revLL(acc, ~), shp, env)),
  }
};
// a strand's items as parts, the rightmost first (D-71): the vector in normal form
func gStrand(parts: List<Part>) -> Ev { strandVals(parts, ~, initial()) };
func strandVals(parts: List<Part>, acc: List<array.Arr>, env: Env) -> Ev {
  match parts {
    (p, rest) => match p {
      .ev(e) => match e { .err(x) => e, .ok(r) => match r { (v, env2) => strandVals(rest, (v, acc), env2), }, },
      .elide => strandVals(rest, acc, env),
    },
    _ => okv(array.normalize([array.countA(acc)], acc), env),
  }
};
func initial() -> Env { Env( store: ~, io: 1, pp: 10, fns: ~, phdr: noHeader(), pend: ~, out: ~, dfns: ~, frames: ~, nb: 6, ib: 6, rb: 6 ) };

// --- the emitter (P5): a statement to a Nockasm program over [rt env] ---------------------------
// (moved from emit.jock so that a tradfn body can be emitted and run from
// inside callUser, D-34; the import graph allows it nowhere else)
// --- builders ------------------------------------------------------------------------------
func ax(nm: String) -> Nasm { Nasm.axis(nm) };
func konst(n: *) -> Nasm { Nasm.op(("const", [Nasm.nock(n)])) };
func cel(xs: List<Nasm>) -> Nasm { Nasm.cell(xs) };
func lett(nm: String, v: Nasm, body: Nasm) -> Nasm { Nasm.bind((nm, v, body)) };
// slam the gate at the named leg with a sample:  9 2 on the gate with 6 edited (D-51)
func callG(g: String, sample: Nasm) -> Nasm {
  Nasm.op(("call", [Nasm.atom(2), Nasm.op(("edit", [Nasm.atom(6), sample, ax(g)]))]))
};
func tmp(n: @) -> String { "t{n}" };

// --- the subject schema --------------------------------------------------------------------
func rtSchema(names: List<String>) -> Sema {
  match names { (h, t) => match t { (h2, t2) => Sema.pair((Sema.leaf(h), rtSchema(t))), _ => Sema.leaf(h), }, _ => Sema.leaf("rt"), }
};
func schema() -> Sema { Sema.pair((rtSchema(gateNames()), Sema.leaf("env"))) };

// --- the emitter ------------------------------------------------------------------------------
// em(a, e, n): the program for a against environment name e, with n the
// next free temporary;  answers (program, next free temporary)
func isReduceFast(f: parse.Fn) -> (Bool, @) {
  match f { .reduce(g) => match g { .prim(cp) => (cp == 43 or cp == 215 or cp == 8968 or cp == 8970, cp), _ => (false, 0), }, _ => (false, 0), }
};
func isPlusTimes(f: parse.Fn) -> Bool {
  match f { .inner(i) => match i.f { .prim(a) => match i.g { .prim(b) => a == 43 and b == 215, _ => false, }, _ => false, }, _ => false, }
};
func primIs(f: parse.Fn, cp: @) -> Bool { match f { .prim(c) => c == cp, _ => false, } };
// the gate a monad lowers to, by inference (P7):  the generic g-monad unless a
// specialised gate's precondition is statically known
func monadGate(m: parse.Monad, env: Env) -> (String, Bool, @) {
  let x = inferK(m.r, env);
  match isReduceFast(m.f) {
    (fast, cp) => if fast and x.rknown and x.rank == 1 and (x.kind == 1 or x.kind == 2 or x.kind == 3) { ("g-reduce", true, cp) }
      else if primIs(m.f, 9033) and x.rknown and x.rank == 2 { ("g-transpose", false, 0) }
      else if primIs(m.f, 9075) and x.rknown and x.rank == 0 and x.kind == 1 { ("g-iota", false, 0) }
      else if primIs(m.f, 8739) and (x.kind == 2 or x.kind == 3) { ("g-abs", false, 0) }
      else { ("g-monad", false, 0) },
  }
};
func dyadGate(d: parse.Dyad, env: Env) -> String {
  let l = inferK(d.l, env);
  let r = inferK(d.r, env);
  match d.f {
    .prim(cp) => if (cp == 43 or cp == 8722 or cp == 215) and l.kind == r.kind and (l.kind == 1 or l.kind == 2 or l.kind == 3) and l.rknown and r.rknown and l.rank == r.rank { "g-arith" }
      else if cp == 9076 and isLit(d.l) { "g-reshape" }
      else { "g-dyad" },
    _ => if isPlusTimes(d.f) and l.kind == r.kind and (l.kind == 1 or l.kind == 2) { "g-mmul" } else { "g-dyad" },
  }
};
func em(a: parse.Ast, e: String, n: @, env: Env) -> (Nasm, @) {
  match a {
    .lit(l) => (callG("g-lit", cel([konst(l), ax(e)])), n),
    .name(nm) => (callG("g-name", cel([konst(nm), ax(e)])), n),
    .nilad(nm) => (callG("g-nilad", cel([konst(nm), ax(e)])), n),
    .sysvar(nm) => (callG("g-sys", cel([konst(nm), ax(e)])), n),
    .monad(m) => match em(m.r, e, n, env) {
      (r, n1) => match monadGate(m, env) {
        (g, withCp, cp) => if g == "g-monad" { (lett(tmp(n1), r, callG("g-monad", cel([konst(m.f), ax(tmp(n1))]))), n1 + 1) }
          else if withCp { (lett(tmp(n1), r, callG(g, cel([konst(cp), ax(tmp(n1))]))), n1 + 1) }
          else { (lett(tmp(n1), r, callG(g, ax(tmp(n1)))), n1 + 1) },
      },
    },
    .dyad(d) => match em(d.r, e, n, env) {
      (r, n1) => {
        let rn = tmp(n1);
        let en = tmp(n1 + 1);
        match em(d.l, en, n1 + 2, env) {
          (l, n2) => {
            let ln = tmp(n2);
            let g = dyadGate(d, env);
            let call = if g == "g-dyad" { callG("g-dyad", cel([konst(d.f), ax(ln), ax(rn)])) }
              else if g == "g-arith" { callG("g-arith", cel([konst(fnCp(d.f)), ax(ln), ax(rn)])) }
              else { callG(g, cel([ax(ln), ax(rn)])) };
            (lett(rn, r, lett(en, callG("g-env", cel([ax(rn), ax(e)])), lett(ln, l, call))), n2 + 1)
          },
        }
      },
    },
    .assign(s) => match em(s.v, e, n, env) {
      (v, n1) => (lett(tmp(n1), v, callG("g-assign", cel([konst(s.nm), ax(tmp(n1))]))), n1 + 1),
    },
    .sysassign(s) => match em(s.v, e, n, env) {
      (v, n1) => (lett(tmp(n1), v, callG("g-sysassign", cel([konst(s.nm), ax(tmp(n1))]))), n1 + 1),
    },
    .index(ix) => match em(ix.a, e, n, env) {
      (x, n1) => {
        let xn = tmp(n1);
        let en = tmp(n1 + 1);
        let g = if oneScalarPart(ix.ix, env) and inferK(ix.a, env).rknown and inferK(ix.a, env).rank == 1 { "g-index1" } else { "g-index" };
        match emParts(ix.ix, en, n1 + 2, ~, env) {
          (parts, binds, n2) => (lett(xn, x, lett(en, callG("g-env", cel([ax(xn), ax(e)])), wrap(binds, callG(g, cel([ax(xn), listOf(parts)]))))), n2),
        }
      },
    },
    .iassign(s) => match em(s.v, e, n, env) {
      (v, n1) => {
        let vn = tmp(n1);
        let en = tmp(n1 + 1);
        match emParts(s.ix, en, n1 + 2, ~, env) {
          (parts, binds, n2) => (lett(vn, v, lett(en, callG("g-env", cel([ax(vn), ax(e)])), wrap(binds, callG("g-iassign", cel([konst(s.nm), listOf(parts), ax(vn)]))))), n2),
        }
      },
    },
    .strand(xs) => match emParts(revAsts(xs, ~), e, n, ~, env) {
      (parts, binds, n2) => (wrap(binds, callG("g-strand", listOf(parts))), n2),
    },
    _ => (konst(Ev.err(EErr( tag: "%unimplemented", hint: "not an emitted form" ))), n),
  }
};
// index parts in order, each against the environment the previous one left:
// answers (the Part expressions, the (name, program) bindings to wrap, next temporary)
func fnCp(f: parse.Fn) -> @ { match f { .prim(cp) => cp, _ => 0, } };
func oneScalarPart(ixs: List<parse.Ast>, env: Env) -> Bool {
  match ixs { (ix, rest) => match rest { (i2, r2) => false, _ => { let i = inferK(ix, env); i.rknown and i.rank == 0 and i.kind == 1 }, }, _ => false, }
};
func emParts(ixs: List<parse.Ast>, e: String, n: @, acc: List<(String, Nasm)>, env: Env) -> (List<Nasm>, List<(String, Nasm)>, @) {
  match ixs {
    (ix, rest) => match ix {
      .elide => match emParts(rest, e, n, acc, env) { (ps, bs, n2) => ((konst(Part.elide), ps), bs, n2), },
      _ => match em(ix, e, n, env) {
        (p, n1) => {
          let pn = tmp(n1);
          let en = tmp(n1 + 1);
          match emParts(rest, en, n1 + 2, ((en, callG("g-env", cel([ax(pn), ax(e)]))), ((pn, p), acc)), env) {
            (ps, bs, n2) => ((cel([konst(%ev), ax(pn)]), ps), bs, n2),
          }
        },
      },
    },
    _ => (~, acc, n),
  }
};
// bindings accumulate newest-first; wrap applies them outermost-first
func wrap(binds: List<(String, Nasm)>, body: Nasm) -> Nasm {
  match binds { ((nm, v), rest) => wrap(rest, lett(nm, v, body)), _ => body, }
};
// a null-terminated list of the part expressions
func listOf(ps: List<Nasm>) -> Nasm { cel(snocN(ps, konst(0))) };   // a FORMULA for the null: a raw atom would land in formula position
func snocN(xs: List<Nasm>, x: Nasm) -> List<Nasm> { match xs { (h, t) => (h, snocN(t, x)), _ => [x], } };

func emittable(a: parse.Ast) -> Bool {
  match a {
    .lit(l) => true, .name(nm) => true, .nilad(nm) => true, .sysvar(nm) => true, .monad(m) => true, .dyad(d) => true,
    .assign(s) => true, .sysassign(s) => true, .index(ix) => true, .iassign(s) => true, .strand(xs) => true,
    _ => false,
  }
};
func compile(a: parse.Ast, env: Env) -> Nasm { match em(a, "env", 0, env) { (prog, n) => prog, } };
func lower(a: parse.Ast, env: Env) -> * { nasm.lower((0, schema()), compile(a, env)) };
func render(a: parse.Ast, env: Env) -> String { nasm.render((0, schema()), compile(a, env)) };
// the lowered formula as a noun, for the emission goldens: `[a b c]` right-nested, atoms decimal
func showNoun(n: *) -> String { if hoon.iscell(n) { "[" + showCell(n) + "]" } else { "{n as! @}" } };
func showCell(n: *) -> String {
  match n { (h, t) => if hoon.iscell(t) { showNoun(h) + " " + showCell(t) } else { showNoun(h) + " " + showNoun(t) }, _ => "", }
};
func lowerText(a: parse.Ast, env: Env) -> String { showNoun(lower(a, env)) };
// run one statement's program over [rt env]
func run(a: parse.Ast, env: Env) -> Ev {
  eval((runtime(), env), lower(a, env)) as! Ev
};
