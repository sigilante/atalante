// atl.jock — the Atalante session entry.
//
// `session` takes the lines of one corpus case (tests/atl/README.md) and
// answers one output record per input line, records separated by \1e
// (RS). `corpus` runs several cases and separates them with \1d (GS),
// the case name first, then \1f (US), then the session's records.
// tools/atlc.py splits them. The red prompt runs interp.jock (P3) over
// the array model in array.jock; the green prompt prints the tree.
import lexer;
import parse;
import interp;
import array;

// --- the session ----------------------------------------------------------------
// A session threads a SIGNATURE (name -> class, parse.jock's convention)
// and a definition-mode flag (D-62). Every line is parsed against the
// signature; an assignment binds its name as an array, a dfn assignment
// binds an ambivalent function, and a ∇ header binds its function by
// valence (D-52, D-68). The green prompt `🍏>` prints the tree (D-54);
// the red prompt `🍎>`, or no prompt, evaluates. A line whose braces do
// not close is held, with the lines after it, until they do (D-69):
// `open` is that token run, `depth` its net brace depth, and `omode` the
// mode of its first line (0 red, 1 green, 2 :nock, 3 :noun).
struct Sess { sig: List<(String, @)>, defn: Bool, env: interp.Env, green: Bool, open: List<lexer.Token>, depth: @, omode: @, path: @, ascii: Bool };

func mk(sig: List<(String, @)>, defn: Bool, env: interp.Env, green: Bool) -> Sess {
  Sess( sig: sig, defn: defn, env: env, green: green, open: ~, depth: 0, omode: 0, path: 0, ascii: false )
};
// the same, keeping the evaluation path of `s` (0 both, 1 interpreter, 2 emitter; `)PATH`)
// the host's entropy into the session's stream, every other field kept (D-104)
func seedSess(s: Sess, eny: @) -> Sess {
  Sess( sig: s.sig, defn: s.defn, env: interp.seedHost(s.env, eny), green: s.green, open: s.open, depth: s.depth, omode: s.omode, path: s.path, ascii: s.ascii )
};
func mks(s: Sess, sig: List<(String, @)>, defn: Bool, env: interp.Env, green: Bool) -> Sess {
  Sess( sig: sig, defn: defn, env: env, green: green, open: ~, depth: 0, omode: 0, path: s.path, ascii: s.ascii )
};
func binds(a: parse.Ast, sig: List<(String, @)>) -> List<(String, @)> { parse.binds(a, sig) };
func isHeader(a: parse.Ast) -> Bool { match a { .header(h) => true, _ => false, } };
func isFnend(a: parse.Ast) -> Bool { match a { .fnend => true, _ => false, } };
// a body line that is exactly ∇ closes the definition (D-62)
func isLoneDel(ts: List<lexer.Token>) -> Bool {
  match ts { (t, rest) => match rest { (t2, r2) => false, _ => match t.kind { .del => true, _ => false, }, }, _ => false, }
};
func dropN(cs: List<UniChar>, n: @) -> List<UniChar> {
  if n == 0 { cs } else { match cs { (h, t) => dropN(t, n - 1), _ => ~, } }
};
func stripPrompt(line: String) -> String { utf8(dropN(line.chars(), 2)).trim() };

func catT(a: List<lexer.Token>, b: List<lexer.Token>) -> List<lexer.Token> { match a { (h, t) => (h, catT(t, b)), _ => b, } };
func nlTok() -> lexer.Token { lexer.Token( kind: lexer.Kind.nl, text: "", cp: 0, col: 0 ) };
func modeOf(green: Bool, nock: Bool, noun: Bool) -> @ { if nock { 2 } else if noun { 3 } else if green { 1 } else { 0 } };

// one line: (what it prints, the session after it)
func stepLine(line: String, s: Sess) -> (String, Sess) {
  let green = line.starts-with("🍏>") or (s.green and not line.starts-with("🍎>"));
  let red = line.starts-with("🍎>");
  let src0 = if line.starts-with("🍏>") or red { stripPrompt(line) } else { line };
  let nock = green and src0.starts-with(":nock ");
  let noun = green and src0.starts-with(":noun ");
  let typed = if nock or noun { utf8(dropN(src0.chars(), 6)).trim() } else { src0 };
  // under )ASCII ON the line is rewritten to glyphs, its tokens keeping the typed columns (D-8)
  let src = if s.ascii { match lexer.asciiLine(typed) { (g, cols) => g, } } else { typed };
  let lexed = if s.ascii { lexer.asciiTokens(typed) } else { lexer.tokens(typed) };
  if s.defn {
    match lexed {
      .ok(ts) => if isLoneDel(ts) { ("", mks(s, s.sig, false, interp.defineEnd(s.env), s.green)) }
        else { ("", mks(s, s.sig, true, interp.defineLine(src, s.env), s.green)) },
      .err(e) => ("", mks(s, s.sig, true, interp.defineLine(src, s.env), s.green)),
    }
  } else {
    match lexed {
      .err(e) => (e.tag + " col:{e.col} " + e.hint, mks(s, s.sig, false, s.env, s.green)),
      .ok(ts) => {
        let depth = parse.braceDepth(ts, s.depth);
        let all = if s.depth == 0 { ts } else { catT(s.open, (nlTok(), ts)) };
        let mode = if s.depth == 0 { modeOf(green, nock, noun) } else { s.omode };
        if depth > 0 { ("", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: all, depth: depth, omode: mode, path: s.path, ascii: s.ascii )) }
        else { stepToks(all, mode, mks(s, s.sig, false, s.env, s.green)) }
      },
    }
  }
};
// one statement's tokens, braces closed, in the mode of its first line
func stepToks(ts: List<lexer.Token>, mode: @, s: Sess) -> (String, Sess) {
  let green = mode != 0;
  let nock = mode == 2;
  let noun = mode == 3;
  match parse.parseToks(ts, s.sig) {
    .err(e) => (e.tag + " col:{e.col} " + e.hint, s),
    .ok(a) => match a {
      .header(h) => (if green { parse.showAst(a) } else { "" }, mks(s, binds(a, s.sig), true, interp.defineStart(h, s.env), s.green)),
      .cmd(c) => if c.nm == "GREEN" { ("🍏", mks(s, s.sig, false, s.env, true)) }
        else if c.nm == "RED" { ("🍎", mks(s, s.sig, false, s.env, false)) }
        else if c.nm == "PATH" { match c.args {
          (h, rest) => if h == "BOTH" { ("path BOTH", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: ~, depth: 0, omode: 0, path: 0, ascii: s.ascii )) }
            else if h == "INTERP" { ("path INTERP", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: ~, depth: 0, omode: 0, path: 1, ascii: s.ascii )) }
            else if h == "EMIT" { ("path EMIT", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: ~, depth: 0, omode: 0, path: 2, ascii: s.ascii )) }
            else { ("%syntax-error )PATH takes BOTH, INTERP or EMIT", s) },
          _ => (if s.path == 1 { "path INTERP" } else if s.path == 2 { "path EMIT" } else { "path BOTH" }, s),
        } }
        else if c.nm == "ASCII" { match c.args {
          (h, rest) => if h == "ON" { ("ascii ON", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: ~, depth: 0, omode: 0, path: s.path, ascii: true )) }
            else if h == "OFF" { ("ascii OFF", Sess( sig: s.sig, defn: false, env: s.env, green: s.green, open: ~, depth: 0, omode: 0, path: s.path, ascii: false )) }
            else { ("%syntax-error )ASCII takes ON or OFF", s) },
          _ => (if s.ascii { "ascii ON" } else { "ascii OFF" }, s),
        } }
        else if c.nm == "DISPLAY" { match c.args {
          (h, rest) => if h == "APL2" { ("display APL2", mks(s, s.sig, false, interp.setDm(s.env, 1), s.green)) }
            else if h == "STRAND" { ("display STRAND", mks(s, s.sig, false, interp.setDm(s.env, 0), s.green)) }
            else { ("%syntax-error )DISPLAY takes STRAND or APL2", s) },
          _ => (if s.env.dm == 1 { "display APL2" } else { "display STRAND" }, s),
        } }
        else if c.nm == "TOGGLE" { (if s.green { "🍎" } else { "🍏" }, mks(s, s.sig, false, s.env, not s.green)) }
        else { match interp.runStmt(a, s.env) { (out, env2) => (out, mks(s, sigOf(env2), false, env2, s.green)), } },
      _ => if green { (if nock { interp.render(a, s.env).trim() } else if noun { interp.lowerText(a, s.env) } else { parse.showAst(a) }, mks(s, binds(a, s.sig), false, s.env, s.green)) }
        else {
          if s.path == 1 { match interp.runStmt(a, s.env) { (out, env2) => (out, mks(s, sigOf(env2), false, env2, s.green)), } }
          else if s.path == 2 { match emitted(a, s.env) { (out, env2) => (out, mks(s, sigOf(env2), false, env2, s.green)), } }
          else { match interp.runStmt(a, s.env) {
            (out, env2) => match emitted(a, s.env) {
              (out2, env3) => if out == out2 and env2 == env3 { (out, mks(s, sigOf(env2), false, env2, s.green)) }
                else { ("%emit-mismatch interpreter: " + out + " | emitter: " + out2, mks(s, sigOf(env2), false, env2, s.green)) },
            },
          } }
        },
    },
  }
};
// the same statement through the emitter: compiled, lowered, run, then
// finished by the interpreter's own printing rule;  a ⋄ line statement by
// statement;  forms the emitter does not cover reuse the interpreter
func emitted(a: parse.Ast, env: interp.Env) -> (String, interp.Env) {
  match a {
    .stmts(ss) => emittedAll(ss, env, ""),
    _ => if interp.emittable(a) { interp.finish(a, interp.run(a, env), env) } else { interp.runStmt(a, env) },
  }
};
func emittedAll(ss: List<parse.Ast>, env: interp.Env, acc: String) -> (String, interp.Env) {
  match ss {
    (st, rest) => match emitted(st, env) {
      (out, env2) => emittedAll(rest, env2, if out == "" { acc } else if acc == "" { out } else { acc + "\n" + out }),
    },
    _ => (acc, env),
  }
};
func sessionFrom(lines: List<String>, s: Sess) -> String {
  match lines {
    (h, t) => match stepLine(h, s) {
      (out, s2) => match t {
        (h2, t2) => out + "\1e" + sessionFrom(t, s2),
        _ => out,
      },
    },
    _ => "",
  }
};
func initialSess() -> Sess { mk(~, false, interp.initial(), false) };
// the parser's signature from the environment (after )ERASE the two must agree)
func sigOf(env: interp.Env) -> List<(String, @)> { interp.sigOf(env) };
func session(lines: List<String>) -> String { sessionFrom(lines, initialSess()) };

// bench (plan P7): a statement over v ← ⍳n, through the generic interpreter or through the
// emitted formula alone --- no differential, so one path's cost is measured; an empty
// statement is the BASELINE (the setup alone: building v costs ~40 s at 1e5 under NockVM)
func bench(n: @, emitted: Bool, stmt: String) -> String {
  let v = array.make(1, [n], array.iotaL(n, 1));
  let env = interp.setStore(interp.initial(), interp.put(~, "v", v));
  if stmt == "" { "setup" } else {
    match parse.parseLine(stmt, [("v", 1)]) {
      .ok(a) => match (if emitted { interp.finish(a, interp.run(a, env), env) } else { interp.runStmt(a, env) }) { (out, env2) => out, },
      .err(e) => e.tag,
    }
  }
};

// the lex corpus (tests/lex): one token dump per input line
func lexLines(lines: List<String>) -> String {
  match lines {
    (h, t) => match t {
      (h2, t2) => lexer.dump(h) + "\1e" + lexLines(t),
      _ => lexer.dump(h),
    },
    _ => "",
  }
};
func lexcorpus(cases: List<(String, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, lines) => "\1d" + name + "\1f" + lexLines(lines) + lexcorpus(rest),
    },
    _ => "",
  }
};
// the parse corpus (tests/parse): one tree per input line, under a signature
func parseLines(sig: List<(String, @)>, lines: List<String>) -> String {
  match lines {
    (h, t) => match t {
      (h2, t2) => parse.dump(h, sig) + "\1e" + parseLines(sig, t),
      _ => parse.dump(h, sig),
    },
    _ => "",
  }
};
func parsecorpus(cases: List<(String, List<(String, @)>, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, sig, lines) => "\1d" + name + "\1f" + parseLines(sig, lines) + parsecorpus(rest),
    },
    _ => "",
  }
};
func corpus(cases: List<(String, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, lines) => "\1d" + name + "\1f" + session(lines) + corpus(rest),
    },
    _ => "",
  }
};
