// atl.jock — the Atalante session entry.
//
// `session` takes the lines of one corpus case (tests/atl/README.md) and
// answers one output record per input line, records separated by \1e
// (RS). `corpus` runs several cases and separates them with \1d (GS),
// the case name first, then \1f (US), then the session's records.
// tools/atlc.py splits them. The red prompt runs interp.jock (P3) over
// the array model in array.jock; the green prompt prints the tree.
import lexer;
import parse;
import interp;
import emit;

// --- the session ----------------------------------------------------------------
// A session threads a SIGNATURE (name -> class, parse.jock's convention)
// and a definition-mode flag (D-62). Every line is parsed against the
// signature; an assignment binds its name as an array and a ∇ header
// binds its function by valence (D-52). The green prompt `🍏>` prints
// the tree (D-54); the red prompt `🍎>`, or no prompt, evaluates.
struct Sess { sig: List<(String, @)>, defn: Bool, env: interp.Env };

func bind(sig: List<(String, @)>, nm: String, c: @) -> List<(String, @)> {
  match sig {
    ((n, k), t) => if n == nm { ((nm, c), t) } else { ((n, k), bind(t, nm, c)) },
    _ => [(nm, c)],
  }
};
func headerClass(h: parse.Header) -> @ { interp.headerClass(h) };
func bindsAll(xs: List<parse.Ast>, sig: List<(String, @)>) -> List<(String, @)> {
  match xs { (h, t) => bindsAll(t, binds(h, sig)), _ => sig, }
};
func binds(a: parse.Ast, sig: List<(String, @)>) -> List<(String, @)> {
  match a {
    .assign(s) => binds(s.v, bind(sig, s.nm, 1)),
    .iassign(s) => binds(s.v, bindsAll(s.ix, sig)),
    .sysassign(s) => binds(s.v, sig),
    .monad(m) => binds(m.r, sig),
    .dyad(d) => binds(d.l, binds(d.r, sig)),
    .index(ix) => bindsAll(ix.ix, binds(ix.a, sig)),
    .stmts(ss) => bindsAll(ss, sig),
    .header(h) => bind(sig, h.nm, headerClass(h)),
    _ => sig,
  }
};
func isHeader(a: parse.Ast) -> Bool { match a { .header(h) => true, _ => false, } };
func isFnend(a: parse.Ast) -> Bool { match a { .fnend => true, _ => false, } };
// a body line that is exactly ∇ closes the definition (D-62)
func isLoneDel(ts: List<lexer.Token>) -> Bool {
  match ts { (t, rest) => match rest { (t2, r2) => false, _ => match t.kind { .del => true, _ => false, }, }, _ => false, }
};
func dropN(cs: List<UniChar>, n: @) -> List<UniChar> {
  if n == 0 { cs } else { match cs { (h, t) => dropN(t, n - 1), _ => ~, } }
};
func stripPrompt(line: String) -> String { utf8(dropN(line.chars(), 2)).trim() };

// one line: (what it prints, the session after it)
func stepLine(line: String, s: Sess) -> (String, Sess) {
  let green = line.starts-with("🍏>");
  let red = line.starts-with("🍎>");
  let src0 = if green or red { stripPrompt(line) } else { line };
  let nock = green and src0.starts-with(":nock ");
  let noun = green and src0.starts-with(":noun ");
  let src = if nock or noun { utf8(dropN(src0.chars(), 6)).trim() } else { src0 };
  if s.defn {
    match lexer.tokens(src) {
      .ok(ts) => if isLoneDel(ts) { ("", Sess( sig: s.sig, defn: false, env: interp.defineEnd(s.env) )) }
        else { ("", Sess( sig: s.sig, defn: true, env: interp.defineLine(src, s.env) )) },
      .err(e) => ("", Sess( sig: s.sig, defn: true, env: interp.defineLine(src, s.env) )),
    }
  } else {
    match parse.parseLine(src, s.sig) {
      .err(e) => (e.tag + " col:{e.col} " + e.hint, s),
      .ok(a) => match a {
        .header(h) => (if green { parse.showAst(a) } else { "" }, Sess( sig: binds(a, s.sig), defn: true, env: interp.defineStart(h, s.env) )),
        _ => if green { (if nock { emit.render(a).trim() } else if noun { emit.lowerText(a) } else { parse.showAst(a) }, Sess( sig: binds(a, s.sig), defn: false, env: s.env )) }
          else {
            match interp.runStmt(a, s.env) {
              (out, env2) => match emitted(a, s.env) {
                (out2, env3) => if out == out2 and env2 == env3 { (out, Sess( sig: binds(a, s.sig), defn: false, env: env2 )) }
                  else { ("%emit-mismatch interpreter: " + out + " | emitter: " + out2, Sess( sig: binds(a, s.sig), defn: false, env: env2 )) },
              },
            }
          },
      },
    }
  }
};
// the same statement through the emitter: compiled, lowered, run, then
// finished by the interpreter's own printing rule;  a ⋄ line statement by
// statement;  forms the emitter does not cover reuse the interpreter
func emitted(a: parse.Ast, env: interp.Env) -> (String, interp.Env) {
  match a {
    .stmts(ss) => emittedAll(ss, env, ""),
    _ => if emit.emittable(a) { interp.finish(a, emit.run(a, env), env) } else { interp.runStmt(a, env) },
  }
};
func emittedAll(ss: List<parse.Ast>, env: interp.Env, acc: String) -> (String, interp.Env) {
  match ss {
    (st, rest) => match emitted(st, env) {
      (out, env2) => emittedAll(rest, env2, if out == "" { acc } else if acc == "" { out } else { acc + "\n" + out }),
    },
    _ => (acc, env),
  }
};
func sessionFrom(lines: List<String>, s: Sess) -> String {
  match lines {
    (h, t) => match stepLine(h, s) {
      (out, s2) => match t {
        (h2, t2) => out + "\1e" + sessionFrom(t, s2),
        _ => out,
      },
    },
    _ => "",
  }
};
func session(lines: List<String>) -> String { sessionFrom(lines, Sess( sig: ~, defn: false, env: interp.initial() )) };

// the lex corpus (tests/lex): one token dump per input line
func lexLines(lines: List<String>) -> String {
  match lines {
    (h, t) => match t {
      (h2, t2) => lexer.dump(h) + "\1e" + lexLines(t),
      _ => lexer.dump(h),
    },
    _ => "",
  }
};
func lexcorpus(cases: List<(String, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, lines) => "\1d" + name + "\1f" + lexLines(lines) + lexcorpus(rest),
    },
    _ => "",
  }
};
// the parse corpus (tests/parse): one tree per input line, under a signature
func parseLines(sig: List<(String, @)>, lines: List<String>) -> String {
  match lines {
    (h, t) => match t {
      (h2, t2) => parse.dump(h, sig) + "\1e" + parseLines(sig, t),
      _ => parse.dump(h, sig),
    },
    _ => "",
  }
};
func parsecorpus(cases: List<(String, List<(String, @)>, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, sig, lines) => "\1d" + name + "\1f" + parseLines(sig, lines) + parsecorpus(rest),
    },
    _ => "",
  }
};
func corpus(cases: List<(String, List<String>)>) -> String {
  match cases {
    (c, rest) => match c {
      (name, lines) => "\1d" + name + "\1f" + session(lines) + corpus(rest),
    },
    _ => "",
  }
};
