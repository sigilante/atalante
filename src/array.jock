// array.jock — the ATL array model over Lagoon rays (D-10..D-13, D-25, D-45, D-70, D-76, D-77).
//
// An ATL array is a Lagoon ray plus ATL's own kind tag: 1 nat, 2 int,
// 3 real, 4 char (D-10), 5 box (D-70). The ray's kind carries the storage
// class (%uint, %int2, %i754 --- chars are %uint codepoints) and every ray
// is bloq 6, so promotion between kinds (D-11) never changes the width.
// A box is the INDEX RAY of its shape (a %uint ray numbering its elements
// 1..n in ravel order, 0 standing for a fill) over `items`, the elements
// themselves in ravel order; a simple array has no items. A structural
// function runs on the index ray as on any natural array and `regather`
// turns the moved numbers back into elements (D-72).
// Lagoon is reached through the `lagoon` package (pkg/lagoon-core.hoon):
// construction, reading back, and the same-shape elementwise arms;
// scalar extension (D-25), the kind lattice and display (D-45) are
// ATL's and live here.
import lagoon;

struct Arr { kind: @, ray: lagoon.Ray, items: List<Arr> };

// --- construction and reading --------------------------------------------------
func lagKind(k: @) -> Term { match k { 2 => %int2, 3 => %i754, _ => %uint, } };
func metaOf(k: @, shp: List<@>) -> lagoon.Meta { metaB(k, 6, shp) };
func metaB(k: @, b: @, shp: List<@>) -> lagoon.Meta { lagoon.Meta( shape: shp, bloq: b, kind: lagKind(k), tail: 0 ) };
// Naturals and integers are built at 64 bits, the computing width; reals at the width their
// values carry (D-15: a real of another width than 64 travels tagged, see `tagged` below)
func make(k: @, shp: List<@>, vs: List<@>) -> Arr {
  if k == 3 and not allRaw(vs) { makeReal(maxTagW(vs, 0), shp, vs) } else { Arr( kind: k, ray: lagoon.from(metaOf(k, shp), vs), items: ~ ) }
};
func allRaw(vs: List<@>) -> Bool { match vs { (v, t) => if v < two128() { allRaw(t) } else { false }, _ => true, } };
// at bloq b: naturals and integers wrap to it (Lagoon's +rep keeps each element's low bits)
func makeB(k: @, b: @, shp: List<@>, vs: List<@>) -> Arr {
  if k == 3 { makeReal(b, shp, vs) } else { Arr( kind: k, ray: lagoon.from(metaB(k, b, shp), vs), items: ~ ) }
};
// a real array at width w:  every value converted to w and stored untagged
func makeReal(w: @, shp: List<@>, vs: List<@>) -> Arr { Arr( kind: 3, ray: lagoon.from(metaB(3, w, shp), rawsAt(vs, w, ~)), items: ~ ) };
func rawsAt(vs: List<@>, w: @, acc: List<@>) -> List<@> { match vs { (v, t) => rawsAt(t, w, (rawAt(v, w), acc)), _ => revL(acc, ~), } };
func scalar(k: @, v: @) -> Arr { make(k, ~, [v]) };
func shape(a: Arr) -> List<@> { a.ray.meta.shape };
func vals(a: Arr) -> List<@> {
  let b = a.ray.meta.bloq;
  if b == 6 or a.kind == 1 or a.kind == 4 or a.kind == 5 { lagoon.ravel(a.ray) }
  else if a.kind == 2 { sextAll(lagoon.ravel(a.ray), b, ~) }
  else { tagAll(lagoon.ravel(a.ray), b, ~) }
};
func bloqOf(a: Arr) -> @ { a.ray.meta.bloq };
// an integer stored in 2^b bits, read as 64-bit two's complement (the computing width)
func sextAll(xs: List<@>, b: @, acc: List<@>) -> List<@> { match xs { (x, t) => sextAll(t, b, (sext(x, b), acc)), _ => revL(acc, ~), } };
func sext(x: @, b: @) -> @ { let bits = pow2(pow2(b)); if x >= bits / 2 { x + (two64() - bits) } else { x } };
func pow2(n: @) -> @ { if n == 0 { 1 } else { 2 * pow2(n - 1) } };
func two64() -> @ { 18446744073709551616 };
func tagAll(xs: List<@>, w: @, acc: List<@>) -> List<@> { match xs { (x, t) => tagAll(t, w, (tagged(w, x), acc)), _ => revL(acc, ~), } };
func count(xs: List<@>) -> @ { match xs { (h, t) => 1 + count(t), _ => 0, } };
func size(shp: List<@>) -> @ { match shp { (h, t) => h * size(t), _ => 1, } };
func rank(a: Arr) -> @ { count(shape(a)) };
func first(a: Arr) -> @ { match vals(a) { (h, t) => h, _ => 0, } };

// --- real widths (D-15) ---------------------------------------------------------
// A real value in the interpreter is the bits of its width, and a width other than 64
// travels with it: bits + c·2^128, c = 1 half, 2 single, 3 quad. A 64-bit real is its bare
// bits, so every path at the default width reads exactly what it read before.
func two128() -> @ { 340282366920938463463374607431768211456 };
func tagCode(w: @) -> @ { if w == 4 { 1 } else if w == 5 { 2 } else if w == 7 { 3 } else { 0 } };
func widthOf(x: @) -> @ { let c = x / two128(); if c == 1 { 4 } else if c == 2 { 5 } else if c == 3 { 7 } else { 6 } };
func rawOf(x: @) -> @ { x % two128() };
func tagged(w: @, raw: @) -> @ { raw + tagCode(w) * two128() };
// x's bits at width w (rounded to nearest-even when narrowing, exact when widening)
func rawAt(x: @, w: @) -> @ { let v = widthOf(x); if v == w { rawOf(x) } else { lagoon.fconv(v, w, rawOf(x)) } };
func toWidth(x: @, w: @) -> @ { tagged(w, rawAt(x, w)) };
// not ±infinity or NaN:  the exponent field is not all ones (half 5 bits over 10, single 8 over
// 23, double 11 over 52, quad 15 over 112)
func finite(x: @) -> Bool {
  let w = widthOf(x);
  let mb = if w == 4 { 10 } else if w == 5 { 23 } else if w == 7 { 112 } else { 52 };
  let eb = if w == 4 { 5 } else if w == 5 { 8 } else if w == 7 { 15 } else { 11 };
  let top = pow2(eb) - 1;
  ((rawOf(x) / pow2(mb)) % pow2(eb)) != top
};
// +0 is all-zero bits at every width, so a bare 0 (a fill, a computed zero) sets no width
func maxTagW(vs: List<@>, m: @) -> @ { match vs { (v, t) => maxTagW(t, if v == 0 { m } else { maxW(m, widthOf(v)) }), _ => if m == 0 { 6 } else { m }, } };
func maxW(a: @, b: @) -> @ { if a > b { a } else { b } };
// two reals at one width:  the wider of theirs (each primitive first brings its operands to
// the session's width, so this is a fallback for values of an older width)
func pairW(x: @, y: @) -> @ { if x == 0 { widthOf(y) } else if y == 0 { widthOf(x) } else { maxW(widthOf(x), widthOf(y)) } };
func both64(x: @, y: @) -> Bool { x < two128() and y < two128() };
// o: 1 add 2 sub 3 mul 4 div
func rop(o: @, x: @, y: @) -> @ {
  if both64(x, y) { fbits(if o == 1 { hoon.radd(freal(x), freal(y)) } else if o == 2 { hoon.rsub(freal(x), freal(y)) } else if o == 3 { hoon.rmul(freal(x), freal(y)) } else { hoon.rdiv(freal(x), freal(y)) }) }
  else { let w = pairW(x, y); tagged(w, lagoon.fop(w, o, rawAt(x, w), rawAt(y, w))) }
};
// o: 1 lth 2 lte 3 gth 4 gte
func rcmp(o: @, x: @, y: @) -> Bool {
  if both64(x, y) { if o == 1 { hoon.rlth(freal(x), freal(y)) } else if o == 2 { hoon.rlte(freal(x), freal(y)) } else if o == 3 { hoon.rgth(freal(x), freal(y)) } else { hoon.rgte(freal(x), freal(y)) } }
  else { let w = pairW(x, y); lagoon.fcmp(w, o, rawAt(x, w), rawAt(y, w)) }
};
// o: 1 sqt 2 exp 3 log 4 sin 5 cos 6 tan 7 asin 8 acos 9 atan 10 factorial
func rfun(o: @, x: @) -> @ {
  if x < two128() {
    let f = freal(x);
    fbits(if o == 1 { lagoon.rsqt(f) } else if o == 2 { lagoon.rexp(f) } else if o == 3 { lagoon.rlog(f) } else if o == 4 { lagoon.rsin(f) } else if o == 5 { lagoon.rcos(f) }
      else if o == 6 { lagoon.rtan(f) } else if o == 7 { lagoon.rasin(f) } else if o == 8 { lagoon.racos(f) } else if o == 9 { lagoon.ratan(f) } else { lagoon.rfact(f) })
  } else { let w = widthOf(x); tagged(w, lagoon.fun(w, o, rawOf(x))) }
};
func rpow(x: @, y: @) -> @ { if both64(x, y) { fbits(lagoon.rpow(freal(x), freal(y))) } else { let w = pairW(x, y); tagged(w, lagoon.fpow(w, rawAt(x, w), rawAt(y, w))) } };
func rpiAt(w: @) -> @ { if w == 6 { fbits(lagoon.rpi(0)) } else { tagged(w, lagoon.fpi(w)) } };
func rsunAt(w: @, n: @) -> @ { if w == 6 { fbits(lagoon.rsun(n)) } else { tagged(w, lagoon.fsun(w, n)) } };
// m: the rounding mode as its letter's code, 100 (%d) floor, 117 (%u) ceiling, 110 (%n) nearest;
// the answer is a ZigZag @s as bare bits
func rtoi(m: @, x: @) -> @ {
  if x < two128() { if m == 100 { lagoon.rflo(freal(x)) ?? 0 } else if m == 117 { lagoon.rcei(freal(x)) ?? 0 } else { lagoon.rtoi(freal(x)) ?? 0 } }
  else { lagoon.ftoi(widthOf(x), m, rawOf(x)) ?? 0 }
};
func rsanLike(x: @, z: @) -> @ { if x < two128() { fbits(lagoon.rsan(z)) } else { let w = widthOf(x); tagged(w, lagoon.fsan(w, z)) } };
func rdrg(x: @) -> (Bool, @, @) { if x < two128() { lagoon.rdrg(freal(x)) } else { lagoon.fdrg(widthOf(x), rawOf(x)) } };
// the constants of x's width
func zeroLike(x: @) -> @ { tagged(widthOf(x), 0) };
func oneLike(x: @) -> @ { rsunAt(widthOf(x), 1) };
// a decimal (sign, exponent as ZigZag bits, mantissa) at width w, correctly rounded
func rgrd(w: @, pos: Bool, e: @, m: @) -> @ { tagged(w, lagoon.fgrd(w, pos, e, m)) };
func relabel(r: lagoon.Ray, k: Term) -> lagoon.Ray {
  lagoon.Ray( meta: lagoon.Meta( shape: r.meta.shape, bloq: r.meta.bloq, kind: k, tail: r.meta.tail ), data: r.data )
};

func toCps(cs: List<UniChar>) -> List<@> { revL(toCpsAcc(cs, ~), ~) };
func toCpsAcc(cs: List<UniChar>, acc: List<@>) -> List<@> { match cs { (h, t) => toCpsAcc(t, (h as! @, acc)), _ => acc, } };

// --- list helpers --------------------------------------------------------------
// The list builders run as tail calls over an accumulator and reverse once: NockVM copies a
// non-tail call's result out of each frame it returns through, which makes a consing recursion
// quadratic in its length (P11b)
func turnL(xs: List<@>, f: @ -> @) -> List<@> { revL(turnAcc(xs, f, ~), ~) };
func turnAcc(xs: List<@>, f: @ -> @, acc: List<@>) -> List<@> { match xs { (h, t) => turnAcc(t, f, (f(h), acc)), _ => acc, } };
func zipL(xs: List<@>, ys: List<@>, f: (@, @) -> @) -> List<@> { revL(zipAcc(xs, ys, f, ~), ~) };
func zipAcc(xs: List<@>, ys: List<@>, f: (@, @) -> @, acc: List<@>) -> List<@> {
  match xs { (h, t) => match ys { (h2, t2) => zipAcc(t, t2, f, (f(h, h2), acc)), _ => acc, }, _ => acc, }
};
func anyL(xs: List<@>, p: @ -> Bool) -> Bool { match xs { (h, t) => if p(h) { true } else { anyL(t, p) }, _ => false, } };
func allL(xs: List<@>, p: @ -> Bool) -> Bool { match xs { (h, t) => if p(h) { allL(t, p) } else { false }, _ => true, } };
func anyZip(xs: List<@>, ys: List<@>, p: (@, @) -> Bool) -> Bool {
  match xs { (h, t) => match ys { (h2, t2) => if p(h, h2) { true } else { anyZip(t, t2, p) }, _ => false, }, _ => false, }
};
func mapArr(a: Arr, k: @, f: @ -> @) -> Arr { make(k, shape(a), turnL(vals(a), f)) };
func zipArr(a: Arr, b: Arr, k: @, f: (@, @) -> @) -> Arr { make(k, shape(a), zipL(vals(a), vals(b), f)) };


// --- more list and index helpers (P4) -------------------------------------------------
func nth(xs: List<@>, i: @) -> @ { match xs { (h, t) => if i == 0 { h } else { nth(t, i - 1) }, _ => 0, } };
func takeL(xs: List<@>, n: @) -> List<@> { revL(takeAcc(xs, n, ~), ~) };
func takeAcc(xs: List<@>, n: @, acc: List<@>) -> List<@> { if n == 0 { acc } else { match xs { (h, t) => takeAcc(t, n - 1, (h, acc)), _ => acc, } } };
func dropL(xs: List<@>, n: @) -> List<@> { if n == 0 { xs } else { match xs { (h, t) => dropL(t, n - 1), _ => ~, } } };
func revL(xs: List<@>, acc: List<@>) -> List<@> { match xs { (h, t) => revL(t, (h, acc)), _ => acc, } };
func catL(a: List<@>, b: List<@>) -> List<@> { revL(revL(a, ~), b) };
func repL(x: @, n: @) -> List<@> { repAcc(x, n, ~) };
func repAcc(x: @, n: @, acc: List<@>) -> List<@> { if n == 0 { acc } else { repAcc(x, n - 1, (x, acc)) } };
// n elements drawn cyclically from xs (xs non-empty)
// xs repeated to n - i elements (len > 0), walked once with an accumulator (P11b)
func cycleL(xs: List<@>, n: @, i: @, len: @) -> List<@> { match xs { (h, t) => revL(cycAcc(dropL(xs, i % len), xs, n - i, ~), ~), _ => repL(0, n - i), } };
func cycAcc(rem: List<@>, full: List<@>, n: @, acc: List<@>) -> List<@> {
  if n == 0 { acc } else { match rem { (h, t) => cycAcc(t, full, n - 1, (h, acc)), _ => cycAcc(full, full, n, acc), } }
};
func chunks(xs: List<@>, n: @) -> List<List<@>> { revLLa(chunksAcc(xs, n, ~), ~) };
func chunksAcc(xs: List<@>, n: @, acc: List<List<@>>) -> List<List<@>> { match xs { (h, t) => chunksAcc(dropL(xs, n), n, (takeL(xs, n), acc)), _ => acc, } };
func revLLa(xs: List<List<@>>, acc: List<List<@>>) -> List<List<@>> { match xs { (h, t) => revLLa(t, (h, acc)), _ => acc, } };
func flatten(xss: List<List<@>>) -> List<@> { revL(flatAcc(xss, ~), ~) };
func flatAcc(xss: List<List<@>>, acc: List<@>) -> List<@> { match xss { (r, rest) => flatAcc(rest, revL(r, acc)), _ => acc, } };
func countLL(xss: List<List<@>>) -> @ { match xss { (r, rest) => 1 + countLL(rest), _ => 0, } };
func colOf(rows: List<List<@>>, j: @) -> List<@> { revL(colAcc(rows, j, ~), ~) };
func colAcc(rows: List<List<@>>, j: @, acc: List<@>) -> List<@> { match rows { (r, rest) => colAcc(rest, j, (nth(r, j), acc)), _ => acc, } };
// the columns j.. of the rows, each step peeling one head off every row (linear in the cells)
func colsOf(rows: List<List<@>>, ncols: @, j: @) -> List<List<@>> { revLLa(colsAcc(dropEach(rows, j, ~), ncols - j, ~), ~) };
func colsAcc(rows: List<List<@>>, n: @, acc: List<List<@>>) -> List<List<@>> { if n == 0 { acc } else { colsAcc(tailsOf(rows, ~), n - 1, (headsOf(rows, ~), acc)) } };
func headsOf(rows: List<List<@>>, acc: List<@>) -> List<@> { match rows { (r, rest) => headsOf(rest, (match r { (h, t) => h, _ => 0, }, acc)), _ => revL(acc, ~), } };
func tailsOf(rows: List<List<@>>, acc: List<List<@>>) -> List<List<@>> { match rows { (r, rest) => tailsOf(rest, (match r { (h, t) => t, _ => ~, }, acc)), _ => revLLa(acc, ~), } };
func dropEach(rows: List<List<@>>, j: @, acc: List<List<@>>) -> List<List<@>> { if j == 0 { rows } else { match rows { (r, rest) => dropEach(rest, j, (dropL(r, j), acc)), _ => revLLa(acc, ~), } } };
// built from the end by a tail call: a non-tail recursion's list is copied out of every frame it
// returns through, which is quadratic under NockVM (P11b)
func iotaL(n: @, from: @) -> List<@> { if n == 0 { ~ } else { iotaDown(n, from + n - 1, ~) } };
func iotaDown(n: @, cur: @, acc: List<@>) -> List<@> { if n == 0 { acc } else if n == 1 { (cur, acc) } else { iotaDown(n - 1, cur - 1, (cur, acc)) } };
func lastL(xs: List<@>) -> @ { match xs { (h, t) => match t { (h2, t2) => lastL(t), _ => h, }, _ => 0, } };
func initL(xs: List<@>) -> List<@> { match revL(xs, ~) { (h, t) => revL(t, ~), _ => ~, } };
func fillOf(k: @) -> @ { if k == 4 { 32 } else { 0 } };
// row-major index arithmetic
func flatIx(shp: List<@>, ix: List<@>) -> @ {
  match shp { (d, ds) => match ix { (i, irest) => i * size(ds) + flatIx(ds, irest), _ => 0, }, _ => 0, }
};
func unflatIx(shp: List<@>, k: @) -> List<@> {
  match shp { (d, ds) => { let s = size(ds); ((k / s) % d, unflatIx(ds, k % s)) }, _ => ~, }
};
// every combination of one element from each part, first part slowest
// built from the last part outward, each step a pass over (element, tail) pairs into an accumulator
func cartesian(parts: List<List<@>>) -> List<List<@>> { cartFrom(revLLa(parts, ~), [~]) };
func cartFrom(rparts: List<List<@>>, combos: List<List<@>>) -> List<List<@>> { match rparts { (p, rest) => cartFrom(rest, revLLa(prefixAll(p, combos, ~), ~)), _ => combos, } };
// (h, tl) for h in xs, tl in tails, h slowest;  answered reversed
func prefixAll(xs: List<@>, tails: List<List<@>>, acc: List<List<@>>) -> List<List<@>> { match xs { (h, t) => prefixAll(t, tails, prefixEach(h, tails, acc)), _ => acc, } };
func prefixEach(h: @, tails: List<List<@>>, acc: List<List<@>>) -> List<List<@>> { match tails { (tl, rest) => prefixEach(h, rest, ((h, tl), acc)), _ => acc, } };
func catLL(a: List<List<@>>, b: List<List<@>>) -> List<List<@>> { revLLa(revLLa(a, ~), b) };
func singles(xs: List<@>) -> List<List<@>> { revLLa(singlesAcc(xs, ~), ~) };
func singlesAcc(xs: List<@>, acc: List<List<@>>) -> List<List<@>> { match xs { (h, t) => singlesAcc(t, ([h], acc)), _ => acc, } };
func lastDim(shp: List<@>) -> @ { match shp { (d, ds) => match ds { (d2, r) => lastDim(ds), _ => d, }, _ => 1, } };
func firstDim(shp: List<@>) -> @ { match shp { (d, ds) => d, _ => 1, } };

// --- scalars of each kind ------------------------------------------------------
func isNeg(x: @) -> Bool { lagoon.tmsb(x) == 1 };                       // int2 sign
func fbits(f: Float64) -> @ { f as! @ };
func freal(x: @) -> Float64 { x as! Float64 };
func natToReal(x: @) -> @ { natToRealAt(6, x) };
func intToReal(x: @) -> @ { intToRealAt(6, x) };
func natToRealAt(w: @, x: @) -> @ { rsunAt(w, x) };
func intToRealAt(w: @, x: @) -> @ { if isNeg(x) { rop(2, tagged(w, 0), rsunAt(w, lagoon.tabs(x))) } else { rsunAt(w, x) } };
// a ZigZag @s (crossing as bare bits) -> int2 bits
func sToInt(z: @) -> @ { lagoon.ts2t(z) };
func realIsNeg(x: @) -> Bool { rcmp(1, x, zeroLike(x)) };
func pow10(n: @) -> @ { if n == 0 { 1 } else { 10 * pow10(n - 1) } };

// --- promotion (D-11) ------------------------------------------------------------
func toReal(a: Arr) -> Arr { toRealAt(a, 6) };
// a numeric array as reals of width w (D-11, D-15)
func toRealAt(a: Arr, w: @) -> Arr {
  match a.kind {
    1 => if bloqOf(a) == 6 { Arr( kind: 3, ray: lagoon.change(a.ray, %i754, w), items: ~ ) } else { makeReal(w, shape(a), natsAt(w, vals(a), ~)) },   // +change: linear, +sun's rounding, any rank since numerics #94
    2 => makeReal(w, shape(a), intsAt(w, vals(a), ~)),
    3 => if bloqOf(a) == w { a } else { makeReal(w, shape(a), vals(a)) },
    _ => a,
  }
};
func natsAt(w: @, xs: List<@>, acc: List<@>) -> List<@> { match xs { (x, t) => natsAt(w, t, (natToRealAt(w, x), acc)), _ => revL(acc, ~), } };
func intsAt(w: @, xs: List<@>, acc: List<@>) -> List<@> { match xs { (x, t) => intsAt(w, t, (intToRealAt(w, x), acc)), _ => revL(acc, ~), } };
func toInt(a: Arr) -> Arr { match a.kind { 1 => if bloqOf(a) == 6 { Arr( kind: 2, ray: relabel(a.ray, %int2), items: ~ ) } else { make(2, shape(a), vals(a)) }, _ => a, } };
func promote(a: Arr, k: @) -> Arr { match k { 3 => toReal(a), 2 => toInt(a), _ => a, } };
func promoteAt(a: Arr, k: @, w: @) -> Arr { match k { 3 => toRealAt(a, w), 2 => toInt(a), _ => a, } };
// an array as the session would make it (D-15):  naturals at nb, integers at ib, reals at rb
func narrow(a: Arr, nb: @, ib: @, rb: @) -> Arr {
  let b = bloqOf(a);
  if a.kind == 1 { if b == nb { a } else { makeB(1, nb, shape(a), vals(a)) } }
  else if a.kind == 2 { if b == ib { a } else { makeB(2, ib, shape(a), vals(a)) } }
  else if a.kind == 3 { if b == rb { a } else { makeReal(rb, shape(a), vals(a)) } }
  else { a }
};
func maxk(a: @, b: @) -> @ { if a > b { a } else { b } };

// --- scalar extension (D-25):  (a', b', tag);  tag "" when the shapes agree
// a scalar repeated to a shape: Lagoon's +fill builds through +reap, unjetted under jojo and quadratic as a non-tail recursion (P11b)
func spread(a: Arr, shp: List<@>) -> Arr { if a.kind == 3 { makeReal(bloqOf(a), shp, repL(first(a), size(shp))) } else { Arr( kind: a.kind, ray: lagoon.from(metaB(a.kind, bloqOf(a), shp), repL(rawFirst(a), size(shp))), items: a.items ) } };
func rawFirst(a: Arr) -> @ { match lagoon.ravel(a.ray) { (h, t) => h, _ => 0, } };
func extend(a: Arr, b: Arr) -> (Arr, Arr, String) {
  if shape(a) == shape(b) { (a, b, "") }
  else if size(shape(a)) == 1 { (spread(a, shape(b)), b, "") }
  else if size(shape(b)) == 1 { (a, spread(b, shape(a)), "") }
  else if rank(a) == rank(b) { (a, b, "%length-error") }
  else { (a, b, "%rank-error") }
};

// --- boxes (D-70, D-77) -------------------------------------------------------------
func isBox(a: Arr) -> Bool { a.kind == 5 };
func isSimpleScalar(a: Arr) -> Bool { a.kind != 5 and rank(a) == 0 };
func classOf(a: Arr) -> @ { if a.kind == 4 { 1 } else { 0 } };     // 0 numeric, 1 character
func countA(xs: List<Arr>) -> @ { match xs { (h, t) => 1 + countA(t), _ => 0, } };
func nthA(xs: List<Arr>, i: @) -> Arr { match xs { (h, t) => if i == 0 { h } else { nthA(t, i - 1) }, _ => scalar(1, 0), } };
func takeA(xs: List<Arr>, n: @) -> List<Arr> { revA(takeAAcc(xs, n, ~), ~) };
func takeAAcc(xs: List<Arr>, n: @, acc: List<Arr>) -> List<Arr> { if n == 0 { acc } else { match xs { (h, t) => takeAAcc(t, n - 1, (h, acc)), _ => acc, } } };
func dropA(xs: List<Arr>, n: @) -> List<Arr> { if n == 0 { xs } else { match xs { (h, t) => dropA(t, n - 1), _ => ~, } } };
func catA(a: List<Arr>, b: List<Arr>) -> List<Arr> { revA(revA(a, ~), b) };
func revA(xs: List<Arr>, acc: List<Arr>) -> List<Arr> { match xs { (h, t) => revA(t, (h, acc)), _ => acc, } };
func allSimpleScalars(xs: List<Arr>) -> Bool { match xs { (h, t) => if isSimpleScalar(h) { allSimpleScalars(t) } else { false }, _ => true, } };
func oneClass(xs: List<Arr>, c: @) -> Bool { match xs { (h, t) => if classOf(h) == c { oneClass(t, c) } else { false }, _ => true, } };
func maxKindA(xs: List<Arr>, k: @) -> @ { match xs { (h, t) => maxKindA(t, maxk(k, h.kind)), _ => k, } };
func firstValsA(xs: List<Arr>, k: @) -> List<@> { let w = realWA(xs, 0); firstValsAt(xs, k, w) };
func firstValsAt(xs: List<Arr>, k: @, w: @) -> List<@> { revL(firstAcc(xs, k, w, ~), ~) };
func firstAcc(xs: List<Arr>, k: @, w: @, acc: List<@>) -> List<@> { match xs { (h, t) => firstAcc(t, k, w, (first(promoteAt(h, k, w)), acc)), _ => acc, } };
// the widest real width among the arrays, 6 when none is real (a join's width, D-15)
func realWA(xs: List<Arr>, m: @) -> @ { match xs { (h, t) => realWA(t, if h.kind == 3 { maxW(m, bloqOf(h)) } else { m }), _ => if m == 0 { 6 } else { m }, } };
// a box of the given shape over elements in ravel order
func boxOf(shp: List<@>, xs: List<Arr>) -> Arr { Arr( kind: 5, ray: lagoon.from(metaOf(1, shp), iotaL(countA(xs), 1)), items: xs ) };
// D-70's normal form: all simple scalars of one class make a simple array
func oneClassAll(xs: List<Arr>) -> Bool { match xs { (h, t) => oneClass(t, classOf(h)), _ => true, } };
func normalize(shp: List<@>, xs: List<Arr>) -> Arr {
  if allSimpleScalars(xs) and oneClassAll(xs) {
    let k = maxKindA(xs, 1);
    make(k, shp, firstValsA(xs, k))
  } else { boxOf(shp, xs) }
};
func enclose(a: Arr) -> Arr { if isSimpleScalar(a) { a } else { boxOf(~, [a]) } };
func scalarsOf(k: @, vs: List<@>) -> List<Arr> { revA(scalarsAcc(k, vs, ~), ~) };
func scalarsAcc(k: @, vs: List<@>, acc: List<Arr>) -> List<Arr> { match vs { (v, t) => scalarsAcc(k, t, (scalar(k, v), acc)), _ => acc, } };
// the elements in ravel order, each an array
func itemsOf(a: Arr) -> List<Arr> { if isBox(a) { pickItems(a, vals(a)) } else { scalarsOf(a.kind, vals(a)) } };
// the elements the index numbers name;  0 is the prototype
// one nthA per index:  linear in the indices, but each lookup walks the items (a box of many items regathers in O(n²))
func pickItems(a: Arr, ixs: List<@>) -> List<Arr> { revA(pickAcc(a, ixs, ~), ~) };
func pickAcc(a: Arr, ixs: List<@>, acc: List<Arr>) -> List<Arr> { match ixs { (i, t) => pickAcc(a, t, (if i == 0 { proto(a) } else { nthA(a.items, i - 1) }, acc)), _ => acc, } };
// a box's index ray as a natural array;  a structural function runs on it
func ixArr(a: Arr) -> Arr { Arr( kind: 1, ray: a.ray, items: ~ ) };
// the moved index ray back to elements, in normal form
func regather(a: Arr, ix: Arr) -> Arr { normalize(shape(ix), pickItems(a, vals(ix))) };
func firstItem(a: Arr) -> Arr { match itemsOf(a) { (h, t) => h, _ => proto(a), } };
// the prototype (D-77): the first element's type, 0 when empty
func proto(a: Arr) -> Arr {
  if isBox(a) { match a.items { (h, t) => typeOf(h), _ => scalar(1, 0), } } else { scalar(a.kind, fillOf(a.kind)) }
};
func typeOf(a: Arr) -> Arr {
  if isBox(a) { boxOf(shape(a), typeAll(itemsOf(a))) } else { make(a.kind, shape(a), repL(fillOf(a.kind), size(shape(a)))) }
};
func typeAll(xs: List<Arr>) -> List<Arr> { revA(typeAcc(xs, ~), ~) };
func typeAcc(xs: List<Arr>, acc: List<Arr>) -> List<Arr> { match xs { (h, t) => typeAcc(t, (typeOf(h), acc)), _ => acc, } };
func depth(a: Arr) -> @ { if isBox(a) { 1 + maxDepth(a.items, 0) } else if rank(a) == 0 { 0 } else { 1 } };
func maxDepth(xs: List<Arr>, d: @) -> @ { match xs { (h, t) => maxDepth(t, maxk(d, depth(h))), _ => d, } };

// --- display (D-45) ----------------------------------------------------------------
func strLen(s: String) -> @ { count(toCps(s.chars())) };
func takeB(bs: List<Byte>, n: @) -> List<Byte> { revB(takeBAcc(bs, n, ~), ~) };
func takeBAcc(bs: List<Byte>, n: @, acc: List<Byte>) -> List<Byte> { if n == 0 { acc } else { match bs { (h, t) => takeBAcc(t, n - 1, (h, acc)), _ => acc, } } };
func revB(xs: List<Byte>, acc: List<Byte>) -> List<Byte> { match xs { (h, t) => revB(t, (h, acc)), _ => acc, } };
func dropB(bs: List<Byte>, n: @) -> List<Byte> { if n == 0 { bs } else { match bs { (h, t) => dropB(t, n - 1), _ => ~, } } };
func zeros(n: @) -> String { if n == 0 { "" } else { "0" + zeros(n - 1) } };
func spaces(n: @) -> String { if n == 0 { "" } else { " " + spaces(n - 1) } };
func ndigits(a: @) -> @ { if a < 10 { 1 } else { 1 + ndigits(a / 10) } };
func stripZeros(a: @) -> @ { if a == 0 { 0 } else if (a % 10) == 0 { stripZeros(a / 10) } else { a } };
func fmtNat(x: @) -> String { "{x}" };
func fmtInt(x: @) -> String { if isNeg(x) { "¯" + fmtNat(lagoon.tabs(x)) } else { fmtNat(x) } };
// a signed exponent for the E form:  p - 1, from (pneg, pmag) of p
func fmtExp(pneg: Bool, pmag: @) -> String {
  if pneg { "¯" + fmtNat(pmag + 1) } else if pmag == 0 { "¯1" } else { fmtNat(pmag - 1) }
};
// the significand digits D (as the nat a, L digits) placed at position p:
// value = 0.D × 10^p;  p arrives as (pneg, pmag)
func placeDigits(a: @, pneg: Bool, pmag: @, pp: @) -> String {
  let d = fmtNat(a);
  let l = strLen(d);
  let bs = d.bytes();
  if (not pneg) and pmag > 0 and pmag <= pp {
    if pmag >= l { d + zeros(pmag - l) }
    else { hoon.crip(takeB(bs, pmag)) + "." + hoon.crip(dropB(bs, pmag)) }
  } else if (pneg and pmag <= 5) or ((not pneg) and pmag == 0) {
    "0." + zeros(pmag) + d
  } else {
    let mant = if l == 1 { d } else { hoon.crip(takeB(bs, 1)) + "." + hoon.crip(dropB(bs, 1)) };
    mant + "E" + fmtExp(pneg, pmag)
  }
};
func fmtReal(x: @, pp: @) -> String {
  match rdrg(x) {
    (s, e, a) => if a == 0 { "0" } else {
      // e is a ZigZag @s as bare bits;  p = e + L signed, as (pneg, pmag)
      let l = ndigits(a);
      let eneg = (e % 2) == 1;
      let emag = if eneg { (e + 1) / 2 } else { e / 2 };
      let pneg = eneg and emag > l;
      let pmag = if eneg { if emag > l { emag - l } else { l - emag } } else { emag + l };
      // round to pp significant digits;  a carry bumps p by one
      let over = if l > pp { l - pp } else { 0 };
      let div = pow10(over);
      let r0 = if over == 0 { a } else { (a + (div / 2)) / div };
      let carried = ndigits(r0) > pp and over > 0;
      let r1 = if carried { r0 / 10 } else { r0 };
      let p2neg = if carried and pneg and pmag == 1 { false } else { pneg };
      let p2mag = if carried { if pneg { pmag - 1 } else { pmag + 1 } } else { pmag };
      let body = placeDigits(stripZeros(r1), p2neg, p2mag, pp);
      if s { body } else { "¯" + body }
    },
  }
};
func fmtElem(k: @, x: @, pp: @) -> String {
  match k { 2 => fmtInt(x), 3 => fmtReal(x, pp), 4 => utf8([x as! UniChar]), _ => fmtNat(x), }
};
func fmtAll(k: @, xs: List<@>, pp: @) -> List<String> { revS(fmtAllAcc(k, xs, pp, ~), ~) };
func fmtAllAcc(k: @, xs: List<@>, pp: @, acc: List<String>) -> List<String> { match xs { (h, t) => fmtAllAcc(k, t, pp, (fmtElem(k, h, pp), acc)), _ => acc, } };
func revS(xs: List<String>, acc: List<String>) -> List<String> { match xs { (h, t) => revS(t, (h, acc)), _ => acc, } };
// the bytes of every string and separator into one reversed list, cripped once:  joining by +
// copies the growing tail at every step, quadratic in the text (P11b)
func joinS(xs: List<String>, sep: String) -> String {
  match xs { (h, t) => hoon.crip(revB(joinAcc(t, sep.bytes(), pushB(h.bytes(), ~)), ~)), _ => "", }
};
func joinAcc(xs: List<String>, sb: List<Byte>, acc: List<Byte>) -> List<Byte> { match xs { (h, t) => joinAcc(t, sb, pushB(h.bytes(), pushB(sb, acc))), _ => acc, } };
func pushB(bs: List<Byte>, acc: List<Byte>) -> List<Byte> { match bs { (b, t) => pushB(t, (b, acc)), _ => acc, } };
func takeS(xs: List<String>, n: @) -> List<String> { revS(takeSAcc(xs, n, ~), ~) };
func takeSAcc(xs: List<String>, n: @, acc: List<String>) -> List<String> { if n == 0 { acc } else { match xs { (h, t) => takeSAcc(t, n - 1, (h, acc)), _ => acc, } } };
func dropS(xs: List<String>, n: @) -> List<String> { if n == 0 { xs } else { match xs { (h, t) => dropS(t, n - 1), _ => ~, } } };
func chunk(xs: List<String>, n: @) -> List<List<String>> { revSS(chunkAcc(xs, n, ~), ~) };
func chunkAcc(xs: List<String>, n: @, acc: List<List<String>>) -> List<List<String>> { match xs { (h, t) => chunkAcc(dropS(xs, n), n, (takeS(xs, n), acc)), _ => acc, } };
func revSS(xs: List<List<String>>, acc: List<List<String>>) -> List<List<String>> { match xs { (h, t) => revSS(t, (h, acc)), _ => acc, } };
func widths(rows: List<List<String>>, acc: List<@>) -> List<@> {
  match rows { (r, rest) => widths(rest, zipMax(acc, r)), _ => acc, }
};
func zipMax(ws: List<@>, cells: List<String>) -> List<@> { zipMaxAcc(ws, cells, ~) };
func zipMaxAcc(ws: List<@>, cells: List<String>, acc: List<@>) -> List<@> {
  match cells {
    (c, ct) => match ws { (w, wt) => zipMaxAcc(wt, ct, (maxk(w, strLen(c)), acc)), _ => zipMaxAcc(~, ct, (strLen(c), acc)), },
    _ => revL(acc, ws),
  }
};
func padRow(ws: List<@>, cells: List<String>) -> List<String> { revS(padAcc(ws, cells, ~), ~) };
func padAcc(ws: List<@>, cells: List<String>, acc: List<String>) -> List<String> {
  match cells {
    (c, ct) => match ws { (w, wt) => padAcc(wt, ct, (spaces(w - strLen(c)) + c, acc)), _ => padAcc(~, ct, (c, acc)), },
    _ => acc,
  }
};
func fmtRows(rows: List<List<String>>, ws: List<@>, sep: String) -> List<String> { revS(fmtRowsAcc(rows, ws, sep, ~), ~) };
func fmtRowsAcc(rows: List<List<String>>, ws: List<@>, sep: String, acc: List<String>) -> List<String> { match rows { (r, rest) => fmtRowsAcc(rest, ws, sep, (joinS(padRow(ws, r), sep), acc)), _ => acc, } };
// a rank-2 block: rows of `cols` cells;  chars abut, numbers right-align per column
func fmtMatrix(k: @, cells: List<String>, cols: @) -> String {
  let rows = chunk(cells, cols);
  if k == 4 { joinS(fmtRows(rows, ~, ""), "\n") }
  else { joinS(fmtRows(rows, widths(rows, ~), " "), "\n") }
};
func last2(shp: List<@>) -> (@, @) {
  match shp { (a, t) => match t { (b, t2) => match t2 { (c, t3) => last2(t), _ => (a, b), }, _ => (a, a), }, _ => (1, 1), }
};
// rank 3 and above: every row of every plane, columns aligned across the whole array, a blank
// line between planes and one more at each axis further out (D-45)
func fmtPlanes(k: @, cells: List<String>, shp: List<@>) -> String {
  match last2(shp) { (rows, cols) => {
    let all = chunk(cells, cols);
    let lines = if k == 4 { fmtRows(all, ~, "") } else { fmtRows(all, widths(all, ~), " ") };
    joinS(revS(planeLines(lines, rows, dropL(revL(takeL(shp, count(shp) - 1), ~), 1), 1, ~), ~), "\n")
  }, }
};
// the lines with an empty line after line i for each axis whose cell ends there (all but the last line)
func planeLines(lines: List<String>, rows: @, outer: List<@>, i: @, acc: List<String>) -> List<String> {
  match lines { (l, rest) => match rest { (l2, r2) => planeLines(rest, rows, outer, i + 1, pushEmpty(nBlanks(i, rows, outer), (l, acc))), _ => (l, acc), }, _ => acc, }
};
func nBlanks(i: @, m: @, outer: List<@>) -> @ { match outer { (d, t) => if i % m == 0 { 1 + nBlanks(i, m * d, t) } else { 0 }, _ => 0, } };
func pushEmpty(n: @, acc: List<String>) -> List<String> { if n == 0 { acc } else { pushEmpty(n - 1, ("", acc)) } };
// --- display of a box (D-76): the strand that builds it ------------------------------
func quoted(cs: List<@>) -> String { "'" + joinS(quoteEach(cs), "") + "'" };
func quoteEach(cs: List<@>) -> List<String> { revS(quoteAcc(cs, ~), ~) };
func quoteAcc(cs: List<@>, acc: List<String>) -> List<String> { match cs { (c, t) => quoteAcc(t, ((if c == 39 { "''" } else { utf8([c as! UniChar]) }), acc)), _ => acc, } };
func shapeText(shp: List<@>) -> String { joinS(fmtAll(1, shp, 10), " ") };
// a simple ravel as source: numbers spaced, characters quoted, none as ⍳0
func ravelText(a: Arr, pp: @) -> String {
  if a.kind == 4 { quoted(vals(a)) }
  else { match vals(a) { (h, t) => joinS(fmtAll(a.kind, vals(a), pp), " "), _ => "⍳0", } }
};
// one element as it stands in a strand
func fmtItem(a: Arr, pp: @) -> String {
  let r = rank(a);
  if isBox(a) {
    if r == 0 { "(⊂" + fmtItem(firstItem(a), pp) + ")" }
    else if r == 1 { "(" + fmtStrand(itemsOf(a), pp) + ")" }
    else { "(" + shapeText(shape(a)) + "⍴" + fmtStrand(itemsOf(a), pp) + ")" }
  }
  else if r == 0 { if a.kind == 4 { quoted(vals(a)) } else { fmtElem(a.kind, first(a), pp) } }
  else if r == 1 {
    if a.kind == 4 { quoted(vals(a)) }
    else if size(shape(a)) == 1 { "(," + fmtElem(a.kind, first(a), pp) + ")" }
    else { "(" + ravelText(a, pp) + ")" }
  }
  else { "(" + shapeText(shape(a)) + "⍴" + ravelText(a, pp) + ")" }
};
func fmtStrand(xs: List<Arr>, pp: @) -> String { joinS(fmtItems(xs, pp), " ") };
func fmtItems(xs: List<Arr>, pp: @) -> List<String> { revS(fmtItemsAcc(xs, pp, ~), ~) };
func fmtItemsAcc(xs: List<Arr>, pp: @, acc: List<String>) -> List<String> { match xs { (h, t) => fmtItemsAcc(t, pp, (fmtItem(h, pp), acc)), _ => acc, } };
func fmtBoxRows(xs: List<Arr>, cols: @, pp: @) -> List<String> { revS(boxRowsAcc(xs, cols, pp, ~), ~) };
func boxRowsAcc(xs: List<Arr>, cols: @, pp: @, acc: List<String>) -> List<String> { match xs { (h, t) => boxRowsAcc(dropA(xs, cols), cols, pp, (fmtStrand(takeA(xs, cols), pp), acc)), _ => acc, } };
func fmtBoxPlanes(xs: List<Arr>, rows: @, cols: @, pp: @) -> String { joinS(revS(boxPlanesAcc(xs, rows * cols, cols, pp, ~), ~), "\n\n") };
func boxPlanesAcc(xs: List<Arr>, n: @, cols: @, pp: @, acc: List<String>) -> List<String> {
  match xs { (h, t) => boxPlanesAcc(dropA(xs, n), n, cols, pp, (joinS(fmtBoxRows(takeA(xs, n), cols, pp), "\n"), acc)), _ => acc, }
};
func fmtBox(a: Arr, pp: @) -> String {
  let r = rank(a);
  let xs = itemsOf(a);
  if r == 0 { "⊂" + fmtItem(firstItem(a), pp) }
  else if r == 1 { fmtStrand(xs, pp) }
  else { match last2(shape(a)) { (rows, cols) => if r == 2 { joinS(fmtBoxRows(xs, cols, pp), "\n") } else { fmtBoxPlanes(xs, rows, cols, pp) }, } }
};
func format(a: Arr, pp: @) -> String {
  if isBox(a) { fmtBox(a, pp) } else { formatSimple(a, pp) }
};
func formatSimple(a: Arr, pp: @) -> String {
  let cells = fmtAll(a.kind, vals(a), pp);
  let r = rank(a);
  if r == 0 { joinS(cells, "") }
  else if r == 1 { if a.kind == 4 { joinS(cells, "") } else { joinS(cells, " ") } }
  else {
    match last2(shape(a)) { (rows, cols) => if r == 2 { fmtMatrix(a.kind, cells, cols) } else { fmtPlanes(a.kind, cells, shape(a)) }, }
  }
};
