// emit.jock — the emitter (plan P5): an ATL statement to a Nockasm
// program over the subject [rt env], lowered to Nock by the vendored
// reference expander (the `nasm` package) and run with `eval` (D-50).
//
// The runtime core rt is interp.runtime(): a tuple of gates, one per
// node kind, named by interp.gateNames() in the subject SCHEMA, so the
// emitted program refers to every gate and to the environment by NAME
// and never by a literal axis (D-51; the expander owns the axis
// bookkeeping through its #let shifts). Evaluation order is APL's:
// the right argument first, then the left against the environment
// the right produced. That environment is threaded by NAME too: each
// intermediate result is #let-bound to a fresh temporary and the
// environment after it is bound beside it, so a sub-expression is
// emitted against whichever environment name is current. Every gate
// is total over Ev inputs, so an error flows through the formula
// unchanged and the program contains no branch.
import parse;
import interp;
import nasm;

// `let` is a Jock keyword, so the #let node is spelled `bind` here and the
// nasm package rewrites the tag to %let before lowering (structurally)
enum Nasm { atom(@), axis(String), cell(List<Nasm>), op((String, List<Nasm>)), bind((String, Nasm, Nasm)), nock(*) };
enum Sema { leaf(String), pair((Sema, Sema)) };

// --- builders ------------------------------------------------------------------------------
func ax(nm: String) -> Nasm { Nasm.axis(nm) };
func konst(n: *) -> Nasm { Nasm.op(("const", [Nasm.nock(n)])) };
func cel(xs: List<Nasm>) -> Nasm { Nasm.cell(xs) };
func lett(nm: String, v: Nasm, body: Nasm) -> Nasm { Nasm.bind((nm, v, body)) };
// slam the gate at the named leg with a sample:  9 2 on the gate with 6 edited (D-51)
func callG(g: String, sample: Nasm) -> Nasm {
  Nasm.op(("call", [Nasm.atom(2), Nasm.op(("edit", [Nasm.atom(6), sample, ax(g)]))]))
};
func tmp(n: @) -> String { "t{n}" };

// --- the subject schema --------------------------------------------------------------------
func rtSchema(names: List<String>) -> Sema {
  match names { (h, t) => match t { (h2, t2) => Sema.pair((Sema.leaf(h), rtSchema(t))), _ => Sema.leaf(h), }, _ => Sema.leaf("rt"), }
};
func schema() -> Sema { Sema.pair((rtSchema(interp.gateNames()), Sema.leaf("env"))) };

// --- the emitter ------------------------------------------------------------------------------
// em(a, e, n): the program for a against environment name e, with n the
// next free temporary;  answers (program, next free temporary)
func em(a: parse.Ast, e: String, n: @) -> (Nasm, @) {
  match a {
    .lit(l) => (callG("g-lit", cel([konst(l), ax(e)])), n),
    .name(nm) => (callG("g-name", cel([konst(nm), ax(e)])), n),
    .nilad(nm) => (callG("g-nilad", cel([konst(nm), ax(e)])), n),
    .sysvar(nm) => (callG("g-sys", cel([konst(nm), ax(e)])), n),
    .monad(m) => match em(m.r, e, n) {
      (r, n1) => (lett(tmp(n1), r, callG("g-monad", cel([konst(m.f), ax(tmp(n1))]))), n1 + 1),
    },
    .dyad(d) => match em(d.r, e, n) {
      (r, n1) => {
        let rn = tmp(n1);
        let en = tmp(n1 + 1);
        match em(d.l, en, n1 + 2) {
          (l, n2) => {
            let ln = tmp(n2);
            (lett(rn, r, lett(en, callG("g-env", cel([ax(rn), ax(e)])), lett(ln, l, callG("g-dyad", cel([konst(d.f), ax(ln), ax(rn)]))))), n2 + 1)
          },
        }
      },
    },
    .assign(s) => match em(s.v, e, n) {
      (v, n1) => (lett(tmp(n1), v, callG("g-assign", cel([konst(s.nm), ax(tmp(n1))]))), n1 + 1),
    },
    .sysassign(s) => match em(s.v, e, n) {
      (v, n1) => (lett(tmp(n1), v, callG("g-sysassign", cel([konst(s.nm), ax(tmp(n1))]))), n1 + 1),
    },
    .index(ix) => match em(ix.a, e, n) {
      (x, n1) => {
        let xn = tmp(n1);
        let en = tmp(n1 + 1);
        match emParts(ix.ix, en, n1 + 2, ~) {
          (parts, binds, n2) => (lett(xn, x, lett(en, callG("g-env", cel([ax(xn), ax(e)])), wrap(binds, callG("g-index", cel([ax(xn), listOf(parts)]))))), n2),
        }
      },
    },
    .iassign(s) => match em(s.v, e, n) {
      (v, n1) => {
        let vn = tmp(n1);
        let en = tmp(n1 + 1);
        match emParts(s.ix, en, n1 + 2, ~) {
          (parts, binds, n2) => (lett(vn, v, lett(en, callG("g-env", cel([ax(vn), ax(e)])), wrap(binds, callG("g-iassign", cel([konst(s.nm), listOf(parts), ax(vn)]))))), n2),
        }
      },
    },
    _ => (konst(interp.Ev.err(interp.EErr( tag: "%unimplemented", hint: "not an emitted form" ))), n),
  }
};
// index parts in order, each against the environment the previous one left:
// answers (the Part expressions, the (name, program) bindings to wrap, next temporary)
func emParts(ixs: List<parse.Ast>, e: String, n: @, acc: List<(String, Nasm)>) -> (List<Nasm>, List<(String, Nasm)>, @) {
  match ixs {
    (ix, rest) => match ix {
      .elide => match emParts(rest, e, n, acc) { (ps, bs, n2) => ((konst(interp.Part.elide), ps), bs, n2), },
      _ => match em(ix, e, n) {
        (p, n1) => {
          let pn = tmp(n1);
          let en = tmp(n1 + 1);
          match emParts(rest, en, n1 + 2, ((en, callG("g-env", cel([ax(pn), ax(e)]))), ((pn, p), acc))) {
            (ps, bs, n2) => ((cel([konst(%ev), ax(pn)]), ps), bs, n2),
          }
        },
      },
    },
    _ => (~, acc, n),
  }
};
// bindings accumulate newest-first; wrap applies them outermost-first
func wrap(binds: List<(String, Nasm)>, body: Nasm) -> Nasm {
  match binds { ((nm, v), rest) => wrap(rest, lett(nm, v, body)), _ => body, }
};
// a null-terminated list of the part expressions
func listOf(ps: List<Nasm>) -> Nasm { cel(snocN(ps, konst(0))) };   // a FORMULA for the null: a raw atom would land in formula position
func snocN(xs: List<Nasm>, x: Nasm) -> List<Nasm> { match xs { (h, t) => (h, snocN(t, x)), _ => [x], } };

func emittable(a: parse.Ast) -> Bool {
  match a {
    .lit(l) => true, .name(nm) => true, .nilad(nm) => true, .sysvar(nm) => true, .monad(m) => true, .dyad(d) => true,
    .assign(s) => true, .sysassign(s) => true, .index(ix) => true, .iassign(s) => true,
    _ => false,
  }
};
func compile(a: parse.Ast) -> Nasm { match em(a, "env", 0) { (prog, n) => prog, } };
func lower(a: parse.Ast) -> * { nasm.lower((0, schema()), compile(a)) };
func render(a: parse.Ast) -> String { nasm.render((0, schema()), compile(a)) };
// the lowered formula as a noun, for the emission goldens: `[a b c]` right-nested, atoms decimal
func showNoun(n: *) -> String { if hoon.iscell(n) { "[" + showCell(n) + "]" } else { "{n as! @}" } };
func showCell(n: *) -> String {
  match n { (h, t) => if hoon.iscell(t) { showNoun(h) + " " + showCell(t) } else { showNoun(h) + " " + showNoun(t) }, _ => "", }
};
func lowerText(a: parse.Ast) -> String { showNoun(lower(a)) };
// run one statement's program over [rt env]
func run(a: parse.Ast, env: interp.Env) -> interp.Ev {
  eval((interp.runtime(), env), lower(a)) as! interp.Ev
};
