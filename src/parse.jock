// parse.jock — ATL/APL statements to the AST (dialect D-20..D-34, D-52).
//
// Two phases over one line's tokens. Phase A (`items`) walks LEFT to
// right and classifies: numerals fold into one literal item and any
// other adjacent array items strand into one item (D-4, D-71),
// names become array or function items by the store SIGNATURE (D-22,
// D-52), operators fold the function to their left into a derived
// function (D-21), parentheses and brackets recurse. It conses, so its
// product is already RIGHT to left. Phase B (`build`/`extend`) walks
// that list: the rightmost item is the value, a function to its left
// is dyadic if an array stands further left and monadic otherwise
// (D-20), and `←` takes the name to its left (D-24).
//
// The signature is a list of (name, class): 1 array, 2 monadic,
// 3 dyadic, 4 ambivalent, 5 niladic. An unbound name is a VALUE ERROR
// where it is read and legal where it is assigned (D-52). The
// statements of a `⋄` line thread the signature: each parses against
// the one the statements before it leave (D-68). Inside a dfn body the
// signature carries `∇` as an ambivalent function; that entry is what
// lets `∇` stand as a function item and `cond: expr` as a guard (D-66).
//
// A dfn literal `{...}` is a function item whose body is kept as
// SOURCE LINES and parsed on the first call (D-34, D-67); here only
// the braces are matched and the lines cut at `nl` tokens (D-69).
//
// Refusals are values (as in lexer.jock); `dump` renders a tree in a
// prefix form the parse corpus (tests/parse) pins: `f(x)`, `f(a, b)`,
// `a[i;j]`, `←(n, v)`, `strand(a, b)` for a strand, `f/` `f.g` `∘.g` for derived functions,
// `{body}` for a dfn and `:(cond, expr)` for a guard.
import lexer;

struct Lit { kind: @, vals: List<String> };               // 1 nat, 2 int, 3 real, 4 chr (D-10)
struct Inner { f: Fn, g: Fn };
struct Axis { f: Fn, k: @, half: Bool, ks: List<@> };    // f[k] (D-82); half: a fractional k, kept as ⌊k⌋+1 (laminate, D-92); ks: every axis, [k] or a scalar function's [k1 k2 …] (D-96)
struct Dfn { body: List<String> };                        // source lines (D-63)
// a dfn operator applied (D-95): op is the dfn or its name; l and r the operands, each a function
// or, when la (ra) is set, the array expression lv (rv)
struct Dop { op: Fn, l: Fn, r: Fn, two: Bool, la: Bool, lv: Ast, ra: Bool, rv: Ast };
enum Fn { prim(@), user(String), reduce(Fn), reduce1(Fn), scan(Fn), scan1(Fn), each(Fn), inner(Inner), outer(Fn), dfn(Dfn), own, axis(Axis), dop(Dop) };
enum Ast {
  empty, elide, fnend,
  lit(Lit), name(String), nilad(String), sysvar(String), strand(List<Ast>),
  monad(Monad), dyad(Dyad), index(Index),
  assign(Assign), iassign(IAssign), sysassign(Assign), fassign(FAssign),
  guard(Guard), eguard(Guard),
  cmd(Cmd), header(Header), stmts(List<Ast>),
};
struct Monad { f: Fn, r: Ast };
struct Dyad { f: Fn, l: Ast, r: Ast };
struct Index { a: Ast, ix: List<Ast> };
struct Assign { nm: String, v: Ast };
struct IAssign { nm: String, ix: List<Ast>, v: Ast };
struct FAssign { nm: String, f: Fn };                     // F ← {…} (D-64)
struct Guard { c: Ast, e: Ast };                          // cond: expr (D-66)
struct Cmd { nm: String, args: List<String> };
struct Header { nm: String, res: String, lft: String, rgt: String, locals: List<String> };   // "" = absent
struct PErr { tag: String, col: @, hint: String };
enum Parsed { err(PErr), ok(Ast) };
struct IArr { a: Ast, col: @, open: Bool, unbound: Bool };   // open: numerals folded or a strand built at this level, not a parenthesised group
struct IFun { f: Fn, col: @ };
enum Item { asg(@), arr(IArr), fun(IFun) };
enum Items { err(PErr), ok(List<Item>) };
enum Opnd { err(PErr), ok((Bool, Ast, List<lexer.Token>)) };      // an array operand: (found, the expression, the tokens after it)
enum Asts { err(PErr), ok(List<Ast>) };

// --- small helpers -----------------------------------------------------------
func pe(tag: String, col: @, hint: String) -> PErr { PErr( tag: tag, col: col, hint: hint ) };
func se(col: @, hint: String) -> Parsed { Parsed.err(pe("%syntax-error", col, hint)) };
func sei(col: @, hint: String) -> Items { Items.err(pe("%syntax-error", col, hint)) };
// an axis written as numerals that name no axis:  GNU APL's AXIS ERROR, not a syntax error
func aei(col: @, hint: String) -> Items { Items.err(pe("%axis-error", col, hint)) };
func isAxisFn(f: Fn) -> Bool { match f { .axis(a) => true, _ => false, } };
func numTok(t: lexer.Token) -> Bool { kindOf(t) == 1 or kindOf(t) == 2 or kindOf(t) == 3 or kindOf(t) == 4 };
func allNum(ts: List<lexer.Token>) -> Bool { match ts { (t, r) => if numTok(t) { allNum(r) } else { false }, _ => true, } };
func cls(sig: List<(String, @)>, nm: String) -> @ {
  match sig { ((n, c), t) => if n == nm { c } else { cls(t, nm) }, _ => 0, }
};
func isFnClass(c: @) -> Bool { c == 2 or c == 3 or c == 4 };
// --- dfn operators (D-95) -------------------------------------------------------------------
// a dfn whose body names ⍺⍺ is a monadic operator (class 6), one naming ⍵⍵ a dyadic one (class 7);
// a nested dfn's ⍺⍺ is its own
func opClassToks(ts: List<lexer.Token>, depth: @, c: @) -> @ {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 17 { opClassToks(rest, depth + 1, c) }
      else if k == 18 { opClassToks(rest, if depth > 0 { depth - 1 } else { 0 }, c) }
      else if k == 5 and depth == 0 and t.text == "⍵⍵" { 7 }
      else if k == 5 and depth == 0 and t.text == "⍺⍺" { opClassToks(rest, depth, 6) }
      else { opClassToks(rest, depth, c) }
    },
    _ => c,
  }
};
func opClassLines(ls: List<String>, c: @) -> @ {
  match ls {
    (l, rest) => match lexer.tokens(l) {
      .ok(ts) => { let c2 = opClassToks(ts, 0, c); if c2 == 7 { 7 } else { opClassLines(rest, c2) } },
      _ => opClassLines(rest, c),
    },
    _ => c,
  }
};
// the class a dfn binds a name to: an operator's, or ambivalent (D-64)
func dfnClass(d: Dfn) -> @ { let c = opClassLines(d.body, 0); if c == 0 { 4 } else { c } };
func isOpClass(c: @) -> Bool { c == 6 or c == 7 };
// an operator `op` meets the item to its left as its left operand, and for a dyadic one the operand to its right
func pushOperator(op: Fn, two: Bool, col: @, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .fun(x) => rightOperand(op, two, false, x.f, Ast.empty, x.col, col, rest, sig, more),
      .arr(x) => if x.unbound { Items.err(pe("%value-error", x.col, nameOf(x.a) + " is not defined")) }
        else { rightOperand(op, two, true, Fn.prim(0), x.a, x.col, col, rest, sig, more) },
      _ => sei(col, "an operator needs an operand to its left (D-95)"),
    },
    _ => sei(col, "an operator needs an operand to its left (D-95)"),
  }
};
// a dyadic operator's right operand:  a function (glyph, function name, dfn), or an array that is one
// numeral or character literal, an array name, or a parenthesised expression (D-95)
func rightOperand(op: Fn, two: Bool, la: Bool, lf: Fn, lv: Ast, lcol: @, col: @, rest: List<lexer.Token>, sig: List<(String, @)>, more: List<Item>) -> Items {
  if not two { items(rest, sig, (funItem(Fn.dop(Dop( op: op, l: lf, r: Fn.prim(0), two: false, la: la, lv: lv, ra: false, rv: Ast.empty )), lcol), more)) }
  else { match operandOf(rest, sig) {
    (isf, gf, rest2) => if isf { items(rest2, sig, (funItem(Fn.dop(Dop( op: op, l: lf, r: gf, two: true, la: la, lv: lv, ra: false, rv: Ast.empty )), lcol), more)) }
      else { match arrayOperand(rest, sig) {
        .err(e) => Items.err(e),
        .ok(r) => match r { (found, av, rest3) => if found { items(rest3, sig, (funItem(Fn.dop(Dop( op: op, l: lf, r: Fn.prim(0), two: true, la: la, lv: lv, ra: true, rv: av )), lcol), more)) }
          else { sei(col, "a dyadic operator needs an operand to its right (D-95)") }, },
      } },
  } }
};
func arrayOperand(ts: List<lexer.Token>, sig: List<(String, @)>) -> Opnd {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k >= 1 and k <= 4 { Opnd.ok((true, Ast.lit(Lit( kind: k, vals: [t.text] )), rest)) }
      else if k == 5 and cls(sig, t.text) == 1 { Opnd.ok((true, Ast.name(t.text), rest)) }
      else if k == 9 { match matchTo(rest, 9, 10, 0, ~) {
        (inner, rest2, closed) => if not closed { Opnd.err(pe("%syntax-error", t.col, "unbalanced (")) }
          else { match parseExpr(inner, sig) { .err(e) => Opnd.err(e), .ok(a) => Opnd.ok((true, a, rest2)), } },
      } }
      else { Opnd.ok((false, Ast.empty, ts)) }
    },
    _ => Opnd.ok((false, Ast.empty, ts)),
  }
};
// token kind as a number, so a match can dispatch on it
func kindOf(t: lexer.Token) -> @ {
  match t.kind {
    .nat => 1, .int => 2, .real => 3, .chr => 4, .name => 5, .quad => 6, .cmd => 7, .glyph => 8,
    .lparen => 9, .rparen => 10, .lbrack => 11, .rbrack => 12, .semi => 13, .assign => 14, .del => 15, .diamond => 16,
    .lbrace => 17, .rbrace => 18, .colon => 19, .nl => 20,
  }
};
func inBody(sig: List<(String, @)>) -> Bool { cls(sig, "∇") == 4 };   // parsing a dfn body (D-66)
func isOp(cp: @) -> Bool { cp == 47 or cp == 92 or cp == 9023 or cp == 9024 or cp == 168 or cp == 46 or cp == 8728 or cp == 9064 or cp == 9059 or cp == 9060 };  // / \ ⌿ ⍀ ¨ . ∘ ⍨ ⍣ ⍤
func maxk(a: @, b: @) -> @ { if a > b { a } else { b } };
func natText(s: String) -> @ { natDigits(lexer.toCps(s.chars()), 0) };
// a scalar dyadic glyph: its axis may name several axes of the higher-rank argument (D-96)
func scalarGlyph(f: Fn) -> Bool {
  match f { .prim(cp) => cp == 43 or cp == 8722 or cp == 215 or cp == 247 or cp == 8968 or cp == 8970 or cp == 8739 or cp == 8902
    or cp == 9055 or cp == 9675 or cp == 33 or cp == 60 or cp == 8804 or cp == 61 or cp == 8805 or cp == 62
    or cp == 8800 or cp == 8744 or cp == 8743 or cp == 9073 or cp == 9074, _ => false, }
};
func allNat(ts: List<lexer.Token>) -> Bool { match ts { (t, rest) => if kindOf(t) == 1 { allNat(rest) } else { false }, _ => true, } };
func natTexts(ts: List<lexer.Token>, acc: List<@>) -> List<@> { match ts { (t, rest) => natTexts(rest, (natText(t.text), acc)), _ => revN(acc, ~), } };
// a fractional axis numeral (D-92):  `1.5` -> ⌊k⌋+1 = 2, `0.5` -> 1, `¯0.5` -> 0;  an integer, a
// negative below ¯1 or an exponent is refused
func halfAxis(cs: List<@>) -> (Bool, @) {
  match cs {
    (c, t) => if c == 175 { match splitDot(t, ~) { (ip, fp, dot) => if dot and natDigits(ip, 0) == 0 and anyNonZero(fp) and allDigits(ip) and allDigits(fp) { (true, 0) } else { (false, 0) }, } }
      else { match splitDot(cs, ~) { (ip, fp, dot) => if dot and anyNonZero(fp) and allDigits(ip) and allDigits(fp) { (true, natDigits(ip, 0) + 1) } else { (false, 0) }, } },
    _ => (false, 0),
  }
};
func splitDot(cs: List<@>, acc: List<@>) -> (List<@>, List<@>, Bool) {
  match cs { (c, t) => if c == 46 { (revN(acc, ~), t, true) } else { splitDot(t, (c, acc)) }, _ => (revN(acc, ~), ~, false), }
};
func revN(xs: List<@>, acc: List<@>) -> List<@> { match xs { (h, t) => revN(t, (h, acc)), _ => acc, } };
func allDigits(cs: List<@>) -> Bool { match cs { (c, t) => if c >= 48 and c <= 57 { allDigits(t) } else { false }, _ => true, } };
func anyNonZero(cs: List<@>) -> Bool { match cs { (c, t) => if c != 48 { true } else { anyNonZero(t) }, _ => false, } };
func natDigits(cs: List<@>, acc: @) -> @ { match cs { (c, t) => natDigits(t, acc * 10 + (c - 48)), _ => acc, } };
func revT(xs: List<lexer.Token>, acc: List<lexer.Token>) -> List<lexer.Token> {
  match xs { (h, t) => revT(t, (h, acc)), _ => acc, }
};
func revTT(xs: List<List<lexer.Token>>, acc: List<List<lexer.Token>>) -> List<List<lexer.Token>> {
  match xs { (h, t) => revTT(t, (h, acc)), _ => acc, }
};
func revA(xs: List<Ast>, acc: List<Ast>) -> List<Ast> {
  match xs { (h, t) => revA(t, (h, acc)), _ => acc, }
};
func snocS(xs: List<String>, s: String) -> List<String> {
  match xs { (h, t) => (h, snocS(t, s)), _ => [s], }
};
func texts(ts: List<lexer.Token>) -> List<String> {
  match ts { (t, rest) => (t.text, texts(rest)), _ => ~, }
};
func arrItem(a: Ast, col: @, open: Bool, unbound: Bool) -> Item { Item.arr(IArr( a: a, col: col, open: open, unbound: unbound )) };
func funItem(f: Fn, col: @) -> Item { Item.fun(IFun( f: f, col: col )) };
func isLit(a: Ast) -> Bool { match a { .lit(l) => true, _ => false, } };
// ⍬, the empty numeric vector:  a natural literal with no numerals (D-97)
func zilde() -> Ast { Ast.lit(Lit( kind: 1, vals: ~ )) };
func isSysName(nm: String) -> Bool { nm == "IO" or nm == "PP" or nm == "TYPE" or nm == "RL" };   // D-60, D-104

// --- token splitting ---------------------------------------------------------
// statements on one line (D-7); parts in order. A `⋄` inside braces
// belongs to the dfn (D-63); a line end outside them separates
// statements like `⋄` (D-69).
func splitDiamond(ts: List<lexer.Token>, cur: List<lexer.Token>, acc: List<List<lexer.Token>>) -> List<List<lexer.Token>> {
  splitDia(ts, 0, cur, acc)
};
func splitDia(ts: List<lexer.Token>, depth: @, cur: List<lexer.Token>, acc: List<List<lexer.Token>>) -> List<List<lexer.Token>> {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if (k == 16 or k == 20) and depth == 0 { splitDia(rest, depth, ~, (revT(cur, ~), acc)) }
      else if k == 17 { splitDia(rest, depth + 1, (t, cur), acc) }
      else if k == 18 and depth > 0 { splitDia(rest, depth - 1, (t, cur), acc) }
      else { splitDia(rest, depth, (t, cur), acc) }
    },
    _ => revTT((revT(cur, ~), acc), ~),
  }
};
// a guard's colon: the first `:` at depth 0 (D-66); answers (found, left, right)
func splitColon(ts: List<lexer.Token>, depth: @, cur: List<lexer.Token>) -> (Bool, List<lexer.Token>, List<lexer.Token>) {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 19 and depth == 0 { (true, revT(cur, ~), rest) }
      else if k == 9 or k == 11 or k == 17 { splitColon(rest, depth + 1, (t, cur)) }
      else if (k == 10 or k == 12 or k == 18) and depth > 0 { splitColon(rest, depth - 1, (t, cur)) }
      else { splitColon(rest, depth, (t, cur)) }
    },
    _ => (false, revT(cur, ~), ~),
  }
};
// the lines of a dfn body: cut at `nl` outside nested braces, each back to source
func bodyLines(ts: List<lexer.Token>, depth: @, cur: List<lexer.Token>, acc: List<String>) -> List<String> {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 20 and depth == 0 { bodyLines(rest, depth, ~, pushLine(cur, acc)) }
      else if k == 17 { bodyLines(rest, depth + 1, (t, cur), acc) }
      else if k == 18 and depth > 0 { bodyLines(rest, depth - 1, (t, cur), acc) }
      else { bodyLines(rest, depth, (t, cur), acc) }
    },
    _ => revS(pushLine(cur, acc), ~),
  }
};
func pushLine(cur: List<lexer.Token>, acc: List<String>) -> List<String> {
  match cur { (t, rest) => (lexer.unlex(revT(cur, ~)), acc), _ => acc, }
};
func revS(xs: List<String>, acc: List<String>) -> List<String> {
  match xs { (h, t) => revS(t, (h, acc)), _ => acc, }
};
// after an opener: (inner, rest, closed); `open`/`close` are kind numbers
func matchTo(ts: List<lexer.Token>, open: @, close: @, depth: @, acc: List<lexer.Token>) -> (List<lexer.Token>, List<lexer.Token>, Bool) {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == open { matchTo(rest, open, close, depth + 1, (t, acc)) }
      else if k == close { if depth == 0 { (revT(acc, ~), rest, true) } else { matchTo(rest, open, close, depth - 1, (t, acc)) } }
      else { matchTo(rest, open, close, depth, (t, acc)) }
    },
    _ => (revT(acc, ~), ~, false),
  }
};
// `;`-separated parts at bracket depth 0, in order
func splitSemis(ts: List<lexer.Token>, depth: @, cur: List<lexer.Token>, acc: List<List<lexer.Token>>) -> List<List<lexer.Token>> {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 13 and depth == 0 { splitSemis(rest, depth, ~, (revT(cur, ~), acc)) }
      else if k == 9 or k == 11 { splitSemis(rest, depth + 1, (t, cur), acc) }
      else if (k == 10 or k == 12) and depth > 0 { splitSemis(rest, depth - 1, (t, cur), acc) }
      else { splitSemis(rest, depth, (t, cur), acc) }
    },
    _ => revTT((revT(cur, ~), acc), ~),
  }
};

// --- phase A: items, right to left ------------------------------------------
// a function token: (is-function, the function)
func fnOf(t: lexer.Token, sig: List<(String, @)>) -> (Bool, Fn) {
  match kindOf(t) {
    8 => if isOp(t.cp) { (false, Fn.prim(0)) } else { (true, Fn.prim(t.cp)) },
    5 => if isFnClass(cls(sig, t.text)) { (true, Fn.user(t.text)) } else { (false, Fn.prim(0)) },
    _ => (false, Fn.prim(0)),
  }
};
// the right operand of . and ∘.: a glyph, a name of function class, or a dfn (D-91);
// answers the operand and the tokens after it
func operandOf(ts: List<lexer.Token>, sig: List<(String, @)>) -> (Bool, Fn, List<lexer.Token>) {
  match ts {
    (g, rest) => if kindOf(g) == 17 {
        match matchTo(rest, 17, 18, 0, ~) {
          (inner, rest2, closed) => if closed { (true, Fn.dfn(Dfn( body: bodyLines(inner, 0, ~, ~) )), rest2) } else { (false, Fn.prim(0), ts) },
        }
      } else { match fnOf(g, sig) { (isf, gf) => (isf, gf, rest), } },
    _ => (false, Fn.prim(0), ts),
  }
};
func derive(w: @, f: Fn) -> Fn {
  match w { 1 => Fn.reduce(f), 2 => Fn.scan(f), 3 => Fn.reduce1(f), _ => Fn.scan1(f), }
};
// a numeral joins the numeric literal to its left (D-4); any other literal
// is an item of a strand (D-71)
func pushLit(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  let k = kindOf(t);
  let fresh = Ast.lit(Lit( kind: k, vals: [t.text] ));
  match acc {
    (h, more) => match h {
      .arr(x) => if x.open and k != 4 {
          match x.a {
            .lit(l) => if l.kind == 4 { pushArr(fresh, t.col, true, false, rest, sig, acc) }
              else { items(rest, sig, (arrItem(Ast.lit(Lit( kind: maxk(l.kind, k), vals: snocS(l.vals, t.text) )), x.col, true, false), more)) },
            _ => pushArr(fresh, t.col, true, false, rest, sig, acc),
          }
        } else { pushArr(fresh, t.col, true, false, rest, sig, acc) },
      _ => pushArr(fresh, t.col, true, false, rest, sig, acc),
    },
    _ => pushArr(fresh, t.col, true, false, rest, sig, acc),
  }
};
// an array item to the right of another strands with it (D-71); an unbound
// name in a strand is a VALUE ERROR at its column
func pushArr(a: Ast, col: @, open: Bool, unbound: Bool, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .arr(x) => if x.unbound { Items.err(pe("%value-error", x.col, nameOf(x.a) + " is not defined")) }
        else if unbound { Items.err(pe("%value-error", col, nameOf(a) + " is not defined")) }
        else { items(rest, sig, (arrItem(strandOf(x.a, a, x.open), x.col, true, false), more)) },
      _ => items(rest, sig, (arrItem(a, col, open, unbound), acc)),
    },
    _ => items(rest, sig, (arrItem(a, col, open, unbound), acc)),
  }
};
// `open` says the left item was folded from numerals, so each is an item;
// a parenthesised literal is one item
func strandOf(l: Ast, r: Ast, open: Bool) -> Ast {
  match l { .strand(xs) => if open { Ast.strand(snocA(xs, r)) } else { Ast.strand([l, r]) }, _ => Ast.strand(snocA(if open { splitLit(l) } else { [l] }, r)), }
};
// a numeric literal of several numerals is that many items in a strand
func splitLit(l: Ast) -> List<Ast> {
  match l { .lit(t) => if t.kind == 4 { [l] } else { eachLit(t.kind, t.vals) }, _ => [l], }
};
func eachLit(k: @, vs: List<String>) -> List<Ast> { match vs { (v, t) => (Ast.lit(Lit( kind: k, vals: [v] )), eachLit(k, t)), _ => ~, } };
func snocA(xs: List<Ast>, a: Ast) -> List<Ast> { match xs { (h, t) => (h, snocA(t, a)), _ => [a], } };
// a bracket after an open strand indexes its last item; a parenthesised strand is indexed whole
func indexLast(xs: List<Ast>, ixs: List<Ast>) -> List<Ast> {
  match xs { (h, t) => match t { (h2, t2) => (h, indexLast(t, ixs)), _ => [Ast.index(Index( a: h, ix: ixs ))], }, _ => ~, }
};
// an operator glyph that is also a function when nothing callable stands left (/ \ ⌿ ⍀)
func pushOpOrFn(w: @, t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .fun(x) => items(rest, sig, (funItem(derive(w, x.f), x.col), more)),
      _ => items(rest, sig, (funItem(Fn.prim(t.cp), t.col), acc)),
    },
    _ => items(rest, sig, (funItem(Fn.prim(t.cp), t.col), acc)),
  }
};
func pushEach(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .fun(x) => items(rest, sig, (funItem(Fn.each(x.f), x.col), more)),
      _ => sei(t.col, "¨ needs a function to its left"),
    },
    _ => sei(t.col, "¨ needs a function to its left"),
  }
};
// f.g — the function to the left and the function token to the right
func pushInner(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .fun(x) => match operandOf(rest, sig) {
        (isf, gf, rest2) => if isf { items(rest2, sig, (funItem(Fn.inner(Inner( f: x.f, g: gf )), x.col), more)) }
          else { sei(t.col, "inner product needs a function to its right") },
      },
      _ => sei(t.col, "inner product needs a function to its left"),
    },
    _ => sei(t.col, "inner product needs a function to its left"),
  }
};
// ∘.g — the only use of ∘ in v1
func pushOuter(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match rest {
    (d, rest2) => if kindOf(d) == 8 and d.cp == 46 {
        match operandOf(rest2, sig) {
          (isf, gf, rest3) => if isf { items(rest3, sig, (funItem(Fn.outer(gf), t.col), acc)) }
            else { sei(t.col, "∘ is used only as ∘.g in v1") },
        }
      } else { sei(t.col, "∘ is used only as ∘.g in v1") },
    _ => sei(t.col, "∘ is used only as ∘.g in v1"),
  }
};
func pushGlyph(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match t.cp {
    47   => pushOpOrFn(1, t, rest, sig, acc),    // /
    92   => pushOpOrFn(2, t, rest, sig, acc),    // \
    9023 => pushOpOrFn(3, t, rest, sig, acc),    // ⌿
    9024 => pushOpOrFn(4, t, rest, sig, acc),    // ⍀
    168  => pushEach(t, rest, sig, acc),         // ¨
    9064 => pushOperator(Fn.prim(9064), false, t.col, rest, sig, acc),   // ⍨ (D-105)
    9059 => pushOperator(Fn.prim(9059), true, t.col, rest, sig, acc),    // ⍣
    9060 => pushOperator(Fn.prim(9060), true, t.col, rest, sig, acc),    // ⍤
    46   => pushInner(t, rest, sig, acc),        // .
    8728 => pushOuter(t, rest, sig, acc),        // ∘
    _    => items(rest, sig, (funItem(Fn.prim(t.cp), t.col), acc)),
  }
};
// the items so far end in ← (an operator literal being named, D-95)
func startsAssign(acc: List<Item>) -> Bool { match acc { (h, more) => match h { .asg(c) => true, _ => false, }, _ => false, } };
func pushName(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  let c = cls(sig, t.text);
  if isOpClass(c) { pushOperator(Fn.user(t.text), c == 7, t.col, rest, sig, acc) }
  else if isFnClass(c) { items(rest, sig, (funItem(Fn.user(t.text), t.col), acc)) }
  else if c == 5 { pushArr(Ast.nilad(t.text), t.col, false, false, rest, sig, acc) }
  else { pushArr(Ast.name(t.text), t.col, false, c == 0 and not assignedIn(rest, t.text, 0), rest, sig, acc) }
};
// --- S-24: unbound reads in evaluation order --------------------------------------------
// the tokens to the right assign nm outside any dfn: evaluation runs right to left, so a
// read of nm to the left of `nm ←` finds it bound
func assignedIn(ts: List<lexer.Token>, nm: String, depth: @) -> Bool {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 17 { assignedIn(rest, nm, depth + 1) }
      else if k == 18 { assignedIn(rest, nm, if depth > 0 { depth - 1 } else { 0 }) }
      else if k == 5 and depth == 0 and t.text == nm and nextIsAssign(rest) { true }
      else { assignedIn(rest, nm, depth) }
    },
    _ => false,
  }
};
func nextIsAssign(ts: List<lexer.Token>) -> Bool { match ts { (t, rest) => kindOf(t) == 14, _ => false, } };
// the rightmost unbound read of a statement, the first one evaluation reaches: (found, column, name)
func lastUnbound(ts: List<lexer.Token>, sig: List<(String, @)>, depth: @, found: Bool, col: @, nm: String) -> (Bool, @, String) {
  match ts {
    (t, rest) => {
      let k = kindOf(t);
      if k == 17 { lastUnbound(rest, sig, depth + 1, found, col, nm) }
      else if k == 18 { lastUnbound(rest, sig, if depth > 0 { depth - 1 } else { 0 }, found, col, nm) }
      else if k == 5 and depth == 0 and cls(sig, t.text) == 0 and not nextIsAssign(rest) and not assignedIn(rest, t.text, 0) { lastUnbound(rest, sig, depth, true, t.col, t.text) }
      else { lastUnbound(rest, sig, depth, found, col, nm) }
    },
    _ => (found, col, nm),
  }
};
// a VALUE ERROR for an unbound name blames the rightmost unbound read (S-24)
func blameLast(r: Parsed, ts: List<lexer.Token>, sig: List<(String, @)>) -> Parsed {
  match r {
    .err(e) => if e.tag == "%value-error" and endsDefined(e.hint) {
        match lastUnbound(ts, sig, 0, false, 0, "") { (found, col, nm) => if found { Parsed.err(pe("%value-error", col, nm + " is not defined")) } else { r }, }
      } else { r },
    _ => r,
  }
};
func endsDefined(h: String) -> Bool { endsWithCps(lexer.toCps(h.chars()), lexer.toCps(" is not defined".chars())) };
func endsWithCps(xs: List<@>, suf: List<@>) -> Bool { let n = countCps(xs); let m = countCps(suf); if m > n { false } else { dropCps(xs, n - m) == suf } };
func countCps(xs: List<@>) -> @ { match xs { (h, t) => 1 + countCps(t), _ => 0, } };
func dropCps(xs: List<@>, n: @) -> List<@> { if n == 0 { xs } else { match xs { (h, t) => dropCps(t, n - 1), _ => ~, } } };
func pushParen(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match matchTo(rest, 9, 10, 0, ~) {
    (inner, rest2, closed) => if not closed { sei(t.col, "unbalanced (") }
      else {
        match inner {
          (i0, irest) => match parseExpr(inner, sig) {
            .err(e) => Items.err(e),
            .ok(a) => pushArr(a, t.col, false, false, rest2, sig, acc),
          },
          _ => sei(t.col, "empty parentheses"),
        }
      },
  }
};
// the index parts: each `;`-separated part is an expression or an elision
func indexParts(parts: List<List<lexer.Token>>, sig: List<(String, @)>, acc: List<Ast>) -> Asts {
  match parts {
    (p, rest) => match p {
      (p0, prest) => match parseExpr(p, sig) {
        .err(e) => Asts.err(e),
        .ok(a) => indexParts(rest, sig, (a, acc)),
      },
      _ => indexParts(rest, sig, (Ast.elide, acc)),
    },
    _ => Asts.ok(revA(acc, ~)),
  }
};
// a dfn literal (D-63): the braces matched, the body kept as source lines
func pushBrace(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match matchTo(rest, 17, 18, 0, ~) {
    (inner, rest2, closed) => if not closed { sei(t.col, "unbalanced {{") }
      else {
        let d = Dfn( body: bodyLines(inner, 0, ~, ~) );
        let oc = opClassToks(inner, 0, 0);
        if oc == 0 or startsAssign(acc) { items(rest2, sig, (funItem(Fn.dfn(d), t.col), acc)) }
        else { pushOperator(Fn.dfn(d), oc == 7, t.col, rest2, sig, acc) }
      },
  }
};
func pushBrack(t: lexer.Token, rest: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match acc {
    (h, more) => match h {
      .arr(x) => match matchTo(rest, 11, 12, 0, ~) {
        (inner, rest2, closed) => if not closed { sei(t.col, "unbalanced [") }
          else {
            match indexParts(splitSemis(inner, 0, ~, ~), sig, ~) {
              .err(e) => Items.err(e),
              .ok(ixs) => match x.a {
                .strand(xs) => if x.open { items(rest2, sig, (arrItem(Ast.strand(indexLast(xs, ixs)), x.col, true, false), more)) }
                  else { items(rest2, sig, (arrItem(Ast.index(Index( a: x.a, ix: ixs )), x.col, false, false), more)) },
                _ => items(rest2, sig, (arrItem(Ast.index(Index( a: x.a, ix: ixs )), x.col, false, x.unbound), more)),
              },
            }
          },
      },
      .fun(x) => if isAxisFn(x.f) { sei(t.col, "a function takes one axis (D-82)") } else { match matchTo(rest, 11, 12, 0, ~) {
        (inner, rest2, closed) => if not closed { sei(t.col, "unbalanced [") }
          else { match inner {
            (k, krest) => match krest {
              (k2, krest2) => if scalarGlyph(x.f) and allNat(inner) { items(rest2, sig, (funItem(Fn.axis(Axis( f: x.f, k: natText(k.text), half: false, ks: natTexts(inner, ~) )), x.col), more)) }
                else if allNum(inner) { aei(t.col, "an axis is one numeral (D-82)") }
                else { sei(t.col, "an axis is one numeral (D-82)") },
              _ => if kindOf(k) == 1 { items(rest2, sig, (funItem(Fn.axis(Axis( f: x.f, k: natText(k.text), half: false, ks: [natText(k.text)] )), x.col), more)) }
                else if kindOf(k) == 3 or kindOf(k) == 2 { match halfAxis(lexer.toCps(k.text.chars())) {
                  (ok, kk) => if ok { items(rest2, sig, (funItem(Fn.axis(Axis( f: x.f, k: kk, half: true, ks: [kk] )), x.col), more)) }
                    else { aei(t.col, "an axis is a natural or a fraction between two axes (D-82, D-92)") },
                } }
                else if kindOf(k) == 4 { aei(t.col, "an axis is one numeral (D-82)") }
                else { sei(t.col, "an axis is one numeral (D-82)") },
            },
            _ => sei(t.col, "an axis is one numeral (D-82)"),
          } },
      } },
      .asg(c) => sei(t.col, "[ needs an array to its left"),
    },
    _ => sei(t.col, "[ needs an array to its left"),
  }
};
func items(ts: List<lexer.Token>, sig: List<(String, @)>, acc: List<Item>) -> Items {
  match ts {
    (t, rest) => match kindOf(t) {
      1  => pushLit(t, rest, sig, acc),
      2  => pushLit(t, rest, sig, acc),
      3  => pushLit(t, rest, sig, acc),
      4  => pushLit(t, rest, sig, acc),
      5  => pushName(t, rest, sig, acc),
      6  => if isSysName(t.text) { pushArr(Ast.sysvar(t.text), t.col, false, false, rest, sig, acc) }
            else { Items.err(pe("%value-error", t.col, "unknown system variable ⎕" + t.text)) },
      7  => sei(t.col, ") commands must open a line"),
      8  => if t.cp == 9068 { pushArr(zilde(), t.col, false, false, rest, sig, acc) } else { pushGlyph(t, rest, sig, acc) },   // ⍬ is an array (D-97)
      9  => pushParen(t, rest, sig, acc),
      10 => sei(t.col, "unbalanced )"),
      11 => pushBrack(t, rest, sig, acc),
      12 => sei(t.col, "unbalanced ]"),
      13 => sei(t.col, "; outside brackets"),
      14 => items(rest, sig, (Item.asg(t.col), acc)),
      15 => if inBody(sig) { items(rest, sig, (funItem(Fn.own, t.col), acc)) } else { sei(t.col, "∇ must open a line") },
      17 => pushBrace(t, rest, sig, acc),
      18 => sei(t.col, "unbalanced }}"),
      19 => if inBody(sig) { sei(t.col, "a guard takes one : (D-66)") } else { sei(t.col, "a guard belongs in a dfn body (D-66)") },
      _  => sei(t.col, "unexpected token"),
    },
    _ => Items.ok(acc),
  }
};

// --- phase B: the tree, right to left ----------------------------------------
func valenceOk(f: Fn, dyadic: Bool, sig: List<(String, @)>) -> Bool {
  match f {
    .user(nm) => {
      let c = cls(sig, nm);
      if dyadic { c == 3 or c == 4 } else { c == 2 or c == 4 }
    },
    _ => true,   // primitives, derived functions, dfns and ∇ are ambivalent (D-67)
  }
};
func userName(f: Fn) -> String { match f { .user(nm) => nm, _ => "", } };
func isDfn(f: Fn) -> Bool { match f { .dfn(d) => true, _ => false, } };
func applyMonad(x: IFun, v: Ast, more: List<Item>, sig: List<(String, @)>) -> Parsed {
  if valenceOk(x.f, false, sig) { extend(Ast.monad(Monad( f: x.f, r: v )), more, sig) }
  else { Parsed.err(pe("%valence-error", x.col, userName(x.f) + " is dyadic")) }
};
// two array items meet only through pushArr; this is the fallback
func adjacency(x: IArr, v: Ast, more: List<Item>, sig: List<(String, @)>) -> Parsed {
  if x.unbound { Parsed.err(pe("%value-error", x.col, nameOf(x.a) + " is not defined")) }
  else { extend(strandOf(x.a, v, x.open), more, sig) }
};
func nameOf(a: Ast) -> String {
  match a { .name(nm) => nm, .index(ix) => nameOf(ix.a), _ => "", }
};
func build(its: List<Item>, sig: List<(String, @)>) -> Parsed {
  match its {
    (h, rest) => match h {
      .arr(x) => if x.unbound { Parsed.err(pe("%value-error", x.col, nameOf(x.a) + " is not defined")) } else { extend(x.a, rest, sig) },
      .fun(x) => fassign(x, rest),
      .asg(c) => se(c, "nothing to assign"),
    },
    _ => se(1, "empty expression"),
  }
};
func fassignTo(nm: String, x: IFun, c: @, more: List<Item>) -> Parsed {
  if not isDfn(x.f) { se(c, "only a dfn is assigned to a name (D-64)") }
  else { match more { (h3, m3) => se(c, "a dfn assignment stands alone (D-64)"), _ => Parsed.ok(Ast.fassign(FAssign( nm: nm, f: x.f ))), } }
};
// a function as the rightmost item: `F ← {…}` names it (D-64); anything else lacks an argument
func fassign(x: IFun, rest: List<Item>) -> Parsed {
  match rest {
    (h, more) => match h {
      .asg(c) => match more {
        (h2, more2) => match h2 {
          .arr(y) => match y.a {
            .name(nm) => fassignTo(nm, x, c, more2),
            _ => se(c, "only a name takes a dfn (D-64)"),
          },
          .fun(y) => match y.f { .user(nm) => fassignTo(nm, x, c, more2), _ => se(c, "only a name takes a dfn (D-64)"), },
          _ => se(c, "nothing to assign to"),
        },
        _ => se(c, "nothing to assign to"),
      },
      _ => se(x.col, "a function needs a right argument"),
    },
    _ => se(x.col, "a function needs a right argument"),
  }
};
func extend(v: Ast, rest: List<Item>, sig: List<(String, @)>) -> Parsed {
  match rest {
    (h, more) => match h {
      .arr(x) => adjacency(x, v, more, sig),
      .fun(x) => match more {
        (h2, more2) => match h2 {
          .arr(y) => if y.unbound { Parsed.err(pe("%value-error", y.col, nameOf(y.a) + " is not defined")) }
            else if valenceOk(x.f, true, sig) { extend(Ast.dyad(Dyad( f: x.f, l: y.a, r: v )), more2, sig) }
            else { Parsed.err(pe("%valence-error", x.col, userName(x.f) + " is monadic")) },
          _ => applyMonad(x, v, more, sig),
        },
        _ => applyMonad(x, v, more, sig),
      },
      .asg(c) => match more {
        (h2, more2) => match h2 {
          .fun(y) => match y.f {
            .user(nm) => extend(Ast.assign(Assign( nm: nm, v: v )), more2, sig),   // a function's name takes an array (D-64)
            _ => se(c, "cannot assign to that"),
          },
          .arr(y) => match y.a {
            .name(nm) => extend(Ast.assign(Assign( nm: nm, v: v )), more2, sig),
            .sysvar(nm) => extend(Ast.sysassign(Assign( nm: nm, v: v )), more2, sig),
            .index(ix) => match ix.a {
              .name(nm) => if y.unbound { Parsed.err(pe("%value-error", y.col, nm + " is not defined")) }
                else { extend(Ast.iassign(IAssign( nm: nm, ix: ix.ix, v: v )), more2, sig) },
              _ => se(c, "can only index-assign a name"),
            },
            _ => se(c, "cannot assign to that"),
          },
          _ => se(c, "nothing to assign to"),
        },
        _ => se(c, "nothing to assign to"),
      },
    },
    _ => Parsed.ok(v),
  }
};
func parseExpr(ts: List<lexer.Token>, sig: List<(String, @)>) -> Parsed {
  match items(ts, sig, ~) { .err(e) => Parsed.err(e), .ok(its) => build(its, sig), }
};

// --- statements ----------------------------------------------------------------
// a tradfn header after ∇ (D-30, D-31): [R ←] F | F B | A F B [; L]...
func allHeaderToks(ts: List<lexer.Token>) -> Bool {
  match ts { (t, rest) => (kindOf(t) == 5 or kindOf(t) == 14 or kindOf(t) == 13) and allHeaderToks(rest), _ => true, }
};
func localsOf(parts: List<List<lexer.Token>>, acc: List<String>) -> (Bool, List<String>) {
  match parts {
    (p, rest) => match p {
      (t, prest) => match prest {
        (t2, r2) => (false, ~),
        _ => if kindOf(t) == 5 { localsOf(rest, snocS(acc, t.text)) } else { (false, ~) },
      },
      _ => (false, ~),
    },
    _ => (true, acc),
  }
};
func hasAssign(ts: List<lexer.Token>) -> Bool {
  match ts { (t, rest) => kindOf(t) == 14 or hasAssign(rest), _ => false, }
};
func headerOf(res: String, body: List<lexer.Token>, locals: List<String>, col: @) -> Parsed {
  if hasAssign(body) { se(col, "a header is [R←] F, F B or A F B (D-30)") }
  else {
    match body {
      (a, r1) => match r1 {
        (b, r2) => match r2 {
          (c, r3) => match r3 {
            (d, r4) => se(col, "a header is [R←] F, F B or A F B (D-30)"),
            _ => Parsed.ok(Ast.header(Header( nm: b.text, res: res, lft: a.text, rgt: c.text, locals: locals ))),
          },
          _ => Parsed.ok(Ast.header(Header( nm: a.text, res: res, lft: "", rgt: b.text, locals: locals ))),
        },
        _ => Parsed.ok(Ast.header(Header( nm: a.text, res: res, lft: "", rgt: "", locals: locals ))),
      },
      _ => se(col, "a header is [R←] F, F B or A F B (D-30)"),
    }
  }
};
func parseHeader(ts: List<lexer.Token>, col: @) -> Parsed {
  if not allHeaderToks(ts) { se(col, "a header is names, ← and ; only (D-30)") }
  else {
    match splitSemis(ts, 0, ~, ~) {
      (sigp, locs) => match localsOf(locs, ~) {
        (okl, locals) => if not okl { se(col, "each local is one name (D-31)") }
          else {
            match sigp {
              (t1, r1) => match r1 {
                (t2, r2) => if kindOf(t2) == 14 {
                    if kindOf(t1) == 5 { headerOf(t1.text, r2, locals, col) } else { se(col, "a header is [R←] F, F B or A F B (D-30)") }
                  } else { headerOf("", sigp, locals, col) },
                _ => headerOf("", sigp, locals, col),
              },
              _ => se(col, "a header is [R←] F, F B or A F B (D-30)"),
            }
          },
      },
      _ => se(col, "a header is [R←] F, F B or A F B (D-30)"),
    }
  }
};
func parseStmt(ts: List<lexer.Token>, sig: List<(String, @)>) -> Parsed {
  match ts {
    (t, rest) => match kindOf(t) {
      7  => Parsed.ok(Ast.cmd(Cmd( nm: t.text, args: texts(rest) ))),
      15 => if inBody(sig) { parseGuarded(ts, sig) } else { match rest { (t2, r2) => parseHeader(rest, t.col), _ => Parsed.ok(Ast.fnend), } },
      _  => blameLast(parseGuarded(ts, sig), ts, sig),
    },
    _ => Parsed.ok(Ast.empty),
  }
};
func parseGuarded(ts: List<lexer.Token>, sig: List<(String, @)>) -> Parsed {
  if not inBody(sig) { parseExpr(ts, sig) }
  else {
    match splitColon(ts, 0, ~) {
      (found, lft, rgt) => if not found { parseExpr(ts, sig) }
        else {
          match lft {
            (l0, lr) => match rgt {
              (r0, rr) => if kindOf(r0) == 19 { match rr {
                  (r1, rr2) => match parseExpr(lft, sig) {
                    .err(e) => Parsed.err(e),
                    .ok(c) => match parseExpr(rr, sig) { .err(e) => Parsed.err(e), .ok(x) => Parsed.ok(Ast.eguard(Guard( c: c, e: x ))), },
                  },
                  _ => se(1, "an error guard needs an expression after :: (D-94)"),
                } }
                else { match parseExpr(lft, sig) {
                .err(e) => Parsed.err(e),
                .ok(c) => match parseExpr(rgt, sig) { .err(e) => Parsed.err(e), .ok(x) => Parsed.ok(Ast.guard(Guard( c: c, e: x ))), },
              } },
              _ => se(1, "a guard needs an expression after : (D-66)"),
            },
            _ => se(1, "a guard needs a condition before : (D-66)"),
          }
        },
    }
  }
};
// the signature a statement leaves (D-52, D-68): an assignment binds an
// array, a dfn assignment an ambivalent function, a header its valence
func bind(sig: List<(String, @)>, nm: String, c: @) -> List<(String, @)> {
  match sig {
    ((n, k), t) => if n == nm { ((nm, c), t) } else { ((n, k), bind(t, nm, c)) },
    _ => [(nm, c)],
  }
};
func headerClass(h: Header) -> @ { if h.lft == "" { if h.rgt == "" { 5 } else { 2 } } else { 3 } };
func bindsAll(xs: List<Ast>, sig: List<(String, @)>) -> List<(String, @)> {
  match xs { (h, t) => bindsAll(t, binds(h, sig)), _ => sig, }
};
func binds(a: Ast, sig: List<(String, @)>) -> List<(String, @)> {
  match a {
    .assign(s) => binds(s.v, bind(sig, s.nm, 1)),
    .fassign(s) => bind(sig, s.nm, match s.f { .dfn(d) => dfnClass(d), _ => 4, }),
    .iassign(s) => binds(s.v, bindsAll(s.ix, sig)),
    .sysassign(s) => binds(s.v, sig),
    .guard(g) => binds(g.e, binds(g.c, sig)),
    .eguard(g) => binds(g.e, binds(g.c, sig)),
    .monad(m) => binds(m.r, sig),
    .dyad(d) => binds(d.l, binds(d.r, sig)),
    .index(ix) => bindsAll(ix.ix, binds(ix.a, sig)),
    .strand(xs) => bindsAll(xs, sig),
    .stmts(ss) => bindsAll(ss, sig),
    .header(h) => bind(sig, h.nm, headerClass(h)),
    _ => sig,
  }
};
// ⋄-separated statements, each against the signature the ones before leave (D-68)
func parseAll(parts: List<List<lexer.Token>>, sig: List<(String, @)>, acc: List<Ast>) -> Parsed {
  match parts {
    (p, rest) => match parseStmt(p, sig) { .err(e) => Parsed.err(e), .ok(a) => parseAll(rest, binds(a, sig), (a, acc)), },
    _ => Parsed.ok(Ast.stmts(revA(acc, ~))),
  }
};
// one line's tokens: a statement, or ⋄-separated statements (D-7)
func parseToks(ts: List<lexer.Token>, sig: List<(String, @)>) -> Parsed {
  match splitDiamond(ts, ~, ~) {
    (p, rest) => match rest { (p2, r2) => parseAll((p, rest), sig, ~), _ => parseStmt(p, sig), },
    _ => Parsed.ok(Ast.empty),
  }
};
// one source line
func parseLine(line: String, sig: List<(String, @)>) -> Parsed {
  match lexer.tokens(line) {
    .err(e) => Parsed.err(pe(e.tag, e.col, e.hint)),
    .ok(ts) => parseToks(ts, sig),
  }
};
// the net brace depth of a token run: positive while a dfn is open (D-69)
func braceDepth(ts: List<lexer.Token>, depth: @) -> @ {
  match ts {
    (t, rest) => { let k = kindOf(t); braceDepth(rest, if k == 17 { depth + 1 } else if k == 18 and depth > 0 { depth - 1 } else { depth }) },
    _ => depth,
  }
};

// --- rendering (the parse corpus, the green prompt) ---------------------------
func joinS(xs: List<String>, sep: String) -> String {
  match xs { (h, t) => match t { (h2, t2) => h + sep + joinS(t, sep), _ => h, }, _ => "", }
};
func showNats(xs: List<@>) -> List<String> { match xs { (h, t) => ("{h}", showNats(t)), _ => ~, } };
func showFn(f: Fn) -> String {
  match f {
    .prim(cp) => lexer.text([cp]),
    .user(nm) => nm,
    .reduce(g) => showFn(g) + "/",
    .reduce1(g) => showFn(g) + "⌿",
    .scan(g) => showFn(g) + "\\",
    .scan1(g) => showFn(g) + "⍀",
    .each(g) => showFn(g) + "¨",
    .inner(i) => showFn(i.f) + "." + showFn(i.g),
    .outer(g) => "∘." + showFn(g),
    .dfn(d) => "{{" + joinS(d.body, " ⋄ ") + "}}",
    .own => "∇",
    .dop(x) => "(" + (if x.la { showAst(x.lv) } else { showFn(x.l) }) + " " + showFn(x.op) + (if x.two { " " + (if x.ra { showAst(x.rv) } else { showFn(x.r) }) } else { "" }) + ")",
    .axis(x) => if not x.half { showFn(x.f) + "[" + joinS(showNats(x.ks), " ") + "]" } else if x.k == 0 { showFn(x.f) + "[¯0.5]" } else { showFn(x.f) + "[{x.k - 1}.5]" },
  }
};
func showAsts(xs: List<Ast>, sep: String) -> String {
  match xs { (h, t) => match t { (h2, t2) => showAst(h) + sep + showAsts(t, sep), _ => showAst(h), }, _ => "", }
};
func showLocals(ls: List<String>) -> String {
  match ls { (l0, lr) => ";" + joinS(ls, ";"), _ => "", }
};
func showHeader(h: Header) -> String {
  let res = if h.res == "" { "" } else { h.res + "←" };
  let lft = if h.lft == "" { "" } else { h.lft + " " };
  let rgt = if h.rgt == "" { "" } else { " " + h.rgt };
  "∇ " + res + lft + h.nm + rgt + showLocals(h.locals)
};
func showAst(a: Ast) -> String {
  match a {
    .empty => "",
    .elide => "",
    .fnend => "∇",
    .lit(l) => if l.kind == 4 { "'" + joinS(l.vals, "") + "'" } else if l.vals == ~ { "⍬" } else { joinS(l.vals, " ") },
    .name(nm) => nm,
    .nilad(nm) => nm + "()",
    .sysvar(nm) => "⎕" + nm,
    .monad(m) => showFn(m.f) + "(" + showAst(m.r) + ")",
    .dyad(d) => showFn(d.f) + "(" + showAst(d.l) + ", " + showAst(d.r) + ")",
    .strand(xs) => "strand(" + showAsts(xs, ", ") + ")",
    .index(ix) => showAst(ix.a) + "[" + showAsts(ix.ix, ";") + "]",
    .assign(s) => "←(" + s.nm + ", " + showAst(s.v) + ")",
    .iassign(s) => "←(" + s.nm + "[" + showAsts(s.ix, ";") + "], " + showAst(s.v) + ")",
    .sysassign(s) => "←(⎕" + s.nm + ", " + showAst(s.v) + ")",
    .fassign(s) => "←(" + s.nm + ", " + showFn(s.f) + ")",
    .guard(g) => ":(" + showAst(g.c) + ", " + showAst(g.e) + ")",
    .eguard(g) => "::(" + showAst(g.c) + ", " + showAst(g.e) + ")",
    .cmd(c) => match c.args { (h, t) => ")" + c.nm + " " + joinS(c.args, " "), _ => ")" + c.nm, },
    .header(h) => showHeader(h),
    .stmts(ss) => showAsts(ss, " ⋄ "),
  }
};
func dump(line: String, sig: List<(String, @)>) -> String {
  match parseLine(line, sig) {
    .ok(a) => showAst(a),
    .err(e) => e.tag + " col:{e.col} " + e.hint,
  }
};
